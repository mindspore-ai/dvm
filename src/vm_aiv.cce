#define _CCE_KERNEL_
#define __VM_ARCH__ 220
#include "vm_aiv.h"

__aicore_inline__ void vFloor(__ubuf__ float *x, uint8_t repeat, uint16_t repeatStride) {
  vconv_f322s32c((__ubuf__ int32_t *)x, x, repeat, 1, 1, repeatStride, repeatStride);
  pipe_barrier(PIPE_V);
  vconv_s322f32(x, (__ubuf__ int32_t *)x, repeat, 1, 1, repeatStride, repeatStride);
}

__aicore_inline__ void vFloor(__ubuf__ half *x, uint8_t repeat, uint16_t repeatStride) {
  vconv_f162s16c((__ubuf__ int16_t *)x, x, repeat, 1, 1, repeatStride, repeatStride);
  pipe_barrier(PIPE_V);
  vconv_s162f16(x, (__ubuf__ int16_t *)x, repeat, 1, 1, repeatStride, repeatStride);
}

__aicore_inline__ void repeat_vcadd(__ubuf__ float *dst, __ubuf__ float *src, uint16_t repeat, uint16_t dstRepeatStride,
                                    uint16_t srcRepeatStride) {
  for (; repeat > 255; repeat -= 255) {
    vcadd(dst, src, 255, dstRepeatStride, 1, srcRepeatStride, 0);
    dst += 255 * dstRepeatStride;
    src += 255 * TYPE_SHIFT(float) * srcRepeatStride;
  }
  vcadd(dst, src, repeat, dstRepeatStride, 1, srcRepeatStride, 0);
}

template <typename T>
__aicore_inline__ void repeat_vcmax(__ubuf__ T *dst, __ubuf__ T *src, uint16_t repeat, uint16_t dstRepeatStride,
                                    uint16_t srcRepeatStride) {
  for (; repeat > 255; repeat -= 255) {
    vcmax(dst, src, 255, dstRepeatStride, 1, srcRepeatStride, ONLY_VALUE);
    dst += 255 * dstRepeatStride;
    src += 255 * TYPE_SHIFT(T) * srcRepeatStride;
  }
  vcmax(dst, src, repeat, dstRepeatStride, 1, srcRepeatStride, ONLY_VALUE);
}

template <typename T>
__aicore_inline__ void repeat_vcmin(__ubuf__ T *dst, __ubuf__ T *src, uint16_t repeat, uint16_t dstRepeatStride,
                                    uint16_t srcRepeatStride) {
  for (; repeat > 255; repeat -= 255) {
    vcmin(dst, src, 255, dstRepeatStride, 1, srcRepeatStride, ONLY_VALUE);
    dst += 255 * dstRepeatStride;
    src += 255 * TYPE_SHIFT(T) * srcRepeatStride;
  }
  vcmin(dst, src, repeat, dstRepeatStride, 1, srcRepeatStride, ONLY_VALUE);
}

template <typename T>
__aicore_inline__ void SelectMode2(__ubuf__ T *dst, __ubuf__ T *src0, __ubuf__ T *src1, uint64_t count,
                                   __ubuf__ uint8_t *cond_addr) {
  set_vector_mask(0, BlockNum(uint32_t));
  vector_dup((__ubuf__ uint32_t *)(WORKSPACE), static_cast<uint32_t>(reinterpret_cast<uint64_t>(cond_addr)), 1, 1, 1, 0, 0);
  pipe_barrier(PIPE_V);
  set_cmpmask((__ubuf__ void *)(WORKSPACE));
  pipe_barrier(PIPE_V);
  set_vector_mask(0, count);
  vsel(dst, src0, src1, 1, 1, 1, 1, 8, 8, 8, 2);
}

template <vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void BisectReduce(__ubuf__ T *xd, __ubuf__ T *xn0, __ubuf__ T *xn1) {
  if constexpr (RED_TYPE == V_RED_SUM) {
    vadd(xd, xn0, xn1, 1, 1, 1, 1, 8, 8, 8);
  }
  if constexpr (RED_TYPE == V_RED_MAX) {
    vmax(xd, xn0, xn1, 1, 1, 1, 1, 8, 8, 8);
  }
  if constexpr (RED_TYPE == V_RED_MIN) {
    vmin(xd, xn0, xn1, 1, 1, 1, 1, 8, 8, 8);
  }
}

// Reduce each [red_count, iter_size] slice per dup into one [iter_size] slice.
// Performs a bisection tree reduction in-place on xn/xd; if red_count is odd,
// the last slice is folded into the partial result on the tail path.
// xd[dup_count, 1, iter_size] = xn[dup_count, red_count, iter_size]
template <vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void ReduceBisectLoop(__ubuf__ T *&xd, __ubuf__ T *&xn, uint64_t red_count, uint64_t dup_count,
                                        uint64_t dup_stride, uint64_t iter_size, __ubuf__ T *xd_base) {
  while (red_count > 1) {
    uint64_t iter_tail = red_count & 1ul;
    red_count >>= 1;
    uint64_t reduce_size = red_count * iter_size;
    set_vector_mask(0, reduce_size);
    for (uint64_t i = 0; i < dup_count; ++i) {
      BisectReduce<RED_TYPE>(xd, xn, xn + reduce_size);
      xd += dup_stride;
      xn += dup_stride;
    }
    if (iter_tail) {
      pipe_barrier(PIPE_V);
      set_vector_mask(0, iter_size);
      for (uint64_t i = 0; i < dup_count; ++i) {
        xd -= dup_stride;
        xn -= dup_stride;
        BisectReduce<RED_TYPE>(xd, xd, xn + reduce_size + reduce_size);
      }
    }
    xn = xd = xd_base;
    pipe_barrier(PIPE_V);
  }
}


#define DELCARE_UNARYS(builtin)                                                                             \
  template <typename T>                                                                                     \
  __aicore_inline__ void repeat_##builtin(__ubuf__ T *dst, T val, uint16_t repeat, uint16_t dstBlockStride, \
                                          uint16_t srcBlockStride, uint16_t dstRepeatStride,                \
                                          uint16_t srcRepeatStride) {                                       \
    for (; repeat > 255; repeat -= 255) {                                                                   \
      builtin(dst, val, 255, dstBlockStride, srcBlockStride, dstRepeatStride, srcRepeatStride);             \
      dst += 255 * TYPE_SHIFT(T) * dstRepeatStride;                                                         \
    }                                                                                                       \
    builtin(dst, val, repeat, dstBlockStride, srcBlockStride, dstRepeatStride, srcRepeatStride);            \
  }

// Keep uint8_t *dst 32-byte aligned for cmp mask writes.
#define CMP_REPEAT_SHIFT(T) (sizeof(T) == 4 ? 252 : 254)

#define DELCARE_CMPS(builtin)                                                                                 \
  template <typename T>                                                                                       \
  __aicore_inline__ void repeat_##builtin(__ubuf__ uint8_t *dst, __ubuf__ T *src0, T src1, uint16_t repeat) { \
    constexpr uint64_t repeat_shift = CMP_REPEAT_SHIFT(T);                                                    \
    for (; repeat > repeat_shift; repeat -= repeat_shift) {                                                   \
      builtin(dst, src0, src1, repeat_shift, 1, 1, 8, 8);                                                     \
      dst += repeat_shift * TYPE_SHIFT(T);                                                                     \
      src0 += repeat_shift * BlockNum(T);                                                                      \
    }                                                                                                         \
    builtin(dst, src0, src1, repeat, 1, 1, 8, 8);                                                             \
  }

#define DELCARE_CMP(builtin)                                                                         \
  template <typename T>                                                                              \
  __aicore_inline__ void repeat_##builtin(__ubuf__ uint8_t *dst, __ubuf__ T *src0, __ubuf__ T *src1, \
                                          uint16_t repeat) {                                         \
    constexpr uint64_t repeat_shift = CMP_REPEAT_SHIFT(T);                                           \
    for (; repeat > repeat_shift; repeat -= repeat_shift) {                                          \
      builtin(dst, src0, src1, repeat_shift, 1, 1, 1, 8, 8, 8);                                     \
      dst += repeat_shift * TYPE_SHIFT(T);                                                           \
      src0 += repeat_shift * BlockNum(T);                                                            \
      src1 += repeat_shift * BlockNum(T);                                                            \
    }                                                                                                \
    builtin(dst, src0, src1, repeat, 1, 1, 1, 8, 8, 8);                                              \
  }

DELCARE_UNARYS(vector_dup)

DELCARE_CMPS(vcmpvs_ne)
DELCARE_CMPS(vcmpvs_eq)
DELCARE_CMPS(vcmpvs_le)
DELCARE_CMPS(vcmpvs_lt)
DELCARE_CMPS(vcmpvs_ge)
DELCARE_CMPS(vcmpvs_gt)

DELCARE_CMP(vcmpv_eq)
DELCARE_CMP(vcmpv_le)
DELCARE_CMP(vcmpv_lt)
DELCARE_CMP(vcmpv_ge)
DELCARE_CMP(vcmpv_gt)

template <typename T>
__aicore_inline__ void Reciprocals(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vBinaryS op;
  vBinaryS::Decode(pc, head, op);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  T val = vBinaryS::GetScalar<T>(pc);
  pipe_barrier(PIPE_V);
  set_vector_mask(0, BlockNum(T));
  vector_dup((__ubuf__ T *)WORKSPACE, val, 1, 1, 1, 8, 8);
  pipe_barrier(PIPE_V);
  set_vector_mask(0, op.count);
  vdiv(xd, (__ubuf__ T *)WORKSPACE, xn, 1, 1, 1, 1, 8, 0, 8);
}

template <typename T>
__aicore_inline__ void ElementAny(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vElementAny op;
  vElementAny::Decode(pc, head, op);
  if (IsLastTile(tile)) {
    op.repeat = op.repeat_tail;
  }
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  ReduceBisectLoop<V_RED_MAX, T>(xd, xn, op.repeat, 1, 0, op.simd_width, (__ubuf__ T *)(op.xd));
  set_vector_mask(0, op.simd_width);
  vcmax(xd, xn, 1, 1, 1, 0, ONLY_VALUE);
  set_flag(PIPE_V, PIPE_S, EVENT_ID0);
  wait_flag(PIPE_V, PIPE_S, EVENT_ID0);
  __ubuf__ uint32_t *result = (__ubuf__ uint32_t *)(op.xd);
  if (*result != 0) {
    vStoreCond::EncodeCond(pc + vElementAny::STORE_COND_OFFSET, 0, 1);
  }
}

#define UNARY(pc, builtin, head, tile, VTYPE)       \
  do {                                              \
    vUnary op;                                      \
    vUnary::Decode(pc, head, op);                   \
    __ubuf__ VTYPE *xd = (__ubuf__ VTYPE *)(op.xd); \
    __ubuf__ VTYPE *xn = (__ubuf__ VTYPE *)(op.xn); \
    set_vector_mask(0, op.count);                   \
    builtin(xd, xn, 1, 1, 1, 8, 8);                 \
  } while (0)

#define BINARY(pc, builtin, head, tile, VTYPE)      \
  do {                                              \
    vBinary op;                                     \
    vBinary::Decode(pc, head, op);                  \
    __ubuf__ VTYPE *xm = (__ubuf__ VTYPE *)(op.xm); \
    __ubuf__ VTYPE *xd = (__ubuf__ VTYPE *)(op.xd); \
    __ubuf__ VTYPE *xn = (__ubuf__ VTYPE *)(op.xn); \
    set_vector_mask(0, op.count);                   \
    builtin(xd, xn, xm, 1, 1, 1, 1, 8, 8, 8);       \
  } while (0)

#define CAST(pc, builtin, head, tile, VTYPE, CAST_TYPE)             \
  do {                                                              \
    vUnary op;                                                      \
    vUnary::Decode(pc, head, op);                                   \
    uint16_t dst_rs = (sizeof(CAST_TYPE) >= sizeof(VTYPE)) ? 8 : 4; \
    uint16_t src_rs = (sizeof(CAST_TYPE) <= sizeof(VTYPE)) ? 8 : 4; \
    set_vector_mask(0, op.count);                                   \
    __ubuf__ CAST_TYPE *xd = (__ubuf__ CAST_TYPE *)(op.xd);         \
    __ubuf__ VTYPE *xn = (__ubuf__ VTYPE *)(op.xn);                 \
    builtin(xd, xn, 1, 1, 1, dst_rs, src_rs);                       \
  } while (0)

#define BINARYS(pc, builtin, head, VTYPE)           \
  do {                                              \
    vBinaryS op;                                    \
    vBinaryS::Decode(pc, head, op);                 \
    __ubuf__ VTYPE *xd = (__ubuf__ VTYPE *)(op.xd); \
    __ubuf__ VTYPE *xn = (__ubuf__ VTYPE *)(op.xn); \
    VTYPE val = vBinaryS::GetScalar<VTYPE>(pc);     \
    set_vector_mask(0, op.count);                   \
    builtin(xd, xn, val, 1, 1, 1, 8, 8);            \
  } while (0)

#define BINARYS_EXT(pc, builtin, head, VTYPE)                              \
  do {                                                                 \
    vBinaryS op;                                                       \
    vBinaryS::Decode(pc, head, op);                                    \
    __ubuf__ VTYPE *xd = (__ubuf__ VTYPE *)(op.xd);                    \
    __ubuf__ VTYPE *xn = (__ubuf__ VTYPE *)(op.xn);                    \
    VTYPE val = vBinaryS::GetScalar<VTYPE>(pc);                        \
    pipe_barrier(PIPE_V);                                              \
    set_vector_mask(0, BlockNum(VTYPE));                               \
    vector_dup((__ubuf__ VTYPE *)WORKSPACE, val, 1, 1, 1, 8, 8);       \
    pipe_barrier(PIPE_V);                                              \
    set_vector_mask(0, op.count);                                      \
    builtin(xd, xn, (__ubuf__ VTYPE *)WORKSPACE, 1, 1, 1, 1, 8, 8, 0); \
  } while (0)

template <typename T>
__aicore_inline__ void BinCompare(bcodeptr_t pc, uint64_t head, uint64_t tile) {
#define CMP_DISPATCH(op_type, builtin)                                        \
  case op_type:                                                               \
    do {                                                                      \
      repeat_##builtin(ws, xn, xm, MaxRepeat(op.count, T));                    \
      set_vector_mask(0, BlockNum(T));                                        \
      pipe_barrier(PIPE_V);                                                   \
      if constexpr (op_type == V_CMP_NE) {                                    \
        vector_dup((__ubuf__ T *)WORKSPACE, (T)1.0, 1, 1, 1, 0, 0);           \
        vector_dup((__ubuf__ T *)(WORKSPACE + 256), (T)0.0, 1, 1, 1, 0, 0);   \
      } else {                                                                \
        vector_dup((__ubuf__ T *)WORKSPACE, (T)0.0, 1, 1, 1, 0, 0);           \
        vector_dup((__ubuf__ T *)(WORKSPACE + 256), (T)1.0, 1, 1, 1, 0, 0);   \
      }                                                                       \
    } while (0);                                                              \
    break
  vCompare op;
  vCompare::Decode(pc, head, op);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ T *xm = (__ubuf__ T *)(op.xm);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  __ubuf__ uint8_t *ws = (__ubuf__ uint8_t *)(op.ws);
  set_vector_mask(0, op.count);                                               
  switch (op.type) {
    CMP_DISPATCH(V_CMP_EQ, vcmpv_eq);
    CMP_DISPATCH(V_CMP_NE, vcmpv_eq);
    CMP_DISPATCH(V_CMP_GT, vcmpv_gt);
    CMP_DISPATCH(V_CMP_GE, vcmpv_ge);
    CMP_DISPATCH(V_CMP_LT, vcmpv_lt);
    CMP_DISPATCH(V_CMP_LE, vcmpv_le);
    default: break;
  }
  pipe_barrier(PIPE_V);
  set_vector_mask(0, op.count);
  set_cmpmask((__ubuf__ void *)(WORKSPACE));
  vsel(xd, (__ubuf__ T *)(WORKSPACE + 256), ws, 1, 1, 1, 1, 8, 0, 8, 1);
}

__aicore_inline__ void CompareInt(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vCompare op;
  vCompare::Decode(pc, head, op);
  __ubuf__ float *xd = (__ubuf__ float *)(op.xd);
  __ubuf__ int32_t *xm = (__ubuf__ int32_t *)(op.xm);
  __ubuf__ int32_t *xn = (__ubuf__ int32_t *)(op.xn);
  __ubuf__ uint8_t *ws = (__ubuf__ uint8_t *)(op.ws);
  set_vector_mask(0, op.count);
  repeat_vcmpv_eq(ws, xn, xm, MaxRepeat(op.count, int32_t));
  set_vector_mask(0, BlockNum(int32_t));
  pipe_barrier(PIPE_V);
  if (op.type == V_CMP_NE) {
    vector_dup((__ubuf__ float *)WORKSPACE, (float)1.0, 1, 1, 1, 0, 0);
    vector_dup((__ubuf__ float *)(WORKSPACE + 256), (float)0.0, 1, 1, 1, 0, 0);
  } else {
    vector_dup((__ubuf__ float *)WORKSPACE, (float)0.0, 1, 1, 1, 0, 0);
    vector_dup((__ubuf__ float *)(WORKSPACE + 256), (float)1.0, 1, 1, 1, 0, 0);
  }
  pipe_barrier(PIPE_V);
  set_vector_mask(0, op.count);
  set_cmpmask((__ubuf__ void *)(WORKSPACE));
  vsel(xd, (__ubuf__ float *)(WORKSPACE + 256), ws, 1, 1, 1, 1, 8, 0, 8, 1);
  pipe_barrier(PIPE_V);
  vconv_f322s32z((__ubuf__ int32_t *)xd, xd, 1, 1, 1, 8, 8);
}

__aicore_inline__ void ExtractB32(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vExtract op;
  vExtract::Decode(pc, head, op);
  __ubuf__ uint32_t *xd = (__ubuf__ uint32_t *)(op.xd);
  __ubuf__ uint32_t *src = (__ubuf__ uint32_t *)(op.xn);
  uint32_t pattern = op.slot == 0 ? 1 : 2;
  set_vector_mask(0, op.count * 2);
  vreducev2(xd, src, src, 1, 1, pattern, 0, 0);
}

__aicore_inline__ void InitPackOffset(__ubuf__ uint32_t *offset, uint64_t count) {
  set_flag(PIPE_V, PIPE_S, EVENT_ID0);
  wait_flag(PIPE_V, PIPE_S, EVENT_ID0);
  for (uint64_t idx = 0; idx < TYPE_SHIFT(uint32_t); ++idx) {
    offset[idx] = static_cast<uint32_t>(idx);
  }
  for (uint64_t cur_count = TYPE_SHIFT(uint32_t); cur_count < count;) {
    uint64_t copy_count = cur_count < count - cur_count ? cur_count : count - cur_count;
    set_vector_mask(0, copy_count);
    vadds((__ubuf__ int32_t *)(offset + cur_count), (__ubuf__ int32_t *)offset, (int32_t)cur_count, 1, 1, 1, 8, 8);
    pipe_barrier(PIPE_V);
    cur_count += copy_count;
  }
  set_vector_mask(0, count);
  vshr(offset, offset, (uint32_t)1, 1, 1, 1, 8, 8, false);
  pipe_barrier(PIPE_V);
  vshl(offset, offset, (uint32_t)2, 1, 1, 1, 8, 8);
}

__aicore_inline__ void PackGatherWithMask(__ubuf__ uint32_t *dst, __ubuf__ uint32_t *offset, __ubuf__ uint32_t *src,
                                          uint64_t count, uint64_t repeat, uint64_t mask) {
  uint64_t tail = count - repeat * BlockNum(uint32_t);
  set_vector_mask(0, mask);
  for (; repeat > 255; repeat -= 255) {
    vgather(dst, offset, (uint64_t)src, 8, 255);
    dst += 255 * BlockNum(uint32_t);
    offset += 255 * BlockNum(uint32_t);
  }
  if (repeat > 0) {
    vgather(dst, offset, (uint64_t)src, 8, repeat);
    dst += repeat * BlockNum(uint32_t);
    offset += repeat * BlockNum(uint32_t);
  }
  if (tail > 0) {
    uint64_t tail_mask = ((1ul << tail) - 1) & mask;
    set_vector_mask(0, tail_mask);
    vgather(dst, offset, (uint64_t)src, 8, 1);
  }
}

__aicore_inline__ void Pack(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vPack op;
  vPack::Decode(pc, head, op);
  __ubuf__ uint32_t *xd = (__ubuf__ uint32_t *)(op.xd);
  __ubuf__ uint32_t *lo = (__ubuf__ uint32_t *)(op.xn);
  __ubuf__ uint32_t *hi = (__ubuf__ uint32_t *)(op.xm);
  __ubuf__ uint32_t *offset = (__ubuf__ uint32_t *)(op.ws);
  uint64_t repeat = op.count >> 6;
  InitPackOffset(offset, op.count);
  pipe_barrier(PIPE_V);
  set_mask_norm();
  PackGatherWithMask(xd, offset, lo, op.count, repeat, 0x5555555555555555ul);
  pipe_barrier(PIPE_V);
  PackGatherWithMask(xd, offset, hi, op.count, repeat, 0xaaaaaaaaaaaaaaaaul);
  set_mask_count();
}

template <typename T>
__aicore_inline__ void BinCompareS(bcodeptr_t pc, uint64_t head, uint64_t tile) {
#define CMPS_DISPATCH(op_type, builtin)                                     \
  case op_type:                                                             \
    do {                                                                    \
      repeat_##builtin(ws, xn, val, MaxRepeat(op.count, T));               \
      pipe_barrier(PIPE_V);                                                 \
      set_vector_mask(0, BlockNum(T));                                      \
      if constexpr (op_type == V_CMP_NE) {                                  \
        vector_dup((__ubuf__ T *)WORKSPACE, (T)1.0, 1, 1, 1, 0, 0);         \
        vector_dup((__ubuf__ T *)(WORKSPACE + 256), (T)0.0, 1, 1, 1, 0, 0); \
      } else {                                                              \
        vector_dup((__ubuf__ T *)WORKSPACE, (T)0.0, 1, 1, 1, 0, 0);         \
        vector_dup((__ubuf__ T *)(WORKSPACE + 256), (T)1.0, 1, 1, 1, 0, 0); \
      }                                                                     \
    } while (0);                                                            \
    break
  vCompareS op;
  vCompareS::Decode(pc, head, op);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  __ubuf__ uint8_t *ws = (__ubuf__ uint8_t *)(op.ws);
  set_vector_mask(0, op.count);
  T val = vCompareS::GetScalar<T>(pc);
  switch (op.type) {
    CMPS_DISPATCH(V_CMP_EQ, vcmpvs_eq);
    CMPS_DISPATCH(V_CMP_NE, vcmpvs_eq);
    CMPS_DISPATCH(V_CMP_GT, vcmpvs_gt);
    CMPS_DISPATCH(V_CMP_GE, vcmpvs_ge);
    CMPS_DISPATCH(V_CMP_LT, vcmpvs_lt);
    CMPS_DISPATCH(V_CMP_LE, vcmpvs_le);
    default: break;
  }
  set_vector_mask(0, op.count);
  pipe_barrier(PIPE_V);
  set_cmpmask((__ubuf__ void *)(WORKSPACE));
  vsel(xd, (__ubuf__ T *)(WORKSPACE + 256), ws, 1, 1, 1, 1, 8, 0, 8, 1);
}

__aicore_inline__ void _IsFiniteProc(__ubuf__ uint16_t *xd, __ubuf__ uint16_t *xn, uint16_t repeat, uint16_t rs) {
  vshl(xd, xn, 1, repeat, 1, 1, rs, rs);
  pipe_barrier(PIPE_V);
  vshr(xd, xd, 11, repeat, 1, 1, rs, rs, false);
  pipe_barrier(PIPE_V);
  vsub((__ubuf__ int16_t *)xd, (__ubuf__ int16_t *)WORKSPACE, (__ubuf__ int16_t *)xd, repeat, 1, 1, 1, rs, 0, rs);
  pipe_barrier(PIPE_V);
  vmins((__ubuf__ int16_t *)xd, (__ubuf__ int16_t *)xd, (int16_t)1, repeat, 1, 1, rs, rs);
  pipe_barrier(PIPE_V);
  vconv_s162f16((__ubuf__ half *)xd, (__ubuf__ int16_t *)xd, repeat, 1, 1, rs, rs);
}

__aicore_inline__ void _IsFiniteProc(__ubuf__ uint32_t *xd, __ubuf__ uint32_t *xn, uint16_t repeat, uint16_t rs) {
  vshl(xd, xn, 1, repeat, 1, 1, rs, rs);
  pipe_barrier(PIPE_V);
  vshr(xd, xd, 24, repeat, 1, 1, rs, rs, false);
  pipe_barrier(PIPE_V);
  vsub((__ubuf__ int32_t *)xd, (__ubuf__ int32_t *)WORKSPACE, (__ubuf__ int32_t *)xd, repeat, 1, 1, 1, rs, 0, rs);
  pipe_barrier(PIPE_V);
  vmins((__ubuf__ int32_t *)xd, (__ubuf__ int32_t *)xd, (int32_t)1, repeat, 1, 1, rs, rs);
  pipe_barrier(PIPE_V);
  vconv_s322f32((__ubuf__ float *)xd, (__ubuf__ int32_t *)xd, repeat, 1, 1, rs, rs);
}

template <typename T>
__aicore_inline__ void IsFinite(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vUnary op;
  vUnary::Decode(pc, head, op);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  set_vector_mask(0, BlockNum(T));
  pipe_barrier(PIPE_V);
  vector_dup((__ubuf__ T *)WORKSPACE, (T)(sizeof(T) == 4 ? 255 : 31), 1, 1, 1, 0, 0);
  set_vector_mask(0, op.count);
  _IsFiniteProc(xd, xn, 1, 8);
}

__aicore_inline__ void _PowerProc(__ubuf__ float *xd, __ubuf__ float *xm, __ubuf__ float *xn, __ubuf__ float *ws0,
                                  __ubuf__ uint8_t *ws1, uint8_t repeat, uint32_t cmp_repeat, uint64_t rs) {
  // x^y = e^{yln{abs{x}}}
  vabs(xd, xn, repeat, 1, 1, rs, rs);
  pipe_barrier(PIPE_V);
  vln(xd, xd, repeat, 1, 1, rs, rs);
  pipe_barrier(PIPE_V);
  vmul(xd, xd, xm, repeat, 1, 1, 1, rs, rs, rs);
  pipe_barrier(PIPE_V);
  vexp(xd, xd, repeat, 1, 1, rs, rs);

  // Check 0^0
  set_cmpmask((__ubuf__ void *)(WORKSPACE));
  pipe_barrier(PIPE_V);
  repeat_vcmpvs_ne(ws1, xm, (float)0, cmp_repeat);
  pipe_barrier(PIPE_V);
  vsel(xd, xd, ws1, repeat, 1, 1, 1, rs, rs, 0, 1);
  pipe_barrier(PIPE_V);

  // Check negative^{decimal}
  vconv_f322s32z((__ubuf__ int32_t *)ws0, xm, repeat, 1, 1, rs, rs);
  pipe_barrier(PIPE_V);
  vconv_s322f32(ws0, (__ubuf__ int32_t *)ws0, repeat, 1, 1, rs, rs);
  pipe_barrier(PIPE_V);
  repeat_vcmpv_eq((__ubuf__ uint8_t *)ws1, ws0, xm, cmp_repeat);
  set_cmpmask((__ubuf__ void *)(WORKSPACE + 256));

  // Constructing the odd-even case
  vmuls(ws0, xm, (float)0.5, repeat, 1, 1, rs, rs);
  pipe_barrier(PIPE_V);
  vFloor(ws0, repeat, rs);
  pipe_barrier(PIPE_V);
  vsel(ws0, ws0, ws1, repeat, 1, 1, 1, rs, rs, 0, 1);
  pipe_barrier(PIPE_V);
  vmuls(ws0, ws0, (float)2.0, repeat, 1, 1, rs, rs);
  pipe_barrier(PIPE_V);
  vsub(ws0, xm, ws0, repeat, 1, 1, 1, rs, rs, rs);
  pipe_barrier(PIPE_V);
  vmuls(ws0, ws0, (float)2.0, repeat, 1, 1, rs, rs);
  pipe_barrier(PIPE_V);
  vadds(ws0, ws0, (float)1.0, repeat, 1, 1, rs, rs);
  pipe_barrier(PIPE_V);
  vmul(ws0, ws0, xd, repeat, 1, 1, 1, rs, rs, rs);
  pipe_barrier(PIPE_V);

  repeat_vcmpvs_lt(ws1, xn, (float)0, cmp_repeat);
}

__aicore_inline__ void Power(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vBinaryWS op;
  vBinaryWS::Decode(pc, head, op);
  __ubuf__ float*xm = (__ubuf__ float*)(op.xm);
  __ubuf__ float*xd = (__ubuf__ float*)(op.xd);
  __ubuf__ float*xn = (__ubuf__ float*)(op.xn);
  __ubuf__ float*ws0 = (__ubuf__ float*)(op.ws0);
  __ubuf__ uint8_t *ws1 = (__ubuf__ uint8_t *)(op.ws1);
  pipe_barrier(PIPE_V);
  set_vector_mask(0, BlockNum(float));
  vector_dup((__ubuf__ float *)(WORKSPACE), (float)1.0, 1, 1, 1, 0, 0);
  vector_dup((__ubuf__ float *)(WORKSPACE + 256), 0.0f / 0.0f, 1, 1, 1, 0, 0);
  set_vector_mask(0, op.count);
  _PowerProc(xd, xm, xn, ws0, ws1, 1, MaxRepeat(op.count, float), 8);
  pipe_barrier(PIPE_V);
  SelectMode2(xd, ws0, xd, op.count, ws1);
}

template <typename T>
__aicore_inline__ void BroadcastS(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vBroadcastS op;
  vBroadcastS::Decode(pc, head, op);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  T val = op.scalar;
  set_vector_mask(0, op.count);
  vector_dup(xd, val, 1, 1, 1, 8, 8);
}

__aicore_inline__ void BroadcastS_B64(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vBroadcastS_B64 op;
  vBroadcastS_B64::Decode(pc, head, op);
  __ubuf__ uint32_t *xd = (__ubuf__ uint32_t *)(op.xd);
  uint64_t repeat = op.count >> 5;
  uint64_t tail = (op.count & 31) << 1;

  set_mask_norm();
  set_vector_mask(0, 0x5555555555555555ul);
  if (repeat > 0) {
    repeat_vector_dup(xd, static_cast<uint32_t>(op.scalar), repeat, 1, 1, 8, 8);
  }
  if (tail > 0) {
    set_vector_mask(0, ((1ul << tail) - 1) & 0x5555555555555555ul);
    vector_dup(xd + repeat * BlockNum(uint32_t), static_cast<uint32_t>(op.scalar), 1, 1, 1, 8, 8);
  }
  set_vector_mask(0, 0xaaaaaaaaaaaaaaaaul);
  if (repeat > 0) {
    repeat_vector_dup(xd, static_cast<uint32_t>(op.high), repeat, 1, 1, 8, 8);
  }
  if (tail > 0) {
    set_vector_mask(0, ((1ul << tail) - 1) & 0xaaaaaaaaaaaaaaaaul);
    vector_dup(xd + repeat * BlockNum(uint32_t), static_cast<uint32_t>(op.high), 1, 1, 1, 8, 8);
  }
  set_mask_count();
}

template <typename T>
__aicore_inline__ void BroadcastX(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vBroadcastX op;
  vBroadcastX::Decode(pc, head, op);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  uint64_t count = op.count;
  uint64_t rs = count >> BlockDataShift(T);
  uint64_t tail = (op.lead_num & 7);
  for (uint64_t i = 0; i < op.iter_num; ++i) {
    // Use 254 (not 255) to avoid 32B misalignment when xn is uint16_t.
    uint64_t repeat = op.lead_num >> 3;
    for (; repeat > 254; repeat -= 254) {
      vbrcb(xd, xn, rs, rs * VBRCB_NUM, 254);
      xd += count * 254 * VBRCB_NUM;
      xn += 254 * VBRCB_NUM;
    }
    vbrcb(xd, xn, rs, rs * VBRCB_NUM, repeat);
    xd += count * (repeat * VBRCB_NUM + tail);
    xn += repeat * VBRCB_NUM + tail + op.lead_pad;
  }
  if (tail > 0) {
    xd = (__ubuf__ T *)(op.xd);
    xn = (__ubuf__ T *)(op.xn);
    __ubuf__ T *ws = (__ubuf__ T *)(WORKSPACE);
    for (uint64_t i = 0; i < op.iter_num; ++i) {
      uint64_t repeat = op.lead_num >> 3;
      xd += count * repeat * VBRCB_NUM;
      xn += repeat * VBRCB_NUM;
      pipe_barrier(PIPE_V);
      if constexpr (sizeof(T) == sizeof(uint16_t)) {
        if (repeat & 1ul) {
          vbrcb(ws, xn - VBRCB_NUM, 1, 8, 2);
          pipe_barrier(PIPE_V);
          copy_ubuf_to_ubuf(xd, ws + BlockNum(T), 0, tail, 1, 0, rs - 1);
        } else {
          vbrcb(ws, xn, 1, 0, 1);
          pipe_barrier(PIPE_V);
          copy_ubuf_to_ubuf(xd, ws, 0, tail, 1, 0, rs - 1);
        }
      } else {
        vbrcb(ws, xn, 1, 0, 1);
        pipe_barrier(PIPE_V);
        copy_ubuf_to_ubuf(xd, ws, 0, tail, 1, 0, rs - 1);
      }
      xd += count * tail;
      xn += tail + op.lead_pad;
    }
  }
  if (count > TYPE_SHIFT(T)) {
    set_vector_mask(0, count);
    xd = (__ubuf__ T *)(op.xd);
    pipe_barrier(PIPE_V);
    for (uint64_t i = 0; i < op.iter_num; ++i) {
      uint64_t repeat = op.lead_num;
      for (; repeat > 255; repeat -= 255) {
        vcopy(xd, xd, 255, 1, 0, rs, rs);
        xd += 255 * count;
      }
      vcopy(xd, xd, repeat, 1, 0, rs, rs);
      xd += repeat * count;
    }
  }
}

__aicore_inline__ void BroadcastY(bcodeptr_t pc, uint64_t head) {
  vBroadcastY op;
  vBroadcastY::Decode(pc, head, op);
  __ubuf__ uint8_t *xd = (__ubuf__ uint8_t *)(op.xd);
  __ubuf__ uint8_t *xn = (__ubuf__ uint8_t *)(op.xn);
  uint64_t dst_rs = op.dup_num * op.dup_stride;
  uint64_t block_size = 1;
  uint64_t lenburst = op.dup_stride;
  copy_ubuf_to_ubuf(xd, xn, 0, op.iter_num, lenburst, 0, dst_rs - lenburst);
  while ((block_size << 1) <= op.dup_num) {
    pipe_barrier(PIPE_V);
    copy_ubuf_to_ubuf(xd + (lenburst << 5), xd, 0, op.iter_num, lenburst, dst_rs - lenburst, dst_rs - lenburst);
    block_size <<= 1;
    lenburst <<= 1;
  }
  if (op.dup_num > block_size) {
    lenburst = (op.dup_num - block_size) * op.dup_stride;
    pipe_barrier(PIPE_V);
    copy_ubuf_to_ubuf(xd + (block_size * op.dup_stride << 5), xd, 0, op.iter_num, lenburst, dst_rs - lenburst,
                      dst_rs - lenburst);
  }
}

template <vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void ReduceX(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vReduceX op;
  vReduceX::Decode(pc, head, op);
  if (IsLastTile(tile)) {
    op.red_size = op.red_tail;
  }
  __ubuf__ T *xn = (__ubuf__ T*)(op.xn);
  __ubuf__ T *xd = (__ubuf__ T*)(op.xd);
  uint64_t simd_width = op.simd_width;
  uint64_t red_size = op.red_size / simd_width; // TODO: calc by host
  ReduceBisectLoop<RED_TYPE>(xd, xn, red_size, op.dup_size, op.red_size, simd_width, (__ubuf__ T *)(op.xd));
  vReduceX::DecodeBlock(pc, op);
  uint64_t dst_rs = op.dup_block + op.dup_pad;
  uint64_t src_rs = op.red_size * op.dup_block;
  uint64_t iter_num = op.dup_size / op.dup_block;
  set_mask_norm();
  SetVectorMask(simd_width);
  while (iter_num--) {
    if constexpr (RED_TYPE == V_RED_SUM) {
      repeat_vcadd(xd, xn, op.dup_block, 1, op.red_size >> BlockDataShift(T));
    }
    if constexpr (RED_TYPE == V_RED_MAX) {
      repeat_vcmax(xd, xn, op.dup_block, 1, op.red_size >> BlockDataShift(T));
    }
    if constexpr (RED_TYPE == V_RED_MIN) {
      repeat_vcmin(xd, xn, op.dup_block, 1, op.red_size >> BlockDataShift(T));
    }
    xd += dst_rs;
    xn += src_rs;
  }
  set_mask_count();
}

template <vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void ReduceY(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vReduceY op;
  vReduceY::Decode(pc, head, op);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  uint64_t red_size = IsLastTile(tile) ? op.red_tail : op.red_size;
  if (red_size == 1) {
    uint64_t lenburst = op.dup_num * op.iter_size >> BlockDataShift(T);
    copy_ubuf_to_ubuf(xd, xn, 0, 1, lenburst, 0, 0);
    return;
  }
  uint64_t stride_size = op.iter_size * red_size;
  ReduceBisectLoop<RED_TYPE>(xd, xn, red_size, op.dup_num, stride_size, op.iter_size, (__ubuf__ T *)(op.xd));
  if (op.dup_num > 1) {
    pipe_barrier(PIPE_V);
    auto lenburst = op.iter_size >> BlockDataShift(T);
    copy_ubuf_to_ubuf(xd, xn, 0, op.dup_num, lenburst, (stride_size >> BlockDataShift(T)) - lenburst, 0);
  }
}

__aicore_inline__ void ReduceJoin(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vReduceJoin op;
  vReduceJoin ::Decode(pc, head, op);
  uint32_t red_head = *reinterpret_cast<__bcode__ uint32_t *>(pc + op.seg_tile_rel);
  uint64_t iter_total = op.iter_num * op.iter_stride;
  uint64_t lenburst = (iter_total + 7) >> BlockDataShift(float);
  set_vector_mask(0, iter_total);
  // RESTRICT: tile in segement is continuously
  if (IsBeginTile(tile) && !(red_head >> V_RED_HEAD_INC_FLAG_OFFSET)) {
    copy_ubuf_to_ubuf((__ubuf__ void *)op.xd, (__ubuf__ void *)op.xn, 0, 1, lenburst, 0, 0);
  } else {
    vadd((__ubuf__ float *)op.xd, (__ubuf__ float *)op.xd, (__ubuf__ float *)op.xn, 1, 1, 1, 1, 8, 8, 8);
  }
  uint32_t loop_repeat = (red_head >> V_RED_HEAD_REPEAT_OFFSET) & V_RED_HEAD_REPEAT_MASK;
  if (!IsEndTile(tile) || loop_repeat > 0) {
    return;
  }
  uint32_t thread_size = (red_head >> V_RED_HEAD_THREAD_OFFSET) & V_RED_HEAD_THREAD_MASK;
  if (thread_size == 1) {
    vStoreCond::EncodeCond(pc + vReduceJoin::STORE_COND_OFFSET, 0, op.iter_num > 1 ? op.iter_num : op.iter_stride);
    return;
  }
  uint64_t blockidx = vBlockIdx();
  uint64_t ws_stride = lenburst * 32;
  set_flag(PIPE_V, PIPE_MTE3, EVENT_ID7);
  wait_flag(PIPE_V, PIPE_MTE3, EVENT_ID7);
  copy_ubuf_to_gm((__gm__ uint8_t *)op.ws + blockidx * ws_stride, (__ubuf__ float *)op.xd, 0, 1, lenburst, 0, 0);
  uint64_t iter_offset, iter_range, join_offset, join_count;
  uint64_t thread_idx = blockidx % thread_size;
  constexpr uint64_t flag_id = 0;
  uint64_t sync_flag = vFftsSyncConfig(0, flag_id);
  if (op.iter_num == 1) {
    if (thread_idx > 0 || iter_total > 64) {
      ffts_cross_core_sync(PIPE_MTE3, sync_flag);
    } else {
      ffts_cross_core_sync(PIPE_V, sync_flag);
    }
    join_count = ((iter_total - 1) / thread_size + 64) & ~0x3ful;
    join_offset = join_count * thread_idx;
    if (join_offset + join_count > iter_total) {
      join_count = iter_total - join_offset;
    }
    iter_offset = join_offset;
    iter_range = join_count;
  } else {
    ffts_cross_core_sync(PIPE_MTE3, sync_flag);
    iter_range = (op.iter_num - 1) / thread_size + 1;
    iter_offset = iter_range * thread_idx;
    if (iter_offset + iter_range > op.iter_num) {
      iter_range = op.iter_num - iter_offset;
    }
    join_offset = iter_offset * op.iter_stride;
    join_count = iter_range * op.iter_stride;
  }
  wait_flag_dev(flag_id);
  if (join_offset >= iter_total) {
    return;
  }
  vStoreCond::EncodeCond(pc + vReduceJoin::STORE_COND_OFFSET, iter_offset, iter_range);
  set_vector_mask(0, join_count);
  op.xd += join_offset * sizeof(float);
  op.ws += join_offset * sizeof(float);
  uint64_t loop_cnt, bidx;
  if (thread_idx > 0) {
    loop_cnt = thread_size - 1;
    bidx = blockidx - thread_idx;
  } else {
    loop_cnt = thread_size - 2;
    bidx = blockidx + 1;
  }
  event_t ping = EVENT_ID6;
  event_t pong = EVENT_ID7;
  copy_gm_to_ubuf_align_b8((__ubuf__ float *)op.xs, (__gm__ uint8_t *)op.ws + bidx * ws_stride, 0, 1,
                           join_count * sizeof(float), 0, 0, 0, 0);
  set_flag(PIPE_MTE2, PIPE_V, ping);
  while (loop_cnt--) {
    if (++bidx == blockidx) continue;
    copy_gm_to_ubuf_align_b8((__ubuf__ float *)op.xn, (__gm__ uint8_t *)op.ws + bidx * ws_stride, 0, 1,
                             join_count * sizeof(float), 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, pong);
    wait_flag(PIPE_MTE2, PIPE_V, ping);
    vadd((__ubuf__ float *)op.xd, (__ubuf__ float *)op.xd, (__ubuf__ float *)op.xs, 1, 1, 1, 1, 8, 8, 8);
    if (loop_cnt) {
      set_flag(PIPE_V, PIPE_MTE2, ping);
      wait_flag(PIPE_V, PIPE_MTE2, ping);
    }
    pipe_barrier(PIPE_V);
    uint64_t xs = op.xs;
    op.xs = op.xn;
    op.xn = xs;
    event_t event = ping;
    ping = pong;
    pong = event;
  }
  wait_flag(PIPE_MTE2, PIPE_V, ping);
  vadd((__ubuf__ float *)op.xd, (__ubuf__ float *)op.xd, (__ubuf__ float *)op.xs, 1, 1, 1, 1, 8, 8, 8);
}

template <typename T>
__aicore_inline__ void Select(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vSelect op;
  vSelect::Decode(pc, head, op);
  __ubuf__ T *xm = (__ubuf__ T*)(op.xm);
  __ubuf__ T *cond = (__ubuf__ T*)(op.cond);
  __ubuf__ T *xd = (__ubuf__ T*)(op.xd);
  __ubuf__ T *xn = (__ubuf__ T*)(op.xn);
  __ubuf__ uint8_t *ws = (__ubuf__ uint8_t*)(op.ws);
  set_vector_mask(0, op.count);
  repeat_vcmpvs_ne(ws, cond, (T)0, MaxRepeat(op.count, T));
  pipe_barrier(PIPE_V);
  SelectMode2(xd, xn, xm, op.count, ws);
}

__aicore_inline__ void Copy(bcodeptr_t pc, uint64_t head) {
  vCopy op;
  vCopy::Decode(pc, head, op);
  copy_ubuf_to_ubuf((__ubuf__ void *)op.xd, (__ubuf__ void *)op.xn, 0, 1, op.lenburst, 0, 0);
}

template <typename T>
__aicore_inline__ void ClearPad(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vClearPad op;
  vClearPad::Decode(pc, head, op);
  if (IsLastTile(tile) && op.iter_tail) {
    op.iter_size = op.iter_tail;
    op.iter_stride = op.iter_tail + op.simd_width - (op.iter_tail % op.simd_width);
  }
  if (op.iter_size == op.iter_stride) {
    return;
  }
  uint64_t simd_valid = op.iter_size - (op.iter_stride - op.simd_width);
  set_mask_norm();
  SetInvalidMask<T>(op.simd_width, simd_valid);
  __ubuf__ T *fill = (__ubuf__ T *)(op.xd) + op.iter_size - simd_valid;
  uint64_t repeat_stride = op.iter_stride >> BlockDataShift(T);
  repeat_vector_dup(fill, (T)op.scalar, op.iter_num, 1, 1, repeat_stride, repeat_stride);
  set_mask_count();
}

template <typename T>
__aicore_inline__ void AtomicCum(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vAtomicCum op;
  vAtomicCum::Decode(pc, head, op);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  uint64_t tile_idx = TileIdx(tile);
  if (op.round_rank) {
    tile_idx = RoundUpTileIdx<kRoundCacheLoad>(tile, tile_idx, op.round_rank, pc + vAtomicCum::ROUND_OFFSET);
    if (tile_idx == INVALID_INT) {
      set_vector_mask(0, op.count);
      if (op.red_op == V_RED_SUM) {
        vadd(xd, xd, xn, 1, 1, 1, 1, 8, 8, 8);
      } else if (op.red_op == V_RED_MAX) {
        vmax(xd, xd, xn, 1, 1, 1, 1, 8, 8, 8);
      } else if (op.red_op == V_RED_MIN) {
        vmin(xd, xd, xn, 1, 1, 1, 1, 8, 8, 8);
      }
      return;
    }
  }
  copy_ubuf_to_ubuf((__ubuf__ void *)op.xd, (__ubuf__ void *)op.xn, 0, 1, op.count >> BlockDataShift(T), 0, 0);
}

template <typename T>
__aicore_inline__ void OneHot(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vOneHot op;
  vOneHot::Decode(pc, op);
  __ubuf__ int32_t *indices = (__ubuf__ int32_t *)(op.xn);
  __ubuf__ T *xd = (__ubuf__ T*)(op.xd);
  T on_value, off_value;
  vOneHot::DecodeValue(pc, on_value, off_value);
  set_vector_mask(0, op.data_size);
  vector_dup(xd, off_value, 1, 1, 1, 8, 8);
  set_flag(PIPE_V, PIPE_S, EVENT_ID0);
  wait_flag(PIPE_V, PIPE_S, EVENT_ID0);
  switch (op.mode) {
    case vOneHot::MODE_X: {
      for (uint64_t i = 0; i < op.iter_num; ++i) {
        if (uint64_t indice = indices[i]; indice < op.depth) {
          xd[i * op.depth + indice] = on_value;
        }
      }
      break;
    }
    case vOneHot::MODE_X_TILE: {
      uint64_t begin = (TileIdx(tile) % op.dup_round) * op.depth;
      if (uint64_t indice = indices[0]; indice >= begin && indice < begin + op.depth) {
        xd[indice - begin] = on_value;
      }
      break;
    }
    case vOneHot::MODE_Y: {
      for (uint64_t dup = 0; dup < op.dup_round; ++dup) {
        for (uint64_t i = 0; i < op.iter_num; ++i) {
          if (uint64_t indice = indices[op.iter_num * dup + i]; indice < op.depth) {
            xd[(op.depth * dup + indice) * op.iter_num + i] = on_value;
          }
        }
      }
      break;
    }
    case vOneHot::MODE_Y_TILE: {
      uint64_t begin = (TileIdx(tile) % op.dup_round) * op.depth;
      uint64_t end = begin + op.depth;
      for (uint64_t i = 0; i < op.iter_num; ++i) {
        if (uint64_t indice = indices[i]; indice >= begin && indice < end) {
          xd[(indice - begin) * op.iter_num + i] = on_value;
        }
      }
      break;
    }
    case vOneHot::MODE_Y_TILE_2: {
      uint64_t begin = (TileIdx(tile) % op.dup_round) / op.depth;
      uint64_t end = begin + 1ul;
      for (uint64_t i = 0; i < op.iter_num; ++i) {
        if (uint64_t indice = indices[i]; indice >= begin && indice < end) {
          xd[i] = on_value;
        }
      }
      break;
    }
    default:
      break;
  }
  set_flag(PIPE_S, PIPE_V, EVENT_ID0);
  wait_flag(PIPE_S, PIPE_V, EVENT_ID0);
}

__aicore_inline__ void Custom(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vCustom op;
  vCustom::Decode(pc, op);
  auto func = reinterpret_cast<OpFunc>(op.func_addr);
  func(pc + vCustom::PAYLOAD_OFFSET, head, tile);
}

__aicore_inline__ void SliceLoad2D(__ubuf__ uint8_t *dst, __gm__ uint8_t *src, uint64_t begin_m, uint64_t end_m,
                                        uint64_t begin_n, uint64_t end_n, uint64_t slice_n, uint64_t src_n,
                                        uint64_t pad_size, uint64_t type_size) {
  if (begin_m == end_m && begin_n <= end_n) {
    copy_gm_to_ubuf_align_b8(dst, src, 0, 1, (end_n - begin_n + 1) * type_size, 0, 0, 0, 0);
  } else if (begin_m < end_m) {
    uint64_t num = end_m - begin_m + 1;
    copy_gm_to_ubuf_align_b8(dst, src, 0, num, slice_n * type_size, 0, 0, (src_n - slice_n) * type_size,
                             (pad_size * type_size) >> 5);
  }
}

__aicore_inline__ void SliceStore2D(__gm__ uint8_t *dst, __ubuf__ uint8_t *src, uint64_t begin_m, uint64_t end_m,
                                         uint64_t begin_n, uint64_t end_n, uint64_t slice_n, uint64_t src_n,
                                         uint64_t pad_size, uint64_t type_size, uint64_t one_flag = 0) {
  if (one_flag) {
    set_flag(PIPE_V, PIPE_S, EVENT_ID0);
    wait_flag(PIPE_V, PIPE_S, EVENT_ID0);
    uint64_t num = end_m - begin_m + 1;
    while (num--) {
      for (size_t j = 0; j < type_size; j++) {
        *(__ubuf__ uint8_t *)(WORKSPACE + j) = *((__ubuf__ uint8_t *)(src++));
      }
      copy_ubuf_to_gm_align_b8(dst, (__ubuf__ uint8_t *)WORKSPACE, 0, 1, type_size, 0, 0, 0, 0);
      set_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
      wait_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
      dst += src_n * type_size;
    }
    return;
  }
  if (begin_m == end_m && begin_n <= end_n) {
    copy_ubuf_to_gm_align_b8(dst, src, 0, 1, (end_n - begin_n + 1) * type_size, 0, 0, 0, 0);
  } else if (begin_m < end_m) {
    uint64_t num = end_m - begin_m + 1;
    copy_ubuf_to_gm_align_b8(dst, src, 0, num, slice_n * type_size, 0, 0, (pad_size * type_size) >> 5,
                             (src_n - slice_n) * type_size);
  }
}

__aicore_inline__ void SLoad(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vSLoad op;
  vShard2D shard;
  vSLoad::Decode(pc, head, op);
  vShard2D::Decode(pc + op.shard_rel, shard);
  uint64_t tile_idx = TileIdx(tile);
  uint64_t begin_tmp = op.tile_stride * tile_idx;
  uint64_t end_tmp = begin_tmp + op.tile_stride - 1;
  __ubuf__ uint8_t *dst = (__ubuf__ uint8_t *)(op.xn);
  __gm__ uint8_t *src = (__gm__ uint8_t *)op.gm;
  uint64_t shard_offset = shard.offset;
  uint64_t cidx = vGetBitRange(shard.pos, V_MM_POS_C_OFFSET, V_MM_POS_C_BITS);
  if (op.round_rank) {
    uint64_t base_cidx = cidx;
    cidx = RoundUpTileIdx<kRoundCacheNone>(tile, base_cidx, op.round_rank, pc + vSLoad::ROUND_OFFSET);
    shard_offset -= (base_cidx - cidx) * shard.stride_m;
  }
  if (op.broadcast_m) {
    if (op.broadcast_n) {
      src += cidx * op.type_size;
      copy_gm_to_ubuf_align_b8(dst, src, 0, 1, op.type_size, 0, 0, 0, 0);
    } else {
      src += (cidx * shard.stride_n + shard_offset % shard.stride_n) * op.type_size;
      copy_gm_to_ubuf_align_b8(dst, src, 0, 1, op.tile_stride * op.type_size, 0, 0, 0, 0); // TODO: tail overflow
    }
  } else if (op.broadcast_n) {
    src += (shard_offset / shard.stride_n + begin_tmp) * op.type_size;
    copy_gm_to_ubuf_align_b8(dst, src, 0, 1, op.tile_stride * op.type_size, 0, 0, 0, 0); // TODO: tail overflow
  } else {
    uint64_t slice_m = shard.slice_m;
    uint64_t slice_n = shard.slice_n;
    uint64_t begin_m = begin_tmp / slice_n;
    uint64_t end_m = IsLastTile(tile) ? slice_m - 1 : end_tmp / slice_n;
    uint64_t begin_n = begin_tmp % slice_n;
    uint64_t end_n = IsLastTile(tile) ? slice_n - 1 : end_tmp % slice_n;
    uint64_t pad_size = op.pad_size;
    if (shard.last_m) {
      end_m = min(end_m, shard.tail_m - 1);
    }
    if (shard.last_n) {
      uint64_t tail_n = shard.tail_n;
      end_n = min(end_n, tail_n - 1);
      pad_size += slice_n - tail_n;
      slice_n = tail_n;
    }
    uint64_t offset_slice = begin_m * shard.stride_n + begin_n + shard_offset;
    src += offset_slice * op.type_size;
    SliceLoad2D(dst, src, begin_m, end_m, begin_n, end_n, slice_n, shard.stride_n, pad_size, op.type_size);
  }
}

__aicore_inline__ void SStore(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vSStore op;
  vShard2D shard;
  vSStore::Decode(pc, head, op);
  vShard2D::Decode(pc + op.shard_rel, shard);
  uint64_t tile_idx = TileIdx(tile);
  uint64_t begin_tmp = op.tile_stride * tile_idx;
  __ubuf__ uint8_t *src = (__ubuf__ uint8_t *)op.xn;
  __gm__ uint8_t *dst = (__gm__ uint8_t *)op.gm;
  uint64_t cidx = vGetBitRange(shard.pos, V_MM_POS_C_OFFSET, V_MM_POS_C_BITS);
  uint64_t shard_offset = shard.offset;
  if (op.round_rank) {
    uint64_t base_cidx = cidx;
    cidx = RoundUpTileIdx<kRoundCacheNone>(tile, base_cidx, op.round_rank, pc + vSStore::ROUND_OFFSET);
    shard_offset -= (base_cidx - cidx) * shard.stride_m;
  }
  if (op.broadcast_m || op.broadcast_n) {
    uint64_t midx = vGetBitRange(shard.pos, V_MM_POS_M_OFFSET, V_MM_POS_M_BITS);
    uint64_t nidx = vGetBitRange(shard.pos, V_MM_POS_N_OFFSET, V_MM_POS_N_BITS);
    if (!op.broadcast_m) {
      if (uint64_t end_m = shard.last_m ? shard.tail_m : shard.slice_m; begin_tmp < end_m && nidx == 0) {
        dst += (shard_offset / shard.stride_n + begin_tmp) * op.type_size;
        uint64_t lenburst = min(end_m - begin_tmp, op.tile_stride) * op.type_size;
        copy_ubuf_to_gm_align_b8(dst, src, 0, 1, lenburst, 0, 0, 0, 0);
        OVER_WRITE_CHECK(pc, head, ((uint64_t)dst - (uint64_t)op.gm) + lenburst);
      }
    } else if (!op.broadcast_n) {
      if (uint64_t end_n = shard.last_n ? shard.tail_n : shard.slice_n; begin_tmp < end_n && midx == 0) {
        dst += (cidx * shard.stride_n + shard_offset % shard.stride_n) * op.type_size;
        uint64_t lenburst = min(end_n - begin_tmp, op.tile_stride) * op.type_size;
        copy_ubuf_to_gm_align_b8(dst, src, 0, 1, lenburst, 0, 0, 0, 0);
        OVER_WRITE_CHECK(pc, head, ((uint64_t)dst - (uint64_t)op.gm) + lenburst);
      }
    } else if (midx == 0 && nidx == 0 && tile_idx == 0) {
      dst += cidx * op.type_size;
      copy_ubuf_to_gm_align_b8(dst, src, 0, 1, op.type_size, 0, 0, 0, 0);
      OVER_WRITE_CHECK(pc, head, (cidx + 1) * op.type_size);
    }
    return;
  }
  uint64_t end_tmp = begin_tmp + op.tile_stride - 1;
  uint64_t slice_m = shard.slice_m;
  uint64_t slice_n = shard.slice_n;
  uint64_t begin_m = begin_tmp  / slice_n;
  uint64_t end_m = IsLastTile(tile) ? slice_m - 1 : end_tmp  / slice_n;
  uint64_t begin_n = begin_tmp % slice_n;
  uint64_t end_n = IsLastTile(tile) ? slice_n - 1 : end_tmp % slice_n;
  if (shard.last_m) {
    end_m = min(end_m, shard.tail_m - 1);
  }
  uint64_t pad_size = op.pad_size;
  if (shard.last_n) {
    uint64_t tail_n = shard.tail_n;
    end_n = min(end_n, tail_n - 1);
    pad_size += slice_n - tail_n;
    slice_n = tail_n;
  }
  uint64_t offset_slice = begin_m * shard.stride_n + begin_n + shard_offset;
  dst += offset_slice * op.type_size;
  SliceStore2D(dst, src, begin_m, end_m, begin_n, end_n, slice_n, shard.stride_n, pad_size, op.type_size);
  OVER_WRITE_CHECK(pc, head, end_m * shard.stride_n + end_n + shard_offset);
}

template <typename T>
__aicore_inline__ void RemovePad(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vRemovePad op;
  vRemovePad::Decode(pc, head, op);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  set_vector_mask(0, op.iter_num);
  vreducev2(xd, xn, xn, op.repeat, 1, 7, op.rs, 0);
}

__aicore_inline__ void Load(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vLoad op;
  vLoad::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);
  if (op.round_rank > 0) {
    tile_idx = RoundUpTileIdx<kRoundCacheLoad>(tile, tile_idx, op.round_rank, pc + vLoad::ROUND_OFFSET);
    if (tile_idx == INVALID_INT) {
      return;
    }
  }
  __gm__ uint8_t* src = (__gm__ uint8_t*)op.from + op.tile_stride * tile_idx;
  if (IsLastTile(tile)) {
    if (op.body_iter == 1) {
      op.iter_size = op.tail_iter;
    } else {
      op.body_iter = op.tail_iter;
    }
  }
  __ubuf__ uint8_t* dst = (__ubuf__ uint8_t*)(op.xn);
  copy_gm_to_ubuf_align_b8(dst, src, 0, op.body_iter, op.iter_size, 0, 0, 0, op.pad_size >> 5);
  OVER_WRITE_CHECK(pc, head, op.tile_stride * tile_idx + op.body_iter * op.iter_size);
}

__aicore_inline__ void MultiLoad(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vMultiLoad op;
  vMultiLoad::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);

  __gm__ uint8_t *src = (__gm__ uint8_t *)op.from + op.tile_stride * tile_idx;
  __ubuf__ uint8_t *dst = (__ubuf__ uint8_t *)(op.xn);
  uint64_t truck_num = IsLastTile(tile) ? op.tail_iter : op.body_iter;

  uint64_t offset_idx = vBlockIdx() * 2 + (op.pingpong & 0x1ul);
  __gm__ uint64_t *flag_mem = (__gm__ uint64_t *)((__gm__ uint8_t *)op.flag_mem + offset_idx * CACHE_LINE_SIZE);
  __gm__ uint8_t *gm = (__gm__ uint8_t *)op.peer_mem + op.tile_stride2 * offset_idx * (op.multi_size - 1);
  uint64_t len_burst = (op.tile_stride + 31) >> 5;
  vMultiLoad::PingPongSwitch(pc);

  for (uint64_t i = 1; i < op.multi_size; ++i) {
    if (i > 2) {
      wait_flag(PIPE_MTE3, PIPE_MTE2, i % 2 == 1 ? EVENT_ID0 : EVENT_ID1);
    }
    auto rank_id = (op.rank_id + i) % op.multi_size;
    auto xbuf_addr =
      dst + ((i + op.multi_size) % 2) * op.xbuf_size;  // make sure xbuf_ can be used to store this rank's data
    copy_gm_to_ubuf_align_b8(xbuf_addr, src + op.gap * rank_id, 0, truck_num, op.iter_size, 0, 0, 0, op.pad_size >> 5);
    set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    copy_ubuf_to_gm(gm, xbuf_addr, 0, 1, len_burst, 0, 0);
    // TODO: MTE3 backsync MTE2(maybe peerload is too long)
    if (op.multi_size > 2 && i < op.multi_size - 1) {
      set_flag(PIPE_MTE3, PIPE_MTE2, i % 2 == 1 ? EVENT_ID0 : EVENT_ID1);
    }
    gm += op.tile_stride2;
  }
  if (op.multi_size > 2) {
    wait_flag(PIPE_MTE3, PIPE_MTE2, op.multi_size % 2 == 1 ? EVENT_ID0 : EVENT_ID1);
  }
  copy_gm_to_ubuf_align_b8(dst, src + op.gap * op.rank_id, 0, truck_num, op.iter_size, 0, 0, 0, op.pad_size >> 5);
  // soft sync
  set_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
  wait_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
  uint64_t sync_flag = (op.unique_id << 32) | (tile_idx + 1);
  *flag_mem = sync_flag;
  dcci(flag_mem, 0);
}

__aicore_inline__ void PingPongLoad(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vPingPongLoad op;
  vPingPongLoad::Decode(pc, head, op);
  if (IsEndTile(tile)) {
    vPingPongLoad::PingPongSwitch(pc);
  }
  uint64_t tile_idx = TileIdx(tile);
  if (op.round_rank > 0) {
    tile_idx = RoundUpTileIdx<kRoundCacheLoad>(tile, tile_idx, op.round_rank, pc + vPingPongLoad::ROUND_OFFSET);
    if (tile_idx == INVALID_INT) {
      return;
    }
  }
  uint64_t blockgroup = vBlockGroup();
  uint64_t pingpong_offset = op.pingpong ? vGroupNum(blockgroup) + vGroupIdx(blockgroup) : vGroupIdx(blockgroup);
  __gm__ uint8_t* src = (__gm__ uint8_t*)op.from + pingpong_offset * op.pingpong_stride + op.tile_stride * tile_idx;
  __ubuf__ uint8_t* dst = (__ubuf__ uint8_t*)(op.xn);
  uint64_t truck_num = IsLastTile(tile) ? op.tail_iter : op.body_iter;
  if (op.pad_size == 0) {
    copy_gm_to_ubuf_align_b8(dst, src, 0, 1, truck_num * op.iter_size, 0, 0, 0, 0);
  } else {
    copy_gm_to_ubuf_align_b8(dst, src, 0, truck_num, op.iter_size, 0, 0, 0, op.pad_size >> 5);
  }
}

__aicore_inline__ void ViewLoad(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vViewLoad op;
  vViewLoad::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);
  uint64_t tile_offset = op.offset;
  uint64_t tile_space = 0;
  uint64_t tile_depth = op.tile_depth;
  for (; tile_depth > 0 && tile_idx > 0; --tile_depth) {
    uint64_t stride;
    vViewLoad::DecodeTile(pc[vViewLoad::VAR_OFFSET - 1 + op.loop_depth + tile_depth], tile_space, stride);
    uint64_t factor = tile_idx / tile_space;
    tile_offset += stride * factor;
    tile_idx -= factor * tile_space;
  }
  if (tile_space > 1 && tile_depth == 0 && tile_idx > 0 && !IsBeginTile(tile) && !IsSkipTile(tile)) {
    return;
  }
  __gm__ uint8_t* src = (__gm__ uint8_t*)op.from + tile_offset;
  __ubuf__ uint8_t* dst = (__ubuf__ uint8_t*)(op.xd);
  if (op.loop_depth == 0) {
    if (IsLastTile(tile)) {
      if (op.iter_num == 1) {
        op.iter_size = op.tail_size;
      } else {
        op.iter_num = op.tail_size;
      }
    }
    copy_gm_to_ubuf_align_b8(dst, src, 0, op.iter_num, op.iter_size, 0, 0, op.src_gap, op.dst_gap);
  } else if (op.loop_depth == 1) {
    uint64_t loop_size, dst_stride, src_stride;
    vViewLoad::DecodeLoop(pc[vViewLoad::VAR_OFFSET], loop_size, dst_stride, src_stride);
    if (IsLastTile(tile)) {
      loop_size = op.tail_size;
    }
    for (uint64_t i = 0; i < loop_size; ++i) {
      copy_gm_to_ubuf_align_b8(dst, src, 0, op.iter_num, op.iter_size, 0, 0, op.src_gap, op.dst_gap);
      dst += dst_stride;
      src += src_stride;
    }
  } else if (op.loop_depth == 2) {
    uint64_t loop_size0, dst_stride0, src_stride0;
    uint64_t loop_size1, dst_stride1, src_stride1;
    vViewLoad::DecodeLoop(pc[vViewLoad::VAR_OFFSET], loop_size0, dst_stride0, src_stride0);
    vViewLoad::DecodeLoop(pc[vViewLoad::VAR_OFFSET + 1], loop_size1, dst_stride1, src_stride1);
    if (IsLastTile(tile)) {
      loop_size1 = op.tail_size;
    }
    for (uint64_t i = 0; i < loop_size1; ++i) {
      for (uint64_t j = 0; j < loop_size0; ++j) {
        copy_gm_to_ubuf_align_b8(dst + i * dst_stride1 + j * dst_stride0,
                                 src + i * src_stride1 + j * src_stride0,
                                 0, op.iter_num, op.iter_size, 0, 0, op.src_gap, op.dst_gap);
      }
    }
  } else {
    uint32_t coord[6] = {0};
    uint64_t idx = 0;
    while (idx < op.loop_depth) {
      copy_gm_to_ubuf_align_b8(dst, src, 0, op.iter_num, op.iter_size, 0, 0, op.src_gap, op.dst_gap);
      for (idx = 0; idx < op.loop_depth; ++idx) {
        uint64_t loop_size, dst_stride, src_stride;
        vViewLoad::DecodeLoop(pc[vViewLoad::VAR_OFFSET + idx], loop_size, dst_stride, src_stride);
        if (idx == op.loop_depth - 1 && IsLastTile(tile)) {
          loop_size = op.tail_size;
        }
        if (coord[idx] + 1 < loop_size) {
          coord[idx] += 1;
          dst += dst_stride;
          src += src_stride;
          idx = 0;
          break;
        }
        coord[idx] = 0;
        dst -= (loop_size - 1) * dst_stride;
        src -= (loop_size - 1) * src_stride;
      }
    }
  }
}

__aicore_inline__ void InitViewLoadXPattern(__ubuf__ uint64_t *pattern, uint64_t stride_elem, uint64_t mask) {
  constexpr uint64_t bits_per_word = sizeof(uint64_t) * 8;
  pipe_barrier(PIPE_V);
  set_vector_mask(0, stride_elem);
  vector_dup((__ubuf__ uint32_t *)pattern, 0u, 1, 1, 1, 0, 0);
  set_flag(PIPE_V, PIPE_S, EVENT_ID0);
  wait_flag(PIPE_V, PIPE_S, EVENT_ID0);
  for (uint64_t bit = 0; bit < mask; bit += stride_elem) {
    uint64_t idx = bit / bits_per_word;
    uint64_t shift = bit - idx * bits_per_word;
    pattern[idx] = pattern[idx] | (1ul << shift);
  }
}

template <typename T>
__aicore_inline__ void ViewLoadXNormal(__ubuf__ T *dst, __ubuf__ T *ws, __gm__ uint8_t *src, uint64_t iter_offset,
                                       uint64_t iter_size, uint64_t iter_stride) {
  copy_gm_to_ubuf_align_b8(ws, src + iter_offset * iter_stride, 0, iter_size, sizeof(T), 0, 0,
                           iter_stride - sizeof(T), 0);
  set_flag(PIPE_MTE2, PIPE_V, EVENT_ID7);
  wait_flag(PIPE_MTE2, PIPE_V, EVENT_ID7);
  set_vector_mask(0, 1);
  vreducev2(dst + iter_offset, ws, ws, iter_size, 1, 7, 1, 0);
}

template <typename T>
__aicore_inline__ void ViewLoadXFixedGather(__ubuf__ T *dst, __ubuf__ T *ws, __gm__ uint8_t *src,
                                            uint64_t iter_offset, uint64_t iter_size, uint64_t iter_stride,
                                            uint64_t stride_elem, uint8_t pattern_mode) {
  copy_gm_to_ubuf_align_b8(ws, src + iter_offset * iter_stride, 0, 1, sizeof(T) * iter_size * stride_elem, 0, 0,
                           0, 0);
  set_flag(PIPE_MTE2, PIPE_V, EVENT_ID7);
  wait_flag(PIPE_MTE2, PIPE_V, EVENT_ID7);
  set_vector_mask(0, iter_size * stride_elem);
  vreducev2(dst + iter_offset, ws, ws, 1, 1, pattern_mode, 0, 0);
}

template <typename T>
__aicore_inline__ void ViewLoadXCustomGather(__ubuf__ T *dst, __ubuf__ T *ws, __gm__ uint8_t *src,
                                             uint64_t iter_offset, uint64_t iter_size, uint64_t iter_stride,
                                             uint64_t stride_elem) {
  copy_gm_to_ubuf_align_b8(ws, src + iter_offset * iter_stride, 0, 1, sizeof(T) * iter_size * stride_elem, 0, 0,
                           0, 0);
  set_flag(PIPE_MTE2, PIPE_V, EVENT_ID7);
  wait_flag(PIPE_MTE2, PIPE_V, EVENT_ID7);
  uint64_t repeat = iter_size / 32;
  uint64_t tail = (iter_size - repeat * 32) * stride_elem;
  __ubuf__ T *pattern = (__ubuf__ T *)WORKSPACE;
  if (repeat) {
    set_vector_mask(0, 32 * stride_elem);
    vreducev2(dst + iter_offset, ws, pattern, repeat, 1, 0, stride_elem * sizeof(T), 0);
  }
  if (tail) {
    set_vector_mask(0, tail);
    vreducev2(dst + iter_offset + repeat * 32, ws + repeat * 32 * stride_elem, pattern, 1, 1, 0, 0, 0);
  }
}

__aicore_inline__ void ViewLoadX(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vViewLoadX op;
  vViewLoadX::Decode(pc, head, op);
  if (op.loop_depth == 0 && IsLastTile(tile)) {
    op.iter_size = op.tail_size;
  }
  uint64_t tile_idx = TileIdx(tile);
  uint64_t tile_offset = op.offset;
  uint64_t tile_space = 0;
  uint64_t tile_depth = op.tile_depth;
  for (; tile_depth > 0 && tile_idx > 0; --tile_depth) {
    uint64_t stride;
    vViewLoad::DecodeTile(pc[vViewLoadX::VAR_OFFSET - 1 + op.loop_depth + tile_depth], tile_space, stride);
    uint64_t factor = tile_idx / tile_space;
    tile_offset += stride * factor;
    tile_idx -= factor * tile_space;
  }
  if (tile_space > 1 && tile_depth == 0 && tile_idx > 0 && !IsBeginTile(tile) && !IsSkipTile(tile)) {
    return;
  }
  __gm__ uint8_t *src = (__gm__ uint8_t *)(op.from + tile_offset);
  __ubuf__ uint8_t *dst = (__ubuf__ uint8_t *)(op.xd);
  uint32_t coord[6] = {0};
  uint64_t idx = 0;
  bool pingpong = false;
  set_flag(PIPE_V, PIPE_MTE2, EVENT_ID7);
  uint64_t item_stride = op.iter_stride / op.type_size;
  constexpr uint64_t custom_pattern_mask = (1ul << 3) | (1ul << 5) | (1ul << 6) | (1ul << 7);
  bool custom_gather = item_stride < 8 && ((1ul << item_stride) & custom_pattern_mask);
  if (custom_gather) {
    InitViewLoadXPattern((__ubuf__ uint64_t *)WORKSPACE, item_stride, 32 * item_stride);
    op.ws_size -= UB_WORKSPACE_SIZE / 32;
  }
  do {
    if (op.iter_stride > 0) {
      for (uint64_t iter_offset = 0; iter_offset < op.iter_size; iter_offset += op.ws_size) {
        __ubuf__ uint8_t *ws;
        if (pingpong) {
          pingpong = false;
          set_flag(PIPE_V, PIPE_MTE2, EVENT_ID7);
          wait_flag(PIPE_V, PIPE_MTE2, EVENT_ID6);
          ws = (__ubuf__ uint8_t *)(op.ws);
        } else {
          pingpong = true;
          set_flag(PIPE_V, PIPE_MTE2, EVENT_ID6);
          wait_flag(PIPE_V, PIPE_MTE2, EVENT_ID7);
          ws = (__ubuf__ uint8_t *)(op.ws + op.ws_size * 32);
        }
        uint64_t iter_size = op.iter_size - iter_offset > op.ws_size ? op.ws_size : op.iter_size - iter_offset;
        if (op.type_size == 2) {
          if (custom_gather) {
            ViewLoadXCustomGather((__ubuf__ uint16_t *)dst, (__ubuf__ uint16_t *)ws, src, iter_offset, iter_size,
                                  op.iter_stride, item_stride);
          } else if (item_stride == 2 || item_stride == 4) {
            uint8_t pattern_mode = item_stride == 2 ? 1 : 3;
            ViewLoadXFixedGather((__ubuf__ uint16_t *)dst, (__ubuf__ uint16_t *)ws, src, iter_offset, iter_size,
                                 op.iter_stride, item_stride, pattern_mode);
          } else {
            ViewLoadXNormal((__ubuf__ uint16_t *)dst, (__ubuf__ uint16_t *)ws, src, iter_offset, iter_size,
                           op.iter_stride);
          }
        } else {
          if (custom_gather) {
            ViewLoadXCustomGather((__ubuf__ uint32_t *)dst, (__ubuf__ uint32_t *)ws, src, iter_offset, iter_size,
                                  op.iter_stride, item_stride);
          } else if (item_stride == 2 || item_stride == 4) {
            uint8_t pattern_mode = item_stride == 2 ? 1 : 3;
            ViewLoadXFixedGather((__ubuf__ uint32_t *)dst, (__ubuf__ uint32_t *)ws, src, iter_offset, iter_size,
                                 op.iter_stride, item_stride, pattern_mode);
          } else {
            ViewLoadXNormal((__ubuf__ uint32_t *)dst, (__ubuf__ uint32_t *)ws, src, iter_offset, iter_size,
                           op.iter_stride);
          }
        }
      }
    } else {
      set_vector_mask(0, op.iter_size);
      if (op.type_size == 2) {
        vector_dup((__ubuf__ uint16_t *)dst, *(__gm__ uint16_t *)src, 1, 1, 1, 8, 8);
      } else {
        vector_dup((__ubuf__ uint32_t *)dst, *(__gm__ uint32_t *)src, 1, 1, 1, 8, 8);
      }
    }
    for (idx = 0; idx < op.loop_depth; ++idx) {
      uint64_t loop_size, dst_stride, src_stride;
      vViewLoad::DecodeLoop(pc[vViewLoadX::VAR_OFFSET + idx], loop_size, dst_stride, src_stride);
      if (idx == op.loop_depth - 1 && IsLastTile(tile)) {
        loop_size = op.tail_size;
      }
      if (coord[idx] + 1 < loop_size) {
        coord[idx] += 1;
        dst += dst_stride;
        src += src_stride;
        idx = 0;
        break;
      }
      coord[idx] = 0;
      dst -= (loop_size - 1) * dst_stride;
      src -= (loop_size - 1) * src_stride;
    }
  } while (idx < op.loop_depth);
  wait_flag(PIPE_V, PIPE_MTE2, pingpong ? EVENT_ID6 : EVENT_ID7);
  pipe_barrier(PIPE_V);
}

__aicore_inline__ void ViewLoadT(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vViewLoadT op;
  vViewLoadT::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);
  uint64_t tile_offset = op.offset;
  uint64_t tile_space = 0;
  uint64_t tile_depth = op.tile_depth;
  for (; tile_depth > 0 && tile_idx > 0; --tile_depth) {
    uint64_t stride;
    vViewLoad::DecodeTile(pc[vViewLoadT::VAR_OFFSET - 1 + op.loop_depth + tile_depth], tile_space, stride);
    uint64_t factor = tile_idx / tile_space;
    tile_offset += stride * factor;
    tile_idx -= factor * tile_space;
  }
  if (tile_space > 1 && tile_depth == 0 && tile_idx > 0 && !IsBeginTile(tile) && !IsSkipTile(tile)) {
    return;
  }
  if (op.loop_depth == 0 && IsLastTile(tile)) {
    op.iter_size = op.tail_size;
  }
  __gm__ uint8_t *src = (__gm__ uint8_t *)(op.from + tile_offset);
  __ubuf__ uint8_t *dst = (__ubuf__ uint8_t *)(op.xd);
  uint64_t ping_ws = op.ws;
  uint64_t pong_ws = op.ws + op.ws_size * 512;
  uint64_t conv_ws = pong_ws + op.ws_size * 512;
  uint64_t ping_va[16];
  uint64_t pong_va[16];
  uint64_t conv_va[16];
  for (uint64_t i = 0; i < 16; ++i) {
    ping_va[i] = ping_ws + op.ws_size * 32 * i;
    pong_va[i] = pong_ws + op.ws_size * 32 * i;
  }
  if (op.item_size == 2) {
    for (uint64_t i = 0; i < 16; ++i) {
      conv_va[i] = conv_ws + 32 * i;
    }
  } else {
    for (uint64_t i = 0; i < 8; ++i) {
      conv_va[i * 2] = conv_ws + 64 * i;
      conv_va[i * 2 + 1] = conv_ws + 64 * i + 32;
    }
  }
  set_flag(PIPE_V, PIPE_MTE2, EVENT_ID6);
  set_flag(PIPE_V, PIPE_MTE2, EVENT_ID7);
  set_va_reg_sb(VA2, ping_va);
  set_va_reg_sb(VA3, &ping_va[8]);
  set_va_reg_sb(VA4, pong_va);
  set_va_reg_sb(VA5, &pong_va[8]);
  set_va_reg_sb(VA0, conv_va);
  set_va_reg_sb(VA1, &conv_va[8]);
  uint32_t coord[6] = {0};
  uint64_t idx = op.loop_depth;
  bool pingpong = false;
  do {
    for (uint64_t iter_offset = 0; iter_offset < op.iter_size; iter_offset += op.ws_size) {
      uint64_t iter_size = op.iter_size - iter_offset > op.ws_size ? op.ws_size : op.iter_size - iter_offset;
      uint64_t conv_stride = iter_size > 1 ? 1 : 0;  // repeat 1 is from VA[n] + stride specially
      uint64_t conv_dst_stride = iter_size > 1 ? 16 : 0;
      __gm__ uint8_t *iter_src = src + iter_offset * op.iter_stride;
      if (pingpong) {
        pingpong = false;
        wait_flag(PIPE_V, PIPE_MTE2, EVENT_ID6);
        if (op.h_fractal * op.item_size == op.iter_stride) {
          copy_gm_to_ubuf_align_b8((__ubuf__ void *)ping_ws, iter_src, 0, op.w_fractal,
                                   op.h_fractal * op.item_size * iter_size, 0, 0,
                                   op.w_gap - op.iter_stride * (iter_size - 1), op.ws_size - iter_size);
        } else {
          for (uint64_t i = 0; i < iter_size; ++i) {
            copy_gm_to_ubuf_align_b8((__ubuf__ void *)(ping_ws + 32 * i), iter_src, 0, op.w_fractal,
                                     op.h_fractal * op.item_size, 0, 0, op.w_gap, op.ws_size - 1);
            iter_src += op.iter_stride;
          }
        }
        set_flag(PIPE_MTE2, PIPE_V, EVENT_ID7);
        wait_flag(PIPE_MTE2, PIPE_V, EVENT_ID7);
        if (op.item_size == 2) {
          scatter_vnchwconv_b16(VA0, VA2, iter_size, conv_dst_stride, conv_stride);
        } else {
          scatter_vnchwconv_b32(VA0, VA2, iter_size, conv_dst_stride, conv_stride);
        }
        set_flag(PIPE_V, PIPE_MTE2, EVENT_ID6);
      } else {
        pingpong = true;
        wait_flag(PIPE_V, PIPE_MTE2, EVENT_ID7);
        if (op.h_fractal * op.item_size == op.iter_stride) {
          copy_gm_to_ubuf_align_b8((__ubuf__ void *)pong_ws, iter_src, 0, op.w_fractal,
                                   op.h_fractal * op.item_size * iter_size, 0, 0,
                                   op.w_gap - op.iter_stride * (iter_size - 1), op.ws_size - iter_size);
        } else {
          for (uint64_t i = 0; i < iter_size; ++i) {
            copy_gm_to_ubuf_align_b8((__ubuf__ void *)(pong_ws + 32 * i), iter_src, 0, op.w_fractal,
                                     op.h_fractal * op.item_size, 0, 0, op.w_gap, op.ws_size - 1);
            iter_src += op.iter_stride;
          }
        }
        set_flag(PIPE_MTE2, PIPE_V, EVENT_ID7);
        wait_flag(PIPE_MTE2, PIPE_V, EVENT_ID7);
        if (op.item_size == 2) {
          scatter_vnchwconv_b16(VA0, VA4, iter_size, conv_dst_stride, conv_stride);
        } else {
          scatter_vnchwconv_b32(VA0, VA4, iter_size, conv_dst_stride, conv_stride);
        }
        set_flag(PIPE_V, PIPE_MTE2, EVENT_ID7);
      }
      pipe_barrier(PIPE_V);
      if (op.item_size == 2) {
        if (op.h_fractal == 16) {
          copy_ubuf_to_ubuf(dst + iter_offset * 512, (__ubuf__ void *)conv_ws, 0, 1, iter_size * 16, 0, 0);
        } else {
          copy_ubuf_to_ubuf(dst + iter_offset * op.h_fractal * 32, (__ubuf__ void *)conv_ws, 0, iter_size, op.h_fractal,
                            16 - op.h_fractal, 0);
        }
      } else if (op.w_fractal > 8) {
        if (op.h_fractal == 8) {
          copy_ubuf_to_ubuf(dst + iter_offset * 512, (__ubuf__ void *)conv_ws, 0, 1, iter_size * 16, 0, 0);
        } else {
          copy_ubuf_to_ubuf(dst + iter_offset * op.h_fractal * 64, (__ubuf__ void *)conv_ws, 0, iter_size,
                            op.h_fractal * 2, 16 - op.h_fractal * 2, 0);
        }
      } else {
        set_vector_mask(0, 8 * op.h_fractal);
        vcopy((__ubuf__ uint32_t *)(dst + iter_offset * op.h_fractal * 32), (__ubuf__ uint32_t *)conv_ws, iter_size, 1,
              2, op.h_fractal, 16);
      }
      pipe_barrier(PIPE_V);
    }
    for (idx = 0; idx < op.loop_depth; ++idx) {
      uint64_t loop_size, dst_stride, src_stride;
      vViewLoad::DecodeLoop(pc[vViewLoadT::VAR_OFFSET + idx], loop_size, dst_stride, src_stride);
      if (idx == op.loop_depth - 1 && IsLastTile(tile)) {
        loop_size = op.tail_size;
      }
      if (coord[idx] + 1 < loop_size) {
        coord[idx] += 1;
        dst += dst_stride;
        src += src_stride;
        break;
      }
      coord[idx] = 0;
      dst -= (loop_size - 1) * dst_stride;
      src -= (loop_size - 1) * src_stride;
    }
  } while (idx < op.loop_depth);
  wait_flag(PIPE_V, PIPE_MTE2, EVENT_ID6);
  wait_flag(PIPE_V, PIPE_MTE2, EVENT_ID7);
}

__aicore_inline__ void ViewStore(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vViewStore op;
  vViewStore::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);
  uint64_t tile_offset = op.offset;
  for (uint64_t i = op.tile_depth; i > 0 && tile_idx > 0; --i) {
    uint64_t space, stride;
    vViewStore::DecodeTile(pc[vViewStore::VAR_OFFSET - 1 + op.loop_depth + i], space, stride);
    uint64_t factor = tile_idx / space;
    tile_offset += stride * factor;
    tile_idx -= factor * space;
  }
  __ubuf__ uint8_t* src = (__ubuf__ uint8_t*)(op.xn);
  __gm__ uint8_t* dst = (__gm__ uint8_t*)op.to + tile_offset;
  if (op.loop_depth == 0) {
    if (IsLastTile(tile)) {
      if (op.iter_num == 1) {
        op.iter_size = op.tail_size;
      } else {
        op.iter_num = op.tail_size;
      }
    }
    copy_ubuf_to_gm_align_b8(dst, src, 0, op.iter_num, op.iter_size, 0, 0, op.src_gap, op.dst_gap);
  } else if (op.loop_depth == 1) {
    uint64_t loop_size, dst_stride, src_stride;
    vViewStore::DecodeLoop(pc[vViewStore::VAR_OFFSET], loop_size, dst_stride, src_stride);
    if (IsLastTile(tile)) {
      loop_size = op.tail_size;
    }
    for (uint64_t i = 0; i < loop_size; ++i) {
      copy_ubuf_to_gm_align_b8(dst + i * dst_stride, src + i * src_stride, 0, op.iter_num, op.iter_size, 0, 0,
                               op.src_gap, op.dst_gap);
    }
  } else if (op.loop_depth == 2) {
    uint64_t loop_size0, dst_stride0, src_stride0;
    uint64_t loop_size1, dst_stride1, src_stride1;
    vViewStore::DecodeLoop(pc[vViewStore::VAR_OFFSET], loop_size0, dst_stride0, src_stride0);
    vViewStore::DecodeLoop(pc[vViewStore::VAR_OFFSET + 1], loop_size1, dst_stride1, src_stride1);
    if (IsLastTile(tile)) {
      loop_size1 = op.tail_size;
    }
    for (uint64_t i = 0; i < loop_size1; ++i) {
      for (uint64_t j = 0; j < loop_size0; ++j) {
        copy_ubuf_to_gm_align_b8(dst + i * dst_stride1 + j * dst_stride0,
                                 src + i * src_stride1 + j * src_stride0,
                                 0, op.iter_num, op.iter_size, 0, 0, op.src_gap, op.dst_gap);
      }
    }
  } else {
    uint32_t coord[6] = {0};
    uint64_t idx = 0;
    while (idx < op.loop_depth) {
      copy_ubuf_to_gm_align_b8(dst, src, 0, op.iter_num, op.iter_size, 0, 0, op.src_gap, op.dst_gap);
      for (idx = 0; idx < op.loop_depth; ++idx) {
        uint64_t loop_size, dst_stride, src_stride;
        vViewStore::DecodeLoop(pc[vViewStore::VAR_OFFSET + idx], loop_size, dst_stride, src_stride);
        if (idx == op.loop_depth - 1 && IsLastTile(tile)) {
          loop_size = op.tail_size;
        }
        if (coord[idx] + 1 < loop_size) {
          coord[idx] += 1;
          dst += dst_stride;
          src += src_stride;
          idx = 0;
          break;
        }
        coord[idx] = 0;
        dst -= (loop_size - 1) * dst_stride;
        src -= (loop_size - 1) * src_stride;
      }
    }
  }
}

__aicore_inline__ void ViewStoreX(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vViewStoreX op;
  vViewStoreX::Decode(pc, head, op);
  if (op.loop_depth == 0 && IsLastTile(tile)) {
    op.iter_size = op.tail_size;
  }
  uint64_t tile_idx = TileIdx(tile);
  uint64_t tile_offset = op.offset;
  for (uint64_t i = op.tile_depth; i > 0 && tile_idx > 0; --i) {
    uint64_t space, stride;
    vViewStore::DecodeTile(pc[vViewStore::VAR_OFFSET - 1 + op.loop_depth + i], space, stride);
    uint64_t factor = tile_idx / space;
    tile_offset += stride * factor;
    tile_idx -= factor * space;
  }
  __gm__ uint8_t *dst = (__gm__ uint8_t *)(op.to + tile_offset);
  __ubuf__ uint8_t *src = (__ubuf__ uint8_t *)(op.xn);
  uint32_t coord[6] = {0};
  uint64_t idx = 0;
  uint64_t pingpong = 0;
  set_flag(PIPE_MTE3, PIPE_V, EVENT_ID6);
  set_flag(PIPE_MTE3, PIPE_V, EVENT_ID7);
  pipe_barrier(PIPE_V);
  do {
    for (uint64_t iter_offset = 0; iter_offset < op.iter_size; iter_offset += op.ws_size) {
      event_t event = event_t(EVENT_ID6 ^ pingpong);
      wait_flag(PIPE_MTE3, PIPE_V, event);
      __ubuf__ uint8_t *ws = (__ubuf__ uint8_t *)(op.ws + pingpong * op.ws_size * 32);
      uint64_t chunk_size = op.iter_size - iter_offset > op.ws_size ? op.ws_size : op.iter_size - iter_offset;
      uint64_t repeat = (chunk_size + 7) >> 3;
      __ubuf__ uint8_t *xd = ws;
      __ubuf__ uint8_t *xn = src + iter_offset * op.type_size;
      for (; repeat > 254; repeat -= 254) {
        if (op.type_size == 2) {
          vbrcb((__ubuf__ uint16_t *)xd, (__ubuf__ uint16_t *)xn, 1, VBRCB_NUM, 254);
        } else {
          vbrcb((__ubuf__ uint32_t *)xd, (__ubuf__ uint32_t *)xn, 1, VBRCB_NUM, 254);
        }
        xd += 254 * VBRCB_NUM * 32;
        xn += 254 * VBRCB_NUM * op.type_size;
      }
      if (op.type_size == 2) {
        vbrcb((__ubuf__ uint16_t *)xd, (__ubuf__ uint16_t *)xn, 1, VBRCB_NUM, repeat);
      } else {
        vbrcb((__ubuf__ uint32_t *)xd, (__ubuf__ uint32_t *)xn, 1, VBRCB_NUM, repeat);
      }
      set_flag(PIPE_V, PIPE_MTE3, event);
      wait_flag(PIPE_V, PIPE_MTE3, event);
      copy_ubuf_to_gm_align_b8(dst + iter_offset * op.iter_stride, (__ubuf__ uint8_t *)ws, 0, chunk_size,
                                op.type_size, 0, 0, 0, op.iter_stride - op.type_size);
      set_flag(PIPE_MTE3, PIPE_V, event);
      pingpong ^= 1;
    }
    for (idx = 0; idx < op.loop_depth; ++idx) {
      uint64_t loop_size, dst_stride, src_stride;
      vViewStore::DecodeLoop(pc[vViewStoreX::VAR_OFFSET + idx], loop_size, dst_stride, src_stride);
      if (idx == op.loop_depth - 1 && IsLastTile(tile)) {
        loop_size = op.tail_size;
      }
      if (coord[idx] + 1 < loop_size) {
        coord[idx] += 1;
        dst += dst_stride;
        src += src_stride;
        idx = 0;
        break;
      }
      coord[idx] = 0;
      dst -= (loop_size - 1) * dst_stride;
      src -= (loop_size - 1) * src_stride;
    }
  } while (idx < op.loop_depth);
  wait_flag(PIPE_MTE3, PIPE_V, EVENT_ID6);
  wait_flag(PIPE_MTE3, PIPE_V, EVENT_ID7);
  pipe_barrier(PIPE_V);
}

__aicore_inline__ void Store(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vStore op;
  vStore::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);
  if (op.round_rank > 0) {
    tile_idx = RoundUpTileIdx<kRoundCacheStore>(tile, tile_idx, op.round_rank, pc + vStore::ROUND_OFFSET);
    if (tile_idx == INVALID_INT) {
      return;
    }
  }
  uint64_t iter_num = op.iter_num;
  uint64_t iter_size = op.iter_size;
  __gm__ uint8_t *dst = (__gm__ uint8_t*)op.to + op.tile_stride * tile_idx;
  if (IsLastTile(tile)) {
    if (iter_num == 1) {
      iter_size = op.iter_tail;
    } else {
      iter_num = op.iter_tail;
    }
  }
  copy_ubuf_to_gm_align_b8(dst, (__ubuf__ uint8_t *)(op.xn), 0, iter_num, iter_size, 0, 0, op.pad_size >> 5, 0);
  OVER_WRITE_CHECK(pc, head, op.tile_stride * tile_idx + iter_num * iter_size);
}

__aicore_inline__ void CondStore(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vStoreCond op;
  if (vStoreCond::Decode<true>(pc, head, op)) {
    uint64_t tile_idx = TileIdx(tile);
    if (op.round_rank > 0) {
      tile_idx = RoundUpTileIdx<kRoundCacheNone>(tile, tile_idx, op.round_rank, pc + vStoreCond::ROUND_OFFSET);
    }
    __gm__ uint8_t *dst = (__gm__ uint8_t*)op.to + op.tile_stride * tile_idx;
    if (op.pad_size == 0) {
      op.iter_offset = op.iter_offset << op.dtype_shift;
      op.iter_range = op.iter_range << op.dtype_shift;
      copy_ubuf_to_gm_align_b8(dst + op.iter_offset, (__ubuf__ uint8_t*)(op.xn + op.iter_offset), 0, 1, op.iter_range, 0, 0, 0, 0);
      OVER_WRITE_CHECK(pc, head, op.tile_stride * tile_idx + op.iter_offset + op.iter_range);
    } else {
      uint64_t src_offset = op.iter_offset * (op.iter_size + op.pad_size);
      uint64_t dst_offset = op.iter_offset * op.iter_size;
      copy_ubuf_to_gm_align_b8(dst + dst_offset, (__ubuf__ uint8_t*)(op.xn + src_offset), 0, op.iter_range, op.iter_size, 0, 0, op.pad_size >> 5, 0);
      OVER_WRITE_CHECK(pc, head, op.tile_stride * tile_idx + dst_offset + op.iter_range * op.iter_size);
    }
  }
}

__aicore_inline__ void StoreAtomic(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vStoreAtomic op;
  vStoreAtomic::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);
  if (op.cum_flag) {
    tile_idx = RoundUpTileIdx<kRoundCacheStoreAtomic>(tile, tile_idx, op.round_rank, pc + vStoreAtomic::ROUND_OFFSET);
    if (tile_idx == INVALID_INT) {
      return;
    }
  } else {
    tile_idx = RoundUpTileIdx<kRoundCacheNone>(tile, tile_idx, op.round_rank, pc + vStoreAtomic::ROUND_OFFSET);
  }
  if (IsLastTile(tile)) {
    op.iter_num = op.iter_tail;
  }
  __gm__ uint8_t* gm = (__gm__ uint8_t*)op.to + op.tile_stride * tile_idx;
  if (likely(op.red_op == V_RED_SUM)) {
    set_atomic_f32();
    set_atomic_add();
  } else {
    if (op.atmoic_type == V_ATOMIC_FP32) {
      set_atomic_f32();
    } else {
      set_atomic_f16();
    }
    if (op.red_op == V_RED_MAX) {
      set_atomic_max();
    } else {
      set_atomic_min();
    }
  }
  if (op.pad_size == 0) {
    copy_ubuf_to_gm_align_b16(gm, (__ubuf__ void *)(op.xn), 0, 1, op.iter_num * op.iter_size, 0, 0, 0, 0);
  } else {
    copy_ubuf_to_gm_align_b16(gm, (__ubuf__ void *)(op.xn), 0, op.iter_num, op.iter_size, 0, 0, op.pad_size >> 5, 0);
  }
  set_atomic_none();
  OVER_WRITE_CHECK(pc, head, op.tile_stride * tile_idx + op.iter_num * op.iter_size);
}

/******************************************************
 * Collective Communication Operations
*******************************************************/
__aicore_inline__ void WaitBuffFlag(uint64_t flag, __gm__ uint64_t *buff){
  while (1) {
    if (*buff == flag) {
      break;
    }
    dcci(buff, 0);
    // TODO: do we need this?
    for (int64_t i = 0; i < 10; ++i) {
      __asm__ __volatile__("nop");
    }
  }
}

__aicore_inline__ void StoreAG(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vStoreAG op;

  vStoreAG::Decode(pc, head, op);

  uint64_t tile_idx = TileIdx(tile);
  uint64_t rank_size = op.rank_size;
  if (IsLastTile(tile)) {
    if (op.iter_num == 1) {
      for (size_t i = 0; i < rank_size; i++) {
        __ubuf__ void* ub = (__ubuf__ void*)(op.xn + i * op.xbuf_size);
        __gm__ void* gm = (__gm__ uint8_t*)op.to + i * op.shard_stride + op.tile_stride * tile_idx;
        copy_ubuf_to_gm_align_b8(gm, ub, 0, 1, op.iter_tail, 0, 0, 0, 0);
      }
      OVER_WRITE_CHECK(pc, head, (rank_size - 1) * op.shard_stride + op.tile_stride * tile_idx + op.iter_tail);
      return;
    }
    op.iter_num = op.iter_tail;
  }

  for (size_t i = 0; i < rank_size; i++) {
    __ubuf__ void* ub = (__ubuf__ void*)(op.xn + i * op.xbuf_size);
    __gm__ void* gm = (__gm__ uint8_t*)op.to + i * op.shard_stride + op.tile_stride * tile_idx;
    copy_ubuf_to_gm_align_b8(gm, ub, 0, op.iter_num, op.iter_size, 0, 0, op.pad_size >> 5, 0);
  }
  OVER_WRITE_CHECK(pc, head, (rank_size - 1) * op.shard_stride + op.tile_stride * tile_idx + op.iter_num * op.iter_size);
}

__aicore_inline__ void StoreRS(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vStoreRS op;
  vStoreRS::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);
  tile_idx = RoundUpTileIdxRS(tile_idx, op.round_rank, op.rank_id, pc + vStoreRS::ROUND_OFFSET);
  if (tile_idx == INVALID_INT) return;
  if (IsLastTile(tile)) {
    // TODO: last tile may be from round
    op.iter_num = op.iter_tail;
  }
  __gm__ uint8_t *gm = (__gm__ uint8_t *)op.to + op.tile_stride * tile_idx;
  if (op.pad_size == 0) {
    copy_ubuf_to_gm_align_b32(gm, (__ubuf__ void *)(op.xn), 0, 1, op.iter_num * op.iter_size, 0, 0, 0, 0);
  } else {
    copy_ubuf_to_gm_align_b32(gm, (__ubuf__ void *)(op.xn), 0, op.iter_num, op.iter_size, 0, 0, op.pad_size >> 5, 0);
  }
  OVER_WRITE_CHECK(pc, head, op.tile_stride * tile_idx + op.iter_num * op.iter_size);
}

template <bool MIX>
__aicore_inline__ void PeerLoad(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  pipe_barrier(PIPE_ALL);
  vPeerDMA op;
  vPeerDMA::Decode(pc, head, op);
  if (op.lenburst == 0) {
    return;
  }
  uint32_t tile_idx;
  if constexpr (MIX) {
    // pingpong2(2) << 16 | tile_idx(16)
    tile_idx = ((op.pingpong) << 16) | (TileIdx(tile) & 0xfffful);
  } else {
    tile_idx = TileIdx(tile);
  }
  if (op.wait_flag) {
    wait_flag(PIPE_V, PIPE_MTE2, op.event_id);
  }
  if (op.set_flag) {
    set_flag(PIPE_V, PIPE_MTE2, op.event_id);
  }
  uint64_t offset_idx = vBlockIdx() * 2 + (op.pingpong & 0x1ul);
  vPeerDMA::PingPongSwitch(pc);
  // soft sync
  __gm__ uint64_t *flag_mem = (__gm__ uint64_t *)((__gm__ uint8_t *)op.flag_mem + offset_idx * CACHE_LINE_SIZE);
  uint64_t sync_flag = (op.unique_id << 32) | (tile_idx + 1);
  WaitBuffFlag(sync_flag, flag_mem);
  set_flag(PIPE_S, PIPE_MTE2, EVENT_ID0);
  wait_flag(PIPE_S, PIPE_MTE2, EVENT_ID0);
  if (op.round_rank) {
    if (op.comm_type == CommType::kCommReduceScatter && RoundUpTileIdxRS(tile_idx, op.round_rank, op.rank_id, pc + vPeerDMA::ROUND_OFFSET) == INVALID_INT) {
      return;
    }
    if (op.comm_type == CommType::kCommAllGather && RoundUpTileIdxAG(tile_idx, op.round_rank, op.rank_id, pc + vPeerDMA::ROUND_OFFSET) == INVALID_INT) {
      return;
    }
  }
  uint64_t len_burst = IsLastTile(tile) ? op.tail_lenburst : op.lenburst;
  __gm__ void *gm = (__gm__ uint8_t *)op.peer_mem + op.tile_stride * offset_idx;
  copy_gm_to_ubuf_align_b8((__ubuf__ void *)op.xn, gm, 0, 1, len_burst << 5, 0, 0, 0, 0);
}

template <bool MIX>
__aicore_inline__ void PeerStore(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vPeerDMA op;
  vPeerDMA::Decode(pc, head, op);
  if (op.lenburst == 0) {
    return;
  }
  uint32_t tile_idx;
  if constexpr (MIX) {
    // pingpong2(2) << 16 | tile_idx(16)
    tile_idx = ((op.pingpong) << 16) | (TileIdx(tile) & 0xfffful);
  } else {
    tile_idx = TileIdx(tile);
  }
  uint64_t offset_idx = vBlockIdx() * 2  + (op.pingpong & 0x1ul);
  vPeerDMA::PingPongSwitch(pc);
  __gm__ uint64_t *flag_mem = (__gm__ uint64_t *)((__gm__ uint8_t *)op.flag_mem + offset_idx * CACHE_LINE_SIZE);
  __gm__ void *gm = (__gm__ uint8_t *)op.peer_mem + op.tile_stride * offset_idx;
  uint64_t len_burst = IsLastTile(tile) ? op.tail_lenburst : op.lenburst;
  copy_ubuf_to_gm(gm, (__ubuf__ void *)op.xn, 0, 1, len_burst, 0, 0);
  set_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
  wait_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
  uint64_t sync_flag = (op.unique_id << 32) | (tile_idx + 1);
  *flag_mem = sync_flag;
  dcci(flag_mem, 0);
}

__aicore_inline__ void PingPongPeerLoad(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vPingPongPeerLoad speer_load;
  vPingPongPeerLoad::Decode(pc, head, speer_load);
  vPingPongLoad &op = speer_load.base;
  if (IsEndTile(tile)) {
    vPingPongPeerLoad::PingPongSwitch(pc);
  }
  if(speer_load.wait_flag){
    wait_flag(PIPE_V, PIPE_MTE2, speer_load.event_id);
  }
  if(speer_load.set_flag){
    set_flag(PIPE_V, PIPE_MTE2, speer_load.event_id);
  }

  uint64_t tile_idx = TileIdx(tile);
  if (op.round_rank > 0) {
    tile_idx = RoundUpTileIdx<kRoundCacheLoad>(tile, tile_idx, op.round_rank, pc + vPingPongPeerLoad::ROUND_OFFSET);
    if (tile_idx == INVALID_INT) {
      return;
    }
  }
  uint64_t blockgroup = vBlockGroup();
  uint64_t pingpong_offset = op.pingpong ? vGroupNum(blockgroup) + vGroupIdx(blockgroup) : vGroupIdx(blockgroup);
  __gm__ uint64_t *flag_mem =
    (__gm__ uint64_t *)((__gm__ uint8_t *)op.from + PEERMEM_FLAG_OFFSET + pingpong_offset * CACHE_LINE_SIZE);

  uint32_t group_offset = vShard2D::DecodeOffset(pc + speer_load.shard_rel);
  uint64_t sync_flag = (speer_load.unique_id << 32) | (group_offset + 1);
  WaitBuffFlag(sync_flag, flag_mem);
  set_flag(PIPE_S, PIPE_MTE2, EVENT_ID0);
  wait_flag(PIPE_S, PIPE_MTE2, EVENT_ID0);
  __gm__ uint8_t *src = (__gm__ uint8_t *)op.from + speer_load.peer_mem_offset + pingpong_offset * op.pingpong_stride + op.tile_stride * tile_idx;
  __ubuf__ uint8_t *dst = (__ubuf__ uint8_t *)(op.xn);
  uint64_t truck_num = IsLastTile(tile) ? op.tail_iter : op.body_iter;
  copy_gm_to_ubuf_align_b8(dst, src, 0, truck_num, op.iter_size, 0, 0, 0, op.pad_size >> 5);

  if (IsEndTile(tile)) {
    set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    __gm__ int32_t *gm_accum =
      (__gm__ int32_t *)((__gm__ uint8_t *)(op.from) + PEERMEM_ATOMIC_OFFSET + pingpong_offset * CACHE_LINE_SIZE);
    uint64_t step_addr = (uint64_t)speer_load.step_addr & 0x1fffful;
    uint64_t align_step_addr = (step_addr >> 5) << 5;
    uint64_t align_size = step_addr - align_step_addr;
    set_atomic_f32();
    set_atomic_add();
    copy_ubuf_to_gm_align_b8((__gm__ uint8_t *)gm_accum - align_size, (__ubuf__ void *)align_step_addr, 0, 1,
                             align_size + sizeof(int32_t), 0, 0, 0, 0);
    set_atomic_none();
  }
}

extern "C" __global__ __aicore__ void dvm_mix_aiv(uint64_t ffts_addr, uint64_t entry) {
  __gm__ uint8_t * body_addr = (__gm__ uint8_t*)(get_para_base()) + sizeof(ffts_addr) + sizeof(entry);
  if (entry & V_ENTRY_FLAG_EXTERN_CODE) {
    __gm__ uint64_t *ext_addr = reinterpret_cast<__gm__ uint64_t*>(ffts_addr);
    ffts_addr = *ext_addr;
    body_addr = reinterpret_cast<__gm__ uint8_t*>(ext_addr + 2);
  }
  uint64_t blockidx = get_subblockdim() * block_idx + get_subblockid();
  uint64_t blocknum = get_subblockdim() * block_num;
  uint64_t ktype = entry & V_ENTRY_MASK_TYPE;
  if (ktype == V_ENTRY_TYPE_P) {
    uint64_t lookup_offset = (entry >> V_ENTRY_P_AIV_LKUP_OFFSET) & V_ENTRY_P_LKUP_MASK;
    uint8_t prog_offset = *(body_addr + lookup_offset + blockidx);
    if (prog_offset != V_ENTRY_P_LKUP_INVALID) {
      vProgEntry prog;
      vProgEntry::Decode(reinterpret_cast<bcodeptr_t>(body_addr) + prog_offset, prog);
      entry = prog.entry;
      ktype = entry & V_ENTRY_MASK_TYPE;
      blockidx -= prog.b_begin;
      blocknum = prog.b_num;
      body_addr += prog.offset;
    }
  }
  set_atomic_none();
  set_mask_count();
  uint8_t* main_addr = (uint8_t*)(VA_VMAIN_BASE);
  uint64_t tile = 0;
  uint64_t code_size = vGetBitRange(entry, V_ENTRY_CODE_SIZE_OFFSET, V_ENTRY_CODE_SIZE_BITS);
  if (ktype == V_ENTRY_TYPE_V) {
    copy_gm_to_ubuf_align_b8(reinterpret_cast<__ubuf__ void*>(PC_BASE), body_addr, 0, 1,
                             code_size * sizeof(uint64_t), 0, 0, 0, 0);
    uint64_t count = vGetBitRange(entry, V_ENTRY_V_TILE_BODY_OFFSET, V_ENTRY_V_TILE_BODY_BITS);
    tile = (blockidx * count) << V_TILE_CUR_IDX_OFFSET;
    if (blockidx == blocknum - 1) {
      count -= vGetBitRange(entry, V_ENTRY_V_TILE_TAIL_OFFSET, V_ENTRY_V_TILE_TAIL_BITS);
      tile |= 1ul << V_TILE_TAIL_FLAG_OFFSET;
    }
    tile |= count << V_TILE_COUNT_OFFSET;
    vBlockInit(blockidx, blocknum);
    pipe_barrier(PIPE_ALL);
  } else if (ktype == V_ENTRY_TYPE_VE) {
    if (entry & V_ENTRY_FLAG_CUBE_MIX) {
      body_addr += sizeof(vCubeOp);
      code_size -= sizeof(vCubeOp) / sizeof(uint64_t);
      vBlockGroupInit(blockidx >> 1, blocknum >> 1);
    }
    copy_gm_to_ubuf_align_b8(reinterpret_cast<__ubuf__ void*>(PC_BASE), body_addr, 0, 1,
                             code_size * sizeof(uint64_t), 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_S, EVENT_ID0);
    set_ffts_base_addr(ffts_addr);
    vBlockInit(blockidx, blocknum);
    uint64_t visit_id = vGetBitRange(entry, V_ENTRY_VE_VISIT_ID_OFFSET, V_ENTRY_VE_VISIT_ID_BITS);
    uint64_t visit_offset = vGetBitRange(entry, V_ENTRY_VE_VISIT_OFFSET_OFFSET, V_ENTRY_VE_VISIT_OFFSET_BITS);
    bcodeptr_t visit_code = reinterpret_cast<bcodeptr_t>(VA_BCODE_BASE_UB) + visit_offset;
    RegTable()->vm_code_base = main_addr;
    wait_flag(PIPE_MTE2, PIPE_S, EVENT_ID0);
    if (entry & V_ENTRY_FLAG_CUBE_MIX) {
      vVisitMix::UpdateCube(visit_code, body_addr - sizeof(vCubeOp));
    }
    tile = ((VisitFunc)GetFunc(visit_id, main_addr))(visit_code);
  }
  // Note: dvm_mix_aiv should be the first function in this file(inline function is not included)
  // We need that fact to calculate the right offset of dispatch functions
TILE_LOOP:
  uint64_t tile_stride = ((IsSkipTile(tile) ? PopSkipStride() : 1ul) << V_TILE_CUR_IDX_OFFSET) - (1ul << V_TILE_COUNT_OFFSET);
  while (uint64_t count = vGetBitRange(tile, V_TILE_COUNT_OFFSET, V_TILE_COUNT_BITS)) {
    if (count == 1) {
      tile |= 1ul << V_TILE_END_FLAG_OFFSET;
    }
    bcodeptr_t pc = reinterpret_cast<bcodeptr_t >(VA_BCODE_BASE_UB);
    for (uint64_t head = *pc; head != 0; head = *pc) {
      if (head & (0x1ul << V_HEAD_SIMD_FLAG_OFFSET)) {
        if (head & (0x1ul << V_HEAD_BAR_FLAG_OFFSET)) {
          pipe_barrier(PIPE_V);
        }
        if ((head & (0x1ul << V_HEAD_BACK_WAIT_OFFSET)) && !IsBeginTile(tile)) {
          event_t event = event_t((head >> V_HEAD_B_WAIT_EVENT_OFFSET) & V_HEAD_EVENT_MASK);
          wait_flag(PIPE_MTE3, PIPE_V, event);
        }
        if (head & (0x1ul << V_HEAD_WAIT_FLAG_OFFSET)) {
          event_t event = event_t((head >> V_HEAD_WAIT_EVENT_OFFSET) & V_HEAD_EVENT_MASK);
          wait_flag(PIPE_MTE2, PIPE_V, event);
        }
        ((OpFunc)(GetFunc(head >> V_HEAD_ID_OFFSET, main_addr)))(pc, head, tile);
        if (head & (0x1ul << V_HEAD_SET_FLAG_OFFSET)) {
          event_t event = event_t((head >> V_HEAD_SET_EVENT_OFFSET) & V_HEAD_EVENT_MASK);
          set_flag(PIPE_V, PIPE_MTE3, event);
        }
        if ((head & (0x1ul << V_HEAD_BACK_SET_OFFSET)) && !IsEndTile(tile)) {
          event_t event = event_t((head >> V_HEAD_B_SET_EVENT_OFFSET) & V_HEAD_EVENT_MASK);
          set_flag(PIPE_V, PIPE_MTE2, event);
        }
        pc += (head >> V_HEAD_SIZE_OFFSET) & V_HEAD_SIZE_MASK;
      } else {
        ((OpFunc)(GetFunc(head >> V_HEAD_ID_OFFSET, main_addr)))(pc, head, tile);
        pc += (head >> V_M_HEAD_SIZE_OFFSET) & V_M_HEAD_SIZE_MASK;
      }
    }
    tile |= 1ul << V_TILE_N_BEGIN_FLAG_OFFSET;
    tile += tile_stride;
  }
  if ((entry & V_ENTRY_MASK_TYPE) == V_ENTRY_TYPE_VE) {
    set_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
    wait_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
    uint64_t visit_id = vGetBitRange(entry, V_ENTRY_VE_VISIT_ID_OFFSET, V_ENTRY_VE_VISIT_ID_BITS);
    uint64_t visit_offset = vGetBitRange(entry, V_ENTRY_VE_VISIT_OFFSET_OFFSET, V_ENTRY_VE_VISIT_OFFSET_BITS);
    bcodeptr_t visit_code = reinterpret_cast<bcodeptr_t>(VA_BCODE_BASE_UB) + visit_offset;
    tile = ((VisitFunc)GetFunc(visit_id, main_addr))(visit_code);
    if (tile) {
      goto TILE_LOOP;
    }
  }
  pipe_barrier(PIPE_ALL);
}

#define DEF_DISP_SIMD(OP, func) \
  extern "C" __aicore__ void D_##OP(bcodeptr_t pc, uint64_t head, uint64_t tile) { func; } \
  DEF_DRY_FUNC(g_simd_func_offset, OP, D_##OP);

#define DEF_DISP_LOAD(OP, func)                                                               \
  extern "C" __aicore__ void D_##OP(bcodeptr_t pc, uint64_t head, uint64_t tile) {  \
    if ((head & (0x1ul << V_M_HEAD_WAIT_FLAG_OFFSET)) && !IsBeginTile(tile)) {                \
      event_t event = event_t((head >> V_M_HEAD_WAIT_EVENT_OFFSET) & V_HEAD_EVENT_MASK);      \
      wait_flag(PIPE_V, PIPE_MTE2, event);                                                    \
    }                                                                                         \
    func;                                                                                     \
    if (head & (0x1ul << V_M_HEAD_SET_FLAG_OFFSET)) {                                         \
      event_t event = event_t((head >> V_M_HEAD_SET_EVENT_OFFSET) & V_HEAD_EVENT_MASK);       \
      set_flag(PIPE_MTE2, PIPE_V, event);                                                     \
    }                                                                                         \
  }                                                                                           \
  DEF_DRY_FUNC(g_access_func_offset, OP, D_##OP);

#define DEF_DISP_STORE(OP, func)                                                              \
  extern "C" __aicore__ void D_##OP(bcodeptr_t pc, uint64_t head, uint64_t tile) {  \
    if (head & (0x1ul << V_M_HEAD_WAIT_FLAG_OFFSET)) {                                        \
      event_t event = event_t((head >> V_M_HEAD_WAIT_EVENT_OFFSET) & V_HEAD_EVENT_MASK);      \
      wait_flag(PIPE_V, PIPE_MTE3, event);                                                    \
    }                                                                                         \
    func;                                                                                     \
    if ((head & (0x1ul << V_M_HEAD_SET_FLAG_OFFSET)) && !IsEndTile(tile)) {                   \
      event_t event = event_t((head >> V_M_HEAD_SET_EVENT_OFFSET) & V_HEAD_EVENT_MASK);       \
      set_flag(PIPE_MTE3, PIPE_V, event);                                                     \
    }                                                                                         \
  }                                                                                           \
  DEF_DRY_FUNC(g_access_func_offset, OP, D_##OP);

#define DEF_DISP_VISIT(ID, func) \
  extern "C" __aicore__ uint64_t D_##ID(bcodeptr_t pc) { return func(pc); } \
  DEF_DRY_FUNC(g_visit_func_offset, ID, D_##ID);

