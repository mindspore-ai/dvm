#define __VM_ARCH__ 310
#include "vm_aiv.h"

template <typename T>
struct TypeGet;

#define DEF_TYPE_GET(stype, vtype) \
  template <>                      \
  struct TypeGet<stype> {          \
    using T = vtype;               \
  };

DEF_TYPE_GET(uint32_t, vector_u32)
DEF_TYPE_GET(int32_t, vector_s32)
DEF_TYPE_GET(uint16_t, vector_u16)
DEF_TYPE_GET(int16_t, vector_s16)
DEF_TYPE_GET(float, vector_f32)
DEF_TYPE_GET(half, vector_f16)
DEF_TYPE_GET(bfloat16_t, vector_bf16)
DEF_TYPE_GET(uint8_t, vector_u8)
DEF_TYPE_GET(int8_t, vector_s8)
DEF_TYPE_GET(bool, vector_s8)

template <typename T>
using RegTensor = typename TypeGet<T>::T;

using MaskReg = vector_bool;

template <size_t N>
struct SizeToUint;

template <>
struct SizeToUint<4> { using type = uint32_t; };

template <>
struct SizeToUint<2> { using type = uint16_t; };

template <typename T>
using UintFor = typename SizeToUint<sizeof(T)>::type;

constexpr uint32_t kSimtThreadNum = 2048;

template <typename T>
__aicore_inline__ MaskReg UpdateMask(uint32_t &scalar) {
  MaskReg reg;
  if constexpr (sizeof(T) == 1) {
    reg = plt_b8(scalar, POST_UPDATE);
  } else if constexpr (sizeof(T) == 2) {
    reg = plt_b16(scalar, POST_UPDATE);
  } else if constexpr (sizeof(T) == 4) {
    reg = plt_b32(scalar, POST_UPDATE);
  }
  return reg;
}

template <typename T>
__aicore_inline__ MaskReg MoveMask() {
  if constexpr (sizeof(T) == 2) {
    return movp_b16();
  } else if constexpr (sizeof(T) == 4) {
    return movp_b32();
  }
}

template <ROUND T>
constexpr __aicore_inline__ auto RoundValue() {
  return std::integral_constant<ROUND, T>();
}

template <typename T>
constexpr __aicore_inline__ DistVST DistSTValue() {
  if constexpr (sizeof(T) == 1) {
    return DistVST::DIST_NORM_B8;
  } else if constexpr (sizeof(T) == 2) {
    return DistVST::DIST_NORM_B16;
  }
  return DistVST::DIST_NORM_B32;
}

template <auto funcPtr, typename... Args>
__aicore__ inline void VfCall(cce::dim3 thread_nums, Args &&...args) {
  cce::async_invoke<funcPtr>(thread_nums, args...);
}

template <typename T>
__simt_vf__ inline void OneHotSimtX(__ubuf__ T *dst, __ubuf__ int32_t *indices, uint32_t iter_num, uint32_t depth,
                                    T on_value) {
  for (uint32_t i = threadIdx.x; i < iter_num; i += blockDim.x) {
    uint32_t indice = static_cast<uint32_t>(indices[i]);
    if (indice < depth) {
      dst[i * depth + indice] = on_value;
    }
  }
}

template <typename T>
__simt_vf__ inline void OneHotSimtXTile(__ubuf__ T *dst, __ubuf__ int32_t *indices, uint32_t begin, uint32_t depth,
                                        T on_value) {
  if (threadIdx.x == 0) {
    uint32_t indice = static_cast<uint32_t>(indices[0]);
    if (indice >= begin && indice < begin + depth) {
      dst[indice - begin] = on_value;
    }
  }
}

template <typename T>
__simt_vf__ inline void OneHotSimtY(__ubuf__ T *dst, __ubuf__ int32_t *indices, uint32_t dup_round,
                                    uint32_t iter_num, uint32_t depth, T on_value) {
  uint32_t total = dup_round * iter_num;
  for (uint32_t linear = threadIdx.x; linear < total; linear += blockDim.x) {
    uint32_t dup = linear / iter_num;
    uint32_t i = linear - dup * iter_num;
    uint32_t indice = static_cast<uint32_t>(indices[linear]);
    if (indice < depth) {
      dst[(depth * dup + indice) * iter_num + i] = on_value;
    }
  }
}

template <typename T>
__simt_vf__ inline void OneHotSimtYTile(__ubuf__ T *dst, __ubuf__ int32_t *indices, uint32_t iter_num,
                                        uint32_t begin, uint32_t end, T on_value) {
  for (uint32_t i = threadIdx.x; i < iter_num; i += blockDim.x) {
    uint32_t indice = static_cast<uint32_t>(indices[i]);
    if (indice >= begin && indice < end) {
      dst[(indice - begin) * iter_num + i] = on_value;
    }
  }
}

template <typename T>
__simt_vf__ inline void OneHotSimtYTile2(__ubuf__ T *dst, __ubuf__ int32_t *indices, uint32_t iter_num,
                                         uint32_t begin, T on_value) {
  for (uint32_t i = threadIdx.x; i < iter_num; i += blockDim.x) {
    uint32_t indice = static_cast<uint32_t>(indices[i]);
    if (indice == begin) {
      dst[i] = on_value;
    }
  }
}

#define DECLARE_BINARY(builtin)                                                                                 \
  template <typename T>                                                                                         \
  __aicore_inline__ void builtin##_count(__ubuf__ T *dst, __ubuf__ T *src0, __ubuf__ T *src1, uint32_t count) { \
    __VEC_SCOPE__ {                                                                                             \
      RegTensor<T> vreg0;                                                                                       \
      RegTensor<T> vreg1;                                                                                       \
      RegTensor<T> vreg2;                                                                                       \
      vector_bool stPreg;                                                                                       \
      uint32_t sregLower = BlockNum(T);                                                                         \
      uint16_t repeat = CeilDiv(count, sregLower);                                                              \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();                           \
      for (uint16_t i = 0; i < repeat; ++i) {                                                                   \
        stPreg = UpdateMask<T>(count);                                                                          \
        vlds(vreg0, src0, i *sregLower, NORM);                                                                  \
        vlds(vreg1, src1, i *sregLower, NORM);                                                                  \
        builtin(vreg2, vreg0, vreg1, stPreg, MODE_ZEROING);                                                     \
        vsts(vreg2, dst, i *sregLower, distValue, stPreg);                                                      \
      }                                                                                                         \
    }                                                                                                           \
  }

#define DECLARE_BINARY_MASK(builtin)                                                                          \
  template <typename T>                                                                                       \
  __aicore_inline__ void builtin##_mask(__ubuf__ T *dst, __ubuf__ T *src0, __ubuf__ T *src1, uint16_t repeat, \
                                        uint32_t dst_offset, uint32_t src0_offset, uint32_t src1_offset) {    \
    __VEC_SCOPE__ {                                                                                           \
      RegTensor<T> vreg0;                                                                                     \
      RegTensor<T> vreg1;                                                                                     \
      RegTensor<T> vreg2;                                                                                     \
      vector_bool stPreg = MoveMask<T>();                                                                     \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();                         \
      for (uint16_t i = 0; i < repeat; ++i) {                                                                 \
        vlds(vreg0, src0, i * src0_offset, NORM);                                                             \
        vlds(vreg1, src1, i * src1_offset, NORM);                                                             \
        builtin(vreg2, vreg0, vreg1, stPreg, MODE_ZEROING);                                                   \
        vsts(vreg2, dst, i * dst_offset, distValue, stPreg);                                                  \
      }                                                                                                       \
    }                                                                                                         \
  }

#define DECLARE_CBINARY_MASK(builtin)                                                                            \
  template <typename T>                                                                                          \
  __aicore_inline__ void builtin##_mask(__ubuf__ T *dst, __ubuf__ T *src0, uint16_t repeat, uint32_t dst_offset, \
                                        uint32_t src0_offset) {                                                  \
    __VEC_SCOPE__ {                                                                                              \
      RegTensor<T> vreg0;                                                                                        \
      RegTensor<T> vreg1;                                                                                        \
      vector_align ureg;                                                                                         \
      vector_bool exPreg = MoveMask<T>();                                                                        \
      for (uint16_t i = 0; i < repeat; ++i) {                                                                    \
        vlds(vreg0, src0, i *src0_offset, NORM);                                                                 \
        builtin(vreg1, vreg0, exPreg, MODE_ZEROING);                                                             \
        vstus(ureg, dst_offset, vreg1, dst, POST_UPDATE);                                                        \
      }                                                                                                          \
      vstas(ureg, dst, 0, POST_UPDATE);                                                                          \
    }                                                                                                            \
  }

#define DECLARE_UNARY(builtin)                                                                \
  template <typename T>                                                                       \
  __aicore_inline__ void builtin##_count(__ubuf__ T *dst, __ubuf__ T *src0, uint32_t count) { \
    __VEC_SCOPE__ {                                                                           \
      RegTensor<T> vreg0;                                                                     \
      RegTensor<T> vreg1;                                                                     \
      vector_bool stPreg;                                                                     \
      uint32_t sregLower = BlockNum(T);                                                       \
      uint16_t repeat = CeilDiv(count, sregLower);                                            \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();         \
      for (uint16_t i = 0; i < repeat; ++i) {                                                 \
        stPreg = UpdateMask<T>(count);                                                        \
        vlds(vreg0, src0, i *sregLower, NORM);                                                \
        builtin(vreg1, vreg0, stPreg, MODE_ZEROING);                                          \
        vsts(vreg1, dst, i *sregLower, distValue, stPreg);                                    \
      }                                                                                       \
    }                                                                                         \
  }

#define DECLARE_BINARYS(builtin)                                                                        \
  template <typename T>                                                                                 \
  __aicore_inline__ void builtin##_count(__ubuf__ T *dst, __ubuf__ T *src0, T scalar, uint32_t count) { \
    __VEC_SCOPE__ {                                                                                     \
      RegTensor<T> vreg0;                                                                               \
      RegTensor<T> vreg1;                                                                               \
      vector_bool stPreg;                                                                               \
      uint32_t sregLower = BlockNum(T);                                                                 \
      uint16_t repeat = CeilDiv(count, sregLower);                                                      \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();                   \
      for (uint16_t i = 0; i < repeat; ++i) {                                                           \
        stPreg = UpdateMask<T>(count);                                                                  \
        vlds(vreg0, src0, i *sregLower, NORM);                                                          \
        builtin(vreg1, vreg0, scalar, stPreg, MODE_ZEROING);                                            \
        vsts(vreg1, dst, i *sregLower, distValue, stPreg);                                              \
      }                                                                                                 \
    }                                                                                                   \
  }

#define DECLARE_BINARYS_EXT(builtin)                                                                    \
  template <typename T, bool IsRhs>                                                                     \
  __aicore_inline__ void builtin##_count(__ubuf__ T *dst, __ubuf__ T *src0, T scalar, uint32_t count) { \
    __VEC_SCOPE__ {                                                                                     \
      RegTensor<T> vreg0;                                                                               \
      RegTensor<T> vreg1;                                                                               \
      RegTensor<T> vscalar;                                                                             \
      vector_bool stPreg;                                                                               \
      uint32_t sregLower = BlockNum(T);                                                                 \
      uint16_t repeat = CeilDiv(count, sregLower);                                                      \
      vbr(vscalar, scalar);                                                                             \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();                   \
      for (uint16_t i = 0; i < repeat; ++i) {                                                           \
        stPreg = UpdateMask<T>(count);                                                                  \
        vlds(vreg0, src0, i * sregLower, NORM);                                                         \
        if constexpr (IsRhs) {                                                                          \
          builtin(vreg1, vreg0, vscalar, stPreg, MODE_ZEROING);                                         \
        } else {                                                                                        \
          builtin(vreg1, vscalar, vreg0, stPreg, MODE_ZEROING);                                         \
        }                                                                                               \
        vsts(vreg1, dst, i * sregLower, distValue, stPreg);                                             \
      }                                                                                                 \
    }                                                                                                   \
  }

