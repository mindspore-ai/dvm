#define _CCE_KERNEL_
#include "isa.h"

template <typename T>
__aicore_inline__ void Swap(T &x, T &y) {
  T t = x;
  x = y;
  y = t;
}

__aicore_inline__ uint64_t RoundUp(uint64_t val, uint64_t rnd) { return (val + rnd - 1) / rnd * rnd; }
__aicore_inline__ uint64_t CeilDiv(uint64_t val, uint64_t rnd) { return (val + rnd - 1) / rnd; }

#define __force_inline__ inline __attribute__((always_inline))

constexpr uint64_t L0_PINGPONG_BUFFER_LEN = 16384;
constexpr uint64_t L1_PINGPONG_BUFFER_LEN = 131072;
constexpr uint64_t L0_PINGPONG_BUFFER_SIZE = 32768;   // 64KB / 2
constexpr uint64_t L1_PINGPONG_BUFFER_SIZE = 262144;  // 512KB / 2
constexpr uint64_t BIAS_ADDR = 0;
constexpr uint64_t BLOCK_SIZE = 16;

template <typename S>
struct QuantPRE {};

template <>
struct QuantPRE<half> {
  static constexpr QuantMode_t type = F322F16;
};

template <>
struct QuantPRE<bfloat16_t> {
  static constexpr QuantMode_t type = F322BF16;
};

// TODO: only support fp16/bf16 now
template <typename T>
class MatMul {
 public:
  __aicore__ MatMul(__gm__ vCubeOp *__restrict__ op) {
    gm_a = reinterpret_cast<__gm__ T *>(op->gm_a) + op->offset_a;
    gm_b = reinterpret_cast<__gm__ T *>(op->gm_b) + op->offset_b;
    gm_c = reinterpret_cast<__gm__ T *>(op->gm_c);
    gm_bias = reinterpret_cast<__gm__ uint8_t*>(op->gm_bias);
    m_real = op->m_real;
    n_real = op->n_real;
    k_real = op->k_real;
    m_align = op->m_align;
    n_align = op->n_align;
    k_align = op->k_align;
    batch_cast = op->batch_cast;
    ka_align = op->ka_align;
    kb_align = op->kb_align;
    m0 = op->m0;
    n0 = op->n0;
    k0 = op->k0;
    flags = op->flags;
    k0_part_len = min(L0_PINGPONG_BUFFER_LEN / max(m0, n0) / 16 * 16, k0);
    m_loop = op->m_loop;
    n_loop = op->n_loop;
    k_loop = op->k_loop;
    shuffle_k = block_idx % k_loop;
    k_actual = (shuffle_k == k_loop - 1) ? (k_real - shuffle_k * k0) : k0;
  }

  __force_inline__ __aicore__ void LoadA(__cbuf__ T *__restrict__ dst,
                                         __gm__ T *__restrict__ src,
                                         uint64_t midx,
                                         uint64_t kidx,
                                         uint64_t m_actual,
                                         uint64_t k_actual) {
    // load GM to L1: ND -> zN
    bool transpose_a = flags & V_CUBE_FLAG_TRANS_A;
    uint64_t offset_a = transpose_a ? (kidx * k0 * m_align + midx * m0) : (midx * m0 * k_align + kidx * k0);
    if (m_actual == 1 && !transpose_a) {
      // GEMV mode
      copy_gm_to_cbuf(dst, src + offset_a, 0, 1, RoundUp(k_actual, BLOCK_SIZE) / BLOCK_SIZE, 0, 0, PAD_NONE);
    } else {
      if (transpose_a) {
        copy_gm_to_cbuf_multi_nd2nz_b16(
          dst,
          src + offset_a,
          0,                                                                         // sid
          1,                                                                         // ndNum
          k_actual,                                                                  // nValue
          m_actual,                                                                  // dValue
          0,                                                                         // srcNdMatrixStride, unused if nd_num=1
          m_align,                                                                   // srcDValue
          RoundUp(k_actual, BLOCK_SIZE),                                             // dstNzC0Stride
          1,                                                                         // dstNzNStride
          0                                                                          // dstNzMatrixStride, unused if nd_num=1
        );
      } else {
        copy_gm_to_cbuf_multi_nd2nz_b16(
          dst,
          src + offset_a,
          0,                                                                         // sid
          1,                                                                         // ndNum
          m_actual,                                                                  // nValue
          k_actual,                                                                  // dValue
          0,                                                                         // srcNdMatrixStride, unused if nd_num=1
          k_align,                                                                   // srcDValue
          RoundUp(m_actual, BLOCK_SIZE),                                             // dstNzC0Stride
          1,                                                                         // dstNzNStride
          0                                                                          // dstNzMatrixStride, unused if nd_num=1
        );
      }
    }
  }

  __force_inline__ __aicore__ void LoadB(__cbuf__ T *__restrict__ dst,
                                         __gm__ T *__restrict__ src,
                                         uint64_t kidx,
                                         uint64_t nidx,
                                         uint64_t k_actual,
                                         uint64_t n_actual) {
    // load GM to L1: ND -> zN
    if (flags & V_CUBE_FLAG_TRANS_B) {
      copy_gm_to_cbuf_multi_nd2nz_b16(
        dst,
        src + nidx * n0 * k_align + kidx * k0,
        0,                                                                           // sid
        1,                                                                           // ndNum
        n_actual,                                                                    // nValue
        k_actual,                                                                    // dValue
        0,                                                                           // srcNdMatrixStride, unused if nd_num=1
        k_align,                                                                     // srcDValue
        RoundUp(n_actual, BLOCK_SIZE),                                               // dstNzC0Stride
        1,                                                                           // dstNzNStride
        0                                                                            // dstNzMatrixStride, unused if nd_num=1
      );
    } else {
      copy_gm_to_cbuf_multi_nd2nz_b16(
        dst,
        src + kidx * k0 * n_align + nidx * n0,
        0,                                                                           // sid
        1,                                                                           // ndNum
        k_actual,                                                                    // nValue
        n_actual,                                                                    // dValue
        0,                                                                           // srcNdMatrixStride, unused if nd_num=1
        n_align,                                                                     // srcDValue
        RoundUp(k_actual, BLOCK_SIZE),                                               // dstNzC0Stride
        1,                                                                           // dstNzNStride
        0                                                                            // dstNzMatrixStride, unused if nd_num=1
      );
    }
  }

  __force_inline__ __aicore__ void LoadL0A(__ca__ T *__restrict__ dst,
                                           __cbuf__ T *__restrict__ src,
                                           uint64_t total_k,
                                           uint64_t k_part_idx,
                                           uint64_t k_round,
                                           uint64_t k0_round,
                                           uint64_t m_actual) {
    // load L1 to L0A: zN -> zZ
    uint64_t m_round = RoundUp(m_actual, BLOCK_SIZE);
    // GEMV mode
    if ((m_actual == 1 && !(flags & V_CUBE_FLAG_TRANS_A))) {
      load_cbuf_to_ca(
        dst,
        src + k_part_idx * k0_part_len,
        0,
        (k0_round + BLOCK_SIZE * BLOCK_SIZE - 1) / (BLOCK_SIZE * BLOCK_SIZE),
        1,
        0,
        0,
        false,
        inc);
    } else {
      if (flags & V_CUBE_FLAG_TRANS_A) {
        for (uint64_t i = 0; i < m_round / BLOCK_SIZE; i++) {
          load_cbuf_to_ca(
            dst + i * BLOCK_SIZE * k0_round,
            src + i * k_round * BLOCK_SIZE + k0_part_len * k_part_idx * BLOCK_SIZE,
            0,
            k0_round / BLOCK_SIZE,           // repeat: number of fractal
            1,                               // srcstride: number of fractal
            0,                               // dststride: number of fractal
            0,
            true,                            // transpose
            inc);
        }
      } else {
        for (uint64_t i = 0; i < m_round / BLOCK_SIZE; i++) {
          load_cbuf_to_ca(
            dst + i * BLOCK_SIZE * k0_round,
            src + m_round * k0_part_len * k_part_idx + i * BLOCK_SIZE * BLOCK_SIZE,
            0,
            k0_round / BLOCK_SIZE,           // repeat: number of fractal
            m_round / BLOCK_SIZE,            // srcstride: number of fractal
            0,                               // dststride: number of fractal
            0,
            false,                           // transpose
            inc);
        }
      }
    }
  }

  __force_inline__ __aicore__ void LoadL0B(__cb__ T *__restrict__ dst,
                                           __cbuf__ T *__restrict__ src,
                                           uint64_t total_k,
                                           uint64_t k_part_idx,
                                           uint64_t k_round,
                                           uint64_t k0_round,
                                           uint64_t n_actual) {
    // load L1 to L0A: zN -> nZ
    uint64_t n_round = RoundUp(n_actual, BLOCK_SIZE);
    if (flags & V_CUBE_FLAG_TRANS_B) {
      load_cbuf_to_cb(
        dst,
        src + k_part_idx * k0_part_len * n_round,
        0,
        k0_round * n_round / BLOCK_SIZE / BLOCK_SIZE, // repeat: number of fractal
        1,                                 // srcStride: number of fractal
        0,                                 // dstStride: number of fractal
        0,
        false,                             // transpose
        inc);
    } else {
      for (uint64_t i = 0; i < k0_round / BLOCK_SIZE; i++) {
        load_cbuf_to_cb(
          dst + i * BLOCK_SIZE * n_round,
          src + (k0_part_len * k_part_idx + i * BLOCK_SIZE) * BLOCK_SIZE,
          0,
          n_round / BLOCK_SIZE,                 // repeat: number of fractal
          k_round / BLOCK_SIZE,                 // srcStride: number of fractal
          0,                               // dstStride: number of fractal
          0,
          true,                            // transpose
          inc);
      }
    }
  }

  __force_inline__ __aicore__ void MM(__cc__ float *__restrict__ c,
                                       __ca__ T *__restrict__ a,
                                       __cb__ T *__restrict__ b,
                                       bool init_c,
                                       uint8_t unit_flag,
                                       uint64_t m_actual,
                                       uint64_t n_actual,
                                       uint64_t k0_actual) {
    if (m_actual == 1 && (flags & V_CUBE_FLAG_TRANS_A)) {
      m_actual = 16;
    }
    mad(
      c,
      a,
      b,
      m_actual,                               // m
      k0_actual,                              // k
      n_actual,                               // n
      unit_flag,                              // unitFlag
      0,                                      // kDirectionAlign
      0,                                      // cmatrixSource
      init_c                                  // cmatrixInitVal
    );
    if ((m_actual / BLOCK_SIZE) * (n_actual / BLOCK_SIZE) < 10) {
      pipe_barrier(PIPE_M);
    }
  }

  __force_inline__ __aicore__ void LoadBias(__cbuf__ void *__restrict__ dst,
                                            __gm__ void *__restrict__ src,
                                            uint64_t n_actual) {
    copy_gm_to_cbuf(
      dst,                                // dst
      src,                                // src
      0,                                  // sid
      1,                                  // nBurst
      CeilDiv(n_actual * BiasTypeSize(), 32),  // lenBurst
      0,                                  // srcGap
      0,                                  // dstGap
      PAD_NONE                            // padMode
    );
  }

  __force_inline__ __aicore__ void LoadBt(uint64_t dst, __cbuf__ void *__restrict__ src, uint64_t n_actual) {
    copy_cbuf_to_bt(
      dst,                                      // dst
      src,                                      // src
      (flags & V_CUBE_FLAG_BIAS_FP16) ? 1 : 0,  // convControl
      1,                                        // nBurst
      CeilDiv(n_actual * BiasTypeSize(), 64),   // lenBurst
      0,                                        // srcGap
      0                                         // dstGap
    );
  }

  __force_inline__ __aicore__ void MAD(__cc__ float *__restrict__ c, 
                                        __ca__ T *__restrict__ a, 
                                        __cb__ T *__restrict__ b, 
                                        bool init_c, 
                                        uint8_t unit_flag, 
                                        uint64_t m_actual, 
                                        uint64_t n_actual,
                                        uint64_t k0_actual) {
    if (m_actual == 1 && (flags & V_CUBE_FLAG_TRANS_A)) {
      m_actual = 16;
    }
    mad(
      c,
      a,
      b,
      BIAS_ADDR,
      m_actual,                               // m
      k0_actual,                              // k
      n_actual,                               // n
      unit_flag,                              // unitFlag
      0,                                      // kDirectionAlign
      1,                                      // cmatrixSource
      0                                       // cmatrixInitVal
    );
    if ((m_actual / BLOCK_SIZE) * (n_actual / BLOCK_SIZE) < 10) {
      pipe_barrier(PIPE_M);
    }
  }

  __force_inline__ __aicore__ void StoreC_Fp32(__gm__ float *__restrict__ dst,
                                               __cc__ float *__restrict__ c,
                                               uint64_t midx,
                                               uint64_t nidx,
                                               uint8_t unit_flag,
                                               uint64_t m_actual,
                                               uint64_t n_actual) {
    copy_matrix_cc_to_gm(
      dst + midx * m0 * n_real + nidx * n0,        // dst
      c,                                      // src
      0,                                      // sid
      n_actual,                               // NSize
      m_actual,                               // MSize
      n_real,                                 // dstStride_dst_D
      RoundUp(m_actual, BLOCK_SIZE),          // srcStride
      unit_flag,                              // UnitFlagMode
      NoQuant,                                // QuantPRE
      0,                                      // ReLUPRE
      false,                                  // channelSplit
      true                                    // NZ2ND_EN
    );
  }

  __force_inline__ __aicore__ void StoreC(__gm__ T *__restrict__ dst,
                                          __cc__ float *__restrict__ c,
                                          uint64_t midx,
                                          uint64_t nidx,
                                          uint8_t unit_flag,
                                          uint64_t m_actual,
                                          uint64_t n_actual) {
    copy_matrix_cc_to_gm(
      dst + midx * m0 * n_real + nidx * n0,        // dst
      c,                                      // src
      0,                                      // sid
      n_actual,                               // NSize
      m_actual,                               // MSize
      n_real,                                 // dstStride_dst_D
      RoundUp(m_actual, BLOCK_SIZE),          // srcStride
      unit_flag,                              // UnitFlagMode
      (QuantMode_t)QuantPRE<T>::type,         // QuantPRE
      0,                                      // ReLUPRE
      false,                                  // channelSplit
      true                                    // NZ2ND_EN
    );
  }

  __force_inline__ __aicore__ void StoreC_PingPong(__gm__ T *__restrict__ dst,
                                          __cc__ float *__restrict__ c,
                                          uint8_t unit_flag,
                                          uint64_t m_actual,
                                          uint64_t n_actual,
                                          uint64_t pingpong_offset) {
    copy_matrix_cc_to_gm(
      dst + m0 * n0 * pingpong_offset,        // dst
      c,                                      // src
      0,                                      // sid
      n_actual,                               // NSize
      m_actual,                               // MSize
      n0,                               // dstStride_dst_D
      RoundUp(m_actual, BLOCK_SIZE),          // srcStride
      unit_flag,                              // UnitFlagMode
      (QuantMode_t)QuantPRE<T>::type,         // QuantPRE
      0,                                      // ReLUPRE
      false,                                  // channelSplit
      true                                    // NZ2ND_EN
    );
  }

  __force_inline__ __aicore__ uint64_t BiasTypeSize() {
    return (flags & V_CUBE_FLAG_BIAS_FP16) ? sizeof(half) : sizeof(float);
  }

  // Compute global memory offset of matrix A and B based on batch idx of matrix C
  __force_inline__ __aicore__ void ComputeOffset(uint64_t c_idx, uint64_t &offset_a, uint64_t &offset_b) {
    uint64_t a_idx = c_idx;
    uint64_t b_idx = c_idx;
    if (batch_cast) {
      uint64_t batch_c1 = vGetBitRange(batch_cast, V_CUBE_BCAST_C1_OFFSET, V_CUBE_BCAST_C1_BITS);
      uint64_t c_idx0 = c_idx / batch_c1;
      uint64_t c_idx1 = c_idx - c_idx0 * batch_c1;
      if (uint64_t cast_a = batch_cast & (V_CUBE_BCAST_FLAG_BCAST_A0 | V_CUBE_BCAST_FLAG_BCAST_A1)) {
        a_idx = cast_a == V_CUBE_BCAST_FLAG_BCAST_A0 ? c_idx1 : (cast_a == V_CUBE_BCAST_FLAG_BCAST_A1 ? c_idx0 : 0);
      }
      if (uint64_t cast_b = batch_cast & (V_CUBE_BCAST_FLAG_BCAST_B0 | V_CUBE_BCAST_FLAG_BCAST_B1)) {
        b_idx = cast_b == V_CUBE_BCAST_FLAG_BCAST_B0 ? c_idx1 : (cast_b == V_CUBE_BCAST_FLAG_BCAST_B1 ? c_idx0 : 0);
      }
    }
    offset_a = a_idx * m_align * ka_align;
    offset_b = b_idx * n_align * kb_align;
  }

  __gm__ T *__restrict__ gm_a;
  __gm__ T *__restrict__ gm_b;
  __gm__ T *__restrict__ gm_c;
  __gm__ uint8_t *__restrict__ gm_bias;
  uint64_t n_loop, m_loop, k_loop;
  uint64_t k0_part_len;
  uint64_t m_real, n_real, k_real;
  uint64_t m_align, n_align, k_align;
  uint64_t ka_align, kb_align;
  uint64_t batch_cast;
  uint64_t m0, n0, k0;
  uint64_t flags;
  uint64_t k_actual, shuffle_k;
};

#define V_MM_POS_M_OFFSET 0
#define V_MM_POS_M_BITS 22
#define V_MM_POS_N_OFFSET 22
#define V_MM_POS_N_BITS 22
#define V_MM_POS_C_OFFSET 44
#define V_MM_POS_C_BITS 20

#define V_GMM_BLOCK_OFF_OFFSET 32
#define V_GMM_BLOCK_OFF_BIT 32
#define V_GMM_LAST_OFFSET 8
#define V_GMM_LAST_BIT 24
#define V_GMM_G_SIZE_OFFSET 0
#define V_GMM_G_SIZE_BITS 8

template <typename M>
class TileVisitor {
 public:
  static constexpr uint64_t INVALID_TILE_POS = uint64_t(-1);
  __aicore__ TileVisitor(__gm__ vCubeOp *__restrict__ op, uint64_t tile_num, M &m) {
    swizzle_ = op->swizzle;
    pos_last_ = pos_ = INVALID_TILE_POS;
    if (m.flags & V_CUBE_FLAG_GROUPED_LIST) {
      group_info_ = op->group_list_size << V_GMM_G_SIZE_OFFSET;
      gm_group_list_ = reinterpret_cast<__gm__ int64_t *>(op->gm_group_list);
      tile_loop_ = block_idx;
      UpdateGmm<true>(m);
    } else {
      group_info_ = 0;
      tile_loop_ = tile_num << 32 | block_idx;
    }
    UpdateNext(m);
  }

  template <bool init>
  __force_inline__ __aicore__ void UpdateGmm(M &m) {
    if constexpr (!init) {
      if (m.flags & V_CUBE_FLAG_GROUP_K) {
        m.gm_a += (m.flags & V_CUBE_FLAG_TRANS_A) ? m.k_real * m.m_align : m.k_real;
        m.gm_b += (m.flags & V_CUBE_FLAG_TRANS_B) ? m.k_real : m.k_real * m.n_align;
        m.gm_bias += m.n_real * m.BiasTypeSize();
      } else {
        m.gm_a += (m.flags & V_CUBE_FLAG_TRANS_A) ? m.m_real : m.m_real * m.ka_align;
        m.gm_b += m.kb_align * m.n_align;
        m.gm_bias += m.n_real * m.BiasTypeSize();
      }
      if (!(m.flags & V_CUBE_FLAG_PINGPONG_STORE)) {
        m.gm_c += m.m_real * m.n_real * (m.flags & V_CUBE_FLAG_OUT_FP32 ? 2 : 1);
      }
      group_info_ += (m.m_loop * m.n_loop) << V_GMM_BLOCK_OFF_OFFSET;
    }
    uint64_t stride = static_cast<uint64_t>(*gm_group_list_ - LastList());
    group_info_ += stride << V_GMM_LAST_OFFSET;
    group_info_--;
    if (m.flags & V_CUBE_FLAG_GROUP_K) {
      m.k_real = stride;
      m.k_loop = CeilDiv(m.k_real, m.k0);
      m.shuffle_k = block_idx % m.k_loop;
      m.k_actual = (m.shuffle_k == m.k_loop - 1) ? (m.k_real - m.shuffle_k * m.k0) : m.k0;
    } else {
      m.m_real = stride;
      m.m_loop = CeilDiv(m.m_real, m.m0);
    }
    gm_group_list_++;
    pos_last_ = pos_ = INVALID_TILE_POS;
    tile_loop_ += (m.m_loop * m.n_loop) << 32;
  }

  __force_inline__ __aicore__ bool Forward(M &m) {
    if ((m.flags & V_CUBE_FLAG_GROUP_SET) && pos_ != INVALID_TILE_POS) {
      ffts_cross_core_sync(PIPE_FIX, vFftsSyncConfig(2, 0));
      uint64_t tile_idx = vGetBitRange(tile_loop_, 0, 32);
      if (tile_idx > block_idx + block_num) {
        wait_flag_dev(1);
      }
    }
    while (GroupListSize() > 0 && !HasNext()) {
      UpdateGmm<false>(m);
      UpdateNext(m);
    }
    if (!HasNext()) {
      return false;
    }
    pos_last_ = pos_;
    pos_ = pos_next_;
    tile_loop_ += block_num;
    UpdateNext(m);
    return true;
  }

  __aicore__ void UpdateNext(const M &m) {
    uint64_t tile_idx = vGetBitRange(tile_loop_, 0, 32);
    uint64_t tile_num = vGetBitRange(tile_loop_, 32, 32);
    if (tile_idx < tile_num) {
      tile_idx -= BlockIdxOffset();
      uint64_t cidx = tile_idx / (m.m_loop * m.n_loop);
      uint64_t sidx = tile_idx - cidx * (m.m_loop * m.n_loop);
      uint64_t v_type = swizzle_ >> 16;
      uint64_t swiz_cnt = swizzle_ & 0xffff;
      uint64_t midx, nidx;
      if (v_type == V_CUBE_SWIZ_VISIT_nZ) {
        vCubeOp::TileMap_nZ(sidx, m.m_loop, m.n_loop, swiz_cnt, midx, nidx);
      } else {
        vCubeOp::TileMap_zN(sidx, m.m_loop, m.n_loop, swiz_cnt, midx, nidx);
      }
      pos_next_ = cidx << V_MM_POS_C_OFFSET | midx << V_MM_POS_M_OFFSET | nidx << V_MM_POS_N_OFFSET;
    } else {
      pos_next_  = INVALID_TILE_POS;
    }

  }

  __force_inline__ __aicore__ bool HasNext() const { return pos_next_ != INVALID_TILE_POS; }
  __force_inline__ __aicore__ bool HasLast() const { return pos_last_ != INVALID_TILE_POS; }
  __force_inline__ __aicore__ uint64_t CurC() const { return vGetBitRange(pos_, V_MM_POS_C_OFFSET, V_MM_POS_C_BITS); }
  __force_inline__ __aicore__ uint64_t CurM() const { return vGetBitRange(pos_, V_MM_POS_M_OFFSET, V_MM_POS_M_BITS); }
  __force_inline__ __aicore__ uint64_t CurN() const { return vGetBitRange(pos_, V_MM_POS_N_OFFSET, V_MM_POS_N_BITS); }
  __force_inline__ __aicore__ uint64_t NextC() const { return vGetBitRange(pos_next_, V_MM_POS_C_OFFSET, V_MM_POS_C_BITS); }
  __force_inline__ __aicore__ uint64_t NextM() const { return vGetBitRange(pos_next_, V_MM_POS_M_OFFSET, V_MM_POS_M_BITS); }
  __force_inline__ __aicore__ uint64_t NextN() const { return vGetBitRange(pos_next_, V_MM_POS_N_OFFSET, V_MM_POS_N_BITS); }
  __force_inline__ __aicore__ uint64_t LastC() const { return vGetBitRange(pos_last_, V_MM_POS_C_OFFSET, V_MM_POS_C_BITS); }
  __force_inline__ __aicore__ uint64_t LastM() const { return vGetBitRange(pos_last_, V_MM_POS_M_OFFSET, V_MM_POS_M_BITS); }
  __force_inline__ __aicore__ uint64_t LastN() const { return vGetBitRange(pos_last_, V_MM_POS_N_OFFSET, V_MM_POS_N_BITS); }

  __force_inline__ __aicore__ uint64_t GroupListSize() const {
    return vGetBitRange(group_info_, V_GMM_G_SIZE_OFFSET, V_GMM_G_SIZE_BITS);
  }
  __force_inline__ __aicore__ uint64_t BlockIdxOffset() const {
    return vGetBitRange(group_info_, V_GMM_BLOCK_OFF_OFFSET, V_GMM_BLOCK_OFF_BIT);
  }
  __force_inline__ __aicore__ uint64_t LastList() const {
    return vGetBitRange(group_info_, V_GMM_LAST_OFFSET, V_GMM_LAST_BIT);
  }

  uint64_t pos_;
  uint64_t pos_next_;
  uint64_t pos_last_;
  uint64_t swizzle_;
  uint64_t tile_loop_;
  
  __gm__ int64_t *__restrict__ gm_group_list_;
  uint64_t group_info_;
};

#define V_PINGPONG_FLAG_EVENT  0x1ul
#define V_PINGPONG_FLAG_STORE  0x2ul
template <typename T>
__aicore_inline__ void CutMKN(__gm__ vCubeOp *__restrict__ op, uint64_t tile_end) {
  set_padding((uint64_t)0);
  uint64_t config = 0x1;
  set_nd_para(config);
  MatMul<T> mat(op);
  TileVisitor<MatMul<T>> visit(op, tile_end, mat);
  if (mat.flags & V_CUBE_FLAG_ATOMIC_ADD) {
    set_atomic_add();
    set_atomic_f32();
  } else {
    set_atomic_none();
  }
  uint64_t offset_mk = RoundUp(op->m0 * op->k0 * sizeof(T), 256);  // TODO: int8 is 512
  uint64_t offset_nk = RoundUp(op->n0 * op->k0 * sizeof(T), 256);  // TODO: int8 is 512
  __cbuf__ T *__restrict__ l1a = reinterpret_cast<__cbuf__ T*>(0);
  __cbuf__ T *__restrict__ l1b = reinterpret_cast<__cbuf__ T*>(offset_mk);
  __cbuf__ T *__restrict__ n_l1a = reinterpret_cast<__cbuf__ T*>(L1_PINGPONG_BUFFER_SIZE);
  __cbuf__ T *__restrict__ n_l1b = reinterpret_cast<__cbuf__ T*>(L1_PINGPONG_BUFFER_SIZE + offset_mk);
  __cbuf__ void *__restrict__ bias_l1 = reinterpret_cast<__cbuf__ void*>(L1_PINGPONG_BUFFER_SIZE + offset_mk + offset_nk);
  __ca__ T *__restrict__ l0a_base = reinterpret_cast<__ca__ T*>(0);
  __cb__ T *__restrict__ l0b_base = reinterpret_cast<__cb__ T*>(0);
  __ca__ T *__restrict__ l0a_next = reinterpret_cast<__ca__ T*>(L0_PINGPONG_BUFFER_SIZE);
  __cb__ T *__restrict__ l0b_next = reinterpret_cast<__cb__ T*>(L0_PINGPONG_BUFFER_SIZE);
  uint64_t pingpong_flags = 0;
  set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
  set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID1);
  set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID2);
  set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID3);
  set_flag(PIPE_M, PIPE_MTE1, EVENT_ID0);
  set_flag(PIPE_M, PIPE_MTE1, EVENT_ID1);
  set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID4);

  while (visit.Forward(mat)) {
    __cc__ float *__restrict__ l0c = reinterpret_cast<__cc__ float *>((uintptr_t)0);
    uint64_t cidx = visit.CurC();
    uint64_t midx = visit.CurM();
    uint64_t nidx = visit.CurN();
    uint64_t batch_offset = cidx * mat.m_real * mat.n_real;
    uint64_t offset_a, offset_b;
    mat.ComputeOffset(cidx, offset_a, offset_b);
    uint64_t m_actual = (midx == (mat.m_loop - 1)) ? (mat.m_real - midx * mat.m0) : mat.m0;
    uint64_t n_actual = (nidx == (mat.n_loop - 1)) ? (mat.n_real - nidx * mat.n0) : mat.n0;

    if (!visit.HasLast()) {
      auto event_id = pingpong_flags & V_PINGPONG_FLAG_EVENT ? EVENT_ID0 : EVENT_ID1;
      wait_flag(PIPE_MTE1, PIPE_MTE2, event_id);
      mat.LoadA(l1a, mat.gm_a + offset_a, midx, mat.shuffle_k, m_actual, mat.k_actual);
      set_flag(PIPE_MTE2, PIPE_MTE1, event_id);
      wait_flag(PIPE_MTE1, PIPE_MTE2, event_id + 2);
      mat.LoadB(l1b, mat.gm_b + offset_b, mat.shuffle_k, nidx, mat.k_actual, n_actual);
      set_flag(PIPE_MTE2, PIPE_MTE1, event_id + 2);
    }
    if (mat.flags & V_CUBE_FLAG_WITH_BIAS) {
      wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID4);
      if (nidx != visit.LastN()) {
        mat.LoadBias(bias_l1, mat.gm_bias + mat.BiasTypeSize() * nidx * mat.n0, n_actual);
      }
      set_flag(PIPE_MTE2, PIPE_MTE1, EVENT_ID5);
    }
    uint64_t shuffle_k = mat.shuffle_k;
    for (uint64_t k = 0; k < mat.k_loop; ++k) {
      uint64_t k_actual = (shuffle_k == mat.k_loop - 1) ? (mat.k_real - shuffle_k * mat.k0) : mat.k0;
      uint64_t k_round = RoundUp(k_actual, BLOCK_SIZE);
      uint64_t k_part_loop = CeilDiv(k_actual, mat.k0_part_len);
      event_t event_id, event_id_next;
      if (pingpong_flags & V_PINGPONG_FLAG_EVENT) {
        event_id = EVENT_ID0;
        event_id_next = EVENT_ID1;
      } else {
        event_id = EVENT_ID1;
        event_id_next = EVENT_ID0;
      }
      if (k < mat.k_loop - 1) {
        shuffle_k = (shuffle_k + 1) % mat.k_loop;
        uint64_t k_actual_next = (shuffle_k == mat.k_loop - 1) ? (mat.k_real - shuffle_k * mat.k0) : mat.k0;
        wait_flag(PIPE_MTE1, PIPE_MTE2, event_id_next);
        mat.LoadA(n_l1a, mat.gm_a + offset_a, midx, shuffle_k, m_actual, k_actual_next);
        set_flag(PIPE_MTE2, PIPE_MTE1, event_id_next);
        wait_flag(PIPE_MTE1, PIPE_MTE2, event_id_next + 2);
        mat.LoadB(n_l1b, mat.gm_b + offset_b, shuffle_k, nidx, k_actual_next, n_actual);
        set_flag(PIPE_MTE2, PIPE_MTE1, event_id_next + 2);
      } else if (visit.HasNext()) {
        uint64_t n_cidx = visit.NextC();
        uint64_t n_midx = visit.NextM();
        uint64_t n_nidx = visit.NextN();
        mat.ComputeOffset(n_cidx, offset_a, offset_b);
        uint64_t m_actual_next = (n_midx == (mat.m_loop - 1)) ? (mat.m_real - n_midx * mat.m0) : mat.m0;
        uint64_t n_actual_next = (n_nidx == (mat.n_loop - 1)) ? (mat.n_real - n_nidx * mat.n0) : mat.n0;
        bool load_a_flag = false;
        bool load_b_flag = false;
        if (mat.k_loop == 1 && visit.HasLast()) {
          uint64_t c_idx_n_last = visit.LastC();
          uint64_t last_offset_a, last_offset_b;
          mat.ComputeOffset(c_idx_n_last, last_offset_a, last_offset_b);
          load_a_flag = (offset_a == last_offset_a && visit.LastM() == n_midx);
          load_b_flag = (offset_b == last_offset_b && visit.LastN() == n_nidx);
        }
        wait_flag(PIPE_MTE1, PIPE_MTE2, event_id_next);
        if (!load_a_flag) {
          mat.LoadA(n_l1a, mat.gm_a + offset_a, n_midx, mat.shuffle_k, m_actual_next, mat.k_actual);
        }
        set_flag(PIPE_MTE2, PIPE_MTE1, event_id_next);
        wait_flag(PIPE_MTE1, PIPE_MTE2, event_id_next + 2);
        if (!load_b_flag) {
          mat.LoadB(n_l1b, mat.gm_b + offset_b, mat.shuffle_k, n_nidx, mat.k_actual, n_actual_next);
        }
        set_flag(PIPE_MTE2, PIPE_MTE1, event_id_next + 2);
      }
      for (uint64_t k_part_idx = 0; k_part_idx < k_part_loop; ++k_part_idx) {
        __ca__ T *__restrict__ l0a = (k_part_idx & 1) ? l0a_next : l0a_base;
        __cb__ T *__restrict__ l0b = (k_part_idx & 1) ? l0b_next : l0b_base;
        uint64_t k0_round = (k_part_idx == k_part_loop - 1) ? k_round - k_part_idx * mat.k0_part_len : mat.k0_part_len;
        uint64_t k0_actual = (k_part_idx == k_part_loop - 1) ? k_actual - k_part_idx * mat.k0_part_len : mat.k0_part_len;
        auto mte1_mad_event_id = (k_part_idx & 1) ? EVENT_ID1 : EVENT_ID0;
        if (k_part_idx == 0) {
          wait_flag(PIPE_MTE2, PIPE_MTE1, event_id);
        }
        wait_flag(PIPE_M, PIPE_MTE1, mte1_mad_event_id);
        mat.LoadL0A(l0a, l1a, k_part_loop, k_part_idx, k_round, k0_round, m_actual);
        if (k_part_idx == k_part_loop - 1) {
          set_flag(PIPE_MTE1, PIPE_MTE2, event_id);
        }
        if (k_part_idx == 0) {
          wait_flag(PIPE_MTE2, PIPE_MTE1, event_id + 2);
        }
        mat.LoadL0B(l0b, l1b, k_part_loop, k_part_idx, k_round, k0_round, n_actual);
        if (k_part_idx == k_part_loop - 1) {
          set_flag(PIPE_MTE1, PIPE_MTE2, event_id + 2);
        }
        set_flag(PIPE_MTE1, PIPE_M, mte1_mad_event_id);
        wait_flag(PIPE_MTE1, PIPE_M, mte1_mad_event_id);
        bool init_c = (k == 0 && k_part_idx == 0);
        uint8_t unit_flag = 0b10;  // do not allow reading from L0C
        if (k == mat.k_loop - 1 && k_part_idx == k_part_loop - 1) {
          unit_flag = 0b11;  // allow reading from L0C
        }
        if ((mat.flags & V_CUBE_FLAG_WITH_BIAS) && init_c) {
          wait_flag(PIPE_MTE2, PIPE_MTE1, EVENT_ID5);
          if (nidx != visit.LastN()) {
            mat.LoadBt(BIAS_ADDR, bias_l1, n_actual);
          }
          set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID4);  // bias ready, mte2 can begin move A/B or scale
          set_flag(PIPE_MTE1, PIPE_M, EVENT_ID4);     // bias ready, mmad can begin
          wait_flag(PIPE_MTE1, PIPE_M, EVENT_ID4);    // wait move bias fron L1 to BT
          mat.MAD(l0c, l0a, l0b, init_c, unit_flag, m_actual, n_actual, k0_actual);
        } else {
          mat.MM(l0c, l0a, l0b, init_c, unit_flag, m_actual, n_actual, k0_actual);
        }
        set_flag(PIPE_M, PIPE_MTE1, mte1_mad_event_id);
      }
      pingpong_flags ^= V_PINGPONG_FLAG_EVENT;
      Swap(l1a, n_l1a);
      Swap(l1b, n_l1b);
    }
    uint8_t unit_flag = 0b11;
    if (mat.flags & V_CUBE_FLAG_PINGPONG_STORE) {
      uint64_t pingpong_offset = pingpong_flags & V_PINGPONG_FLAG_STORE ? block_num + block_idx : block_idx;
      pingpong_flags ^= V_PINGPONG_FLAG_STORE;
      mat.StoreC_PingPong(mat.gm_c, l0c, unit_flag, m_actual, n_actual, pingpong_offset);
      if (mat.flags & V_CUBE_FLAG_PEER_STORE) {
        // result of GetCubeOffset()
        uint64_t group_offset = midx * mat.m0 * mat.n_real + nidx * mat.n0;
        set_flag(PIPE_FIX, PIPE_S, EVENT_ID0);
        wait_flag(PIPE_FIX, PIPE_S, EVENT_ID0);
        __gm__ uint64_t *peer_flag_mem =
          (__gm__ uint64_t *)((__gm__ uint8_t *)mat.gm_c + PEERMEM_FLAG_OFFSET + pingpong_offset * CACHE_LINE_SIZE);
        *peer_flag_mem = ((uint64_t)(op->unique_id) << 32) | (group_offset + 1);
        dcci(peer_flag_mem, 0);
      }
    } else if (mat.flags & V_CUBE_FLAG_OUT_FP32) {
      mat.StoreC_Fp32((__gm__ float *__restrict__)mat.gm_c + batch_offset, l0c, midx, nidx, unit_flag, m_actual,
                      n_actual);
    } else {
      mat.StoreC(mat.gm_c + batch_offset, l0c, midx, nidx, unit_flag, m_actual, n_actual);
    }
  }
  wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
  wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID1);
  wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID2);
  wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID3);
  wait_flag(PIPE_M, PIPE_MTE1, EVENT_ID0);
  wait_flag(PIPE_M, PIPE_MTE1, EVENT_ID1);
  wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID4);
}

extern "C"  __global__ __aicore__ void vmain_mix_aic(uint64_t ffts_addr, uint64_t entry) {
  __gm__ uint64_t * body_addr = (__gm__ uint64_t*)(get_para_base()) + 2;
  if (entry & V_ENTRY_FLAG_EXTERN_CODE) {
    __gm__ uint64_t *ext_addr = reinterpret_cast<__gm__ uint64_t*>(ffts_addr);
    ffts_addr = *ext_addr;
    body_addr = ext_addr + 2;
  }
  uint64_t ktype = entry & V_ENTRY_MASK_TYPE;
  if (ktype >= V_ENTRY_TYPE_C) {
    set_ffts_base_addr(ffts_addr);
    __gm__ vCubeOp *__restrict__ op = reinterpret_cast<__gm__ vCubeOp*>(body_addr);
    uint64_t flags = op->flags;
    uint64_t tile_num = entry >> V_ENTRY_M_GROUP_NUM_OFFSET;
    // Clear backsync area
    if (flags & V_CUBE_FLAG_PEER_STORE) {
      __gm__ int32_t *peer_mem =
        (__gm__ int32_t *)((__gm__ uint8_t *)op->gm_c + PEERMEM_ATOMIC_OFFSET + block_idx * CACHE_LINE_SIZE);
      __gm__ int32_t *peer_mem2 = (__gm__ int32_t *)((__gm__ uint8_t *)op->gm_c + PEERMEM_ATOMIC_OFFSET +
                                                     (block_idx + block_num) * CACHE_LINE_SIZE);
      *peer_mem = 0;
      dcci(peer_mem, 0);
      *peer_mem2 = 0;
      dcci(peer_mem2, 0);
      set_flag(PIPE_S, PIPE_FIX, EVENT_ID0);
      wait_flag(PIPE_S, PIPE_FIX, EVENT_ID0);
    }
    if (block_idx < tile_num) {
      switch (op->flags >> V_CUBE_FLAG_DTYPE_OFFSET) {
        case vCubeOp::FP16:
          CutMKN<half>(op, tile_num);
          break;
        case vCubeOp::BF16:
          CutMKN<bfloat16_t>(op, tile_num);
          break;
        default: break;
      }
    } else {
      if (flags & V_CUBE_FLAG_GROUP_SET) {
        ffts_cross_core_sync(PIPE_FIX, vFftsSyncConfig(2, 0));
      }
    }
  }
  pipe_barrier(PIPE_ALL);
}
