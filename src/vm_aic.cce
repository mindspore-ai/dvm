#define _CCE_KERNEL_
#include "isa.h"

#define __aicore__ [aicore]

template <typename T>
__aicore_inline__ void Swap(T &x, T &y) {
  T t = x;
  x = y;
  y = t;
}

#define __force_inline__ inline __attribute__((always_inline))

constexpr uint32_t L0_PINGPONG_BUFFER_LEN = 16384;
constexpr uint32_t L1_PINGPONG_BUFFER_LEN = 131072;

template <typename T>
class MatMul {
 public:
  __aicore__ MatMul(__gm__ vCubeOp *op) {
    m = op->m;
    n = op->n;
    k = op->k;
    m0 = op->m0;
    n0 = op->n0;
    k0 = op->k0;
  }

  __force_inline__ __aicore__ void LoadA(__cbuf__ T *dst, __gm__ T *src, int64_t midx, int64_t kidx) {
  }

  __force_inline__ __aicore__ void LoadB(__cbuf__ T *dst, __gm__ T *src, int64_t kidx, int64_t nidx) {
  }

  __force_inline__ __aicore__ void LoadL0A(__ca__ T *dst, __cbuf__ T *src, int64_t k_part) {
  }

  __force_inline__ __aicore__ void LoadL0B(__cb__ T *dst, __cbuf__ T *src, int64_t k_part) {
  }

  __force_inline__ __aicore__ void Mad(__cc__ float *c, __ca__ T *a, __cb__ T *b, bool init_c) {
  }

  __force_inline__ __aicore__ void StoreC(__gm__ T *dst, __cc__ float *c, int64_t midx, int64_t nidx) {
  }

  __force_inline__ __aicore__ void TileMap(uint32_t tile, int64_t &midx, int64_t &nidx) {
    midx = 0;
    nidx = 0;
  }

 private:
  uint64_t m, n, k;
  uint64_t m0, n0, k0;
};

template <typename M, typename T>
__aicore_inline__ void CutMKN(__gm__ vCubeOp *op, uint64_t tile_begin, uint64_t tile_end) {
  M mat(op);
  uint64_t batch_offset = 0;
  __gm__ T *gm_a = reinterpret_cast<__gm__ T*>(op->gm_a + batch_offset);
  __gm__ T *gm_b = reinterpret_cast<__gm__ T*>(op->gm_b + batch_offset);
  __gm__ T *gm_c = reinterpret_cast<__gm__ T*>(op->gm_c + batch_offset);
  __cbuf__ T *l1a = reinterpret_cast<__cbuf__ T*>(0);
  __cbuf__ T *l1b = reinterpret_cast<__cbuf__ T*>((op->m0 * op->k0 * sizeof(T) + 512 - 1) / 512 * 512);
  __cbuf__ T *n_l1a = reinterpret_cast<__cbuf__ T*>(L1_PINGPONG_BUFFER_LEN);
  __cbuf__ T *n_l1b = reinterpret_cast<__cbuf__ T*>(l1b + L1_PINGPONG_BUFFER_LEN / sizeof(T));
  int64_t k_loop = op->k / op->k0;
  int64_t mn_max = op->m > op->n ? op->m : op->n;
  int64_t k_part_loop = L0_PINGPONG_BUFFER_LEN / mn_max / 16 * 16;
  int64_t pingpong = 0;
  //if (op->forward_fusion) { wait_flag_dev(flag_id); }
  int64_t midx, nidx;
  mat.TileMap(0, midx, nidx);
  mat.LoadA(l1a, gm_a, midx, 0);
  mat.LoadB(l1b, gm_b, 0, nidx);
  set_flag(PIPE_MTE2, PIPE_MTE1, pingpong);
  set_flag(PIPE_MTE1, PIPE_MTE2, pingpong);
  for (uint64_t tile = tile_begin; tile <= tile_end; ++tile) {
    __cc__ float *l0c = reinterpret_cast<__cc__ float *>((uintptr_t)0);
    for (uint64_t k = 0; k < k_loop; ++k) {
      if (k < k_loop - 1) {
        mat.LoadA(n_l1a, gm_a, midx, k);
        mat.LoadB(n_l1b, gm_b, k, nidx);
      } else if (tile < tile_end) {
        int64_t n_midx, n_nidx;
        mat.TileMap(tile + 1, n_midx, n_nidx);
        mat.LoadA(n_l1a, gm_a, n_midx, 0);
        mat.LoadB(n_l1b, gm_b, 0, n_nidx);
      }
      set_flag(PIPE_MTE2, PIPE_MTE1, (pingpong + 1) & 1ul);
      wait_flag(PIPE_MTE2, PIPE_MTE1, pingpong);
      for (int64_t k_part = 0; k_part < k_part_loop; ++k_part) { // TODO: double buffer
        __ca__ T *l0a = 0;
        __cb__ T *l0b = 0;
        mat.LoadL0A(l0a, l1a, k_part);
        mat.LoadL0B(l0b, l1b, k_part);
        set_flag(PIPE_MTE1, PIPE_M, EVENT_ID0);
        wait_flag(PIPE_MTE1, PIPE_M, EVENT_ID0);
        mat.Mad(l0c, l0a, l0b, k == 0 && k_part == 0);
        set_flag(PIPE_M, PIPE_MTE1, EVENT_ID0);
        wait_flag(PIPE_M, PIPE_MTE1, EVENT_ID0);
      }
      set_flag(PIPE_MTE1, PIPE_MTE2, (pingpong + 1) & 1);
      wait_flag(PIPE_MTE1, PIPE_MTE2, pingpong);
      pingpong = (pingpong + 1) & 1ul;
      Swap(l1a, n_l1a);
      Swap(l1b, n_l1b);
    }
    set_flag(PIPE_M, PIPE_FIX, EVENT_ID0);
    wait_flag(PIPE_M, PIPE_FIX, EVENT_ID0);
    mat.StoreC(gm_c, l0c, midx, nidx);
    set_flag(PIPE_FIX, PIPE_M, EVENT_ID0);
    wait_flag(PIPE_FIX, PIPE_M, EVENT_ID0);
    //if (op->post_fusion) { ffts_cross_core_sync(MTE3, inner_group);}
  }
  wait_flag(PIPE_MTE2, PIPE_MTE1, pingpong);
  wait_flag(PIPE_MTE1, PIPE_MTE2, pingpong);
}

extern "C"  __global__ [aicore] void vmain_mix_aic(uint64_t config) {
  __gm__ uint8_t * base_addr = (__gm__ uint8_t*)(get_para_base());
  if (config == 0) { // only for compile
    uint64_t last_tile = config >> 40;
    uint64_t tile_per_block = (last_tile + block_num) / block_num;
    uint64_t tile_start = tile_per_block * block_idx;
    uint64_t tile_end = tile_start + tile_per_block - 1;
    if (tile_end >= last_tile) {
      tile_end = last_tile;
    }
    __gm__ vCubeOp *op = reinterpret_cast<__gm__ vCubeOp*>(base_addr + sizeof(uint64_t));
    CutMKN<MatMul<half>, half>(op, tile_start, tile_end);
  }
  pipe_barrier(PIPE_ALL);
}
