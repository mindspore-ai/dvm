__aicore_inline__ void repeat_vcadd(__ubuf__ float *dst, __ubuf__ float *src, uint16_t repeat, uint16_t dstRepeatStride,
                                    uint16_t srcRepeatStride) {
  for (; repeat > 255; repeat -= 255) {
    vCAdd(dst, src, 255, dstRepeatStride, srcRepeatStride);
    dst += 255 * dstRepeatStride;
    src += 255 * TYPE_SHIFT(float) * srcRepeatStride;
  }
  vCAdd(dst, src, repeat, dstRepeatStride, srcRepeatStride);
}

template <typename T>
__aicore_inline__ void repeat_select_2(__ubuf__ T *dst, __ubuf__ T *src0, __ubuf__ T *src1, uint16_t repeat,
                                       uint8_t repeatStride, uint64_t cond_addr) {
  __ubuf__ uint32_t *wk = (__ubuf__ uint32_t *)(WORKSPACE);
  uint64_t simd_width = TYPE_SHIFT(T) * repeatStride;
  for (; repeat > 255; repeat -= 255) {
    set_flag(PIPE_V, PIPE_S, EVENT_ID0);
    wait_flag(PIPE_V, PIPE_S, EVENT_ID0);
    *wk = cond_addr;
    set_flag(PIPE_S, PIPE_V, EVENT_ID0);
    wait_flag(PIPE_S, PIPE_V, EVENT_ID0);
    set_cmpmask((__ubuf__ void *)(wk));
    pipe_barrier(PIPE_V);
    vSel(dst, src0, src1, 255, repeatStride, 2);
    dst += 255 * simd_width;
    src0 += 255 * simd_width;
    src1 += 255 * simd_width;
    cond_addr += 255 * 32 * repeatStride;
  }
  set_flag(PIPE_V, PIPE_S, EVENT_ID0);
  wait_flag(PIPE_V, PIPE_S, EVENT_ID0);
  *wk = cond_addr;
  set_flag(PIPE_S, PIPE_V, EVENT_ID0);
  wait_flag(PIPE_S, PIPE_V, EVENT_ID0);
  set_cmpmask((__ubuf__ void *)(wk));
  pipe_barrier(PIPE_V);
  vSel(dst, src0, src1, repeat, repeatStride, 2);
}

#define DELCARE_BINARY(builtin, VTYPE)                                                                          \
  static inline[aicore] void repeat_##builtin(__ubuf__ VTYPE *dst, __ubuf__ VTYPE *src0, __ubuf__ VTYPE *src1,  \
                                              uint16_t repeat, uint8_t dstBlockStride, uint8_t src0BlockStride, \
                                              uint8_t src1BlockStride, uint8_t dstRepeatStride,                 \
                                              uint8_t src0RepeatStride, uint8_t src1RepeatStride) {             \
    for (; repeat > 255; repeat -= 255) {                                                                       \
      builtin(dst, src0, src1, 255, dstBlockStride, src0BlockStride, src1BlockStride, dstRepeatStride,          \
              src0RepeatStride, src1RepeatStride);                                                              \
      dst += 255 * TYPE_SHIFT(VTYPE) * dstRepeatStride;                                                         \
      src0 += 255 * TYPE_SHIFT(VTYPE) * src0RepeatStride;                                                       \
      src1 += 255 * TYPE_SHIFT(VTYPE) * src1RepeatStride;                                                       \
    }                                                                                                           \
    builtin(dst, src0, src1, repeat, dstBlockStride, src0BlockStride, src1BlockStride, dstRepeatStride,         \
            src0RepeatStride, src1RepeatStride);                                                                \
  }

#define DELCARE_BINARYS(builtin, VTYPE)                                                                             \
  static inline[aicore] void repeat_##builtin(__ubuf__ VTYPE *dst, __ubuf__ VTYPE *src, VTYPE val, uint16_t repeat, \
                                              uint16_t dstBlockStride, uint16_t srcBlockStride,                     \
                                              uint16_t dstRepeatStride, uint16_t srcRepeatStride) {                 \
    for (; repeat > 255; repeat -= 255) {                                                                           \
      builtin(dst, src, val, 255, dstBlockStride, srcBlockStride, dstRepeatStride, srcRepeatStride);                \
      dst += 255 * TYPE_SHIFT(VTYPE) * dstRepeatStride;                                                             \
      src += 255 * TYPE_SHIFT(VTYPE) * srcRepeatStride;                                                             \
    }                                                                                                               \
    builtin(dst, src, val, repeat, dstBlockStride, srcBlockStride, dstRepeatStride, srcRepeatStride);               \
  }

#define DELCARE_BINARYS_WITH_MODE(builtin, VTYPE, mode)                                                             \
  static inline[aicore] void repeat_##builtin(__ubuf__ VTYPE *dst, __ubuf__ VTYPE *src, VTYPE val, uint16_t repeat, \
                                              uint16_t dstBlockStride, uint16_t srcBlockStride,                     \
                                              uint16_t dstRepeatStride, uint16_t srcRepeatStride) {                 \
    for (; repeat > 255; repeat -= 255) {                                                                           \
      builtin(dst, src, val, 255, dstBlockStride, srcBlockStride, dstRepeatStride, srcRepeatStride, mode);          \
      dst += 255 * TYPE_SHIFT(VTYPE) * dstRepeatStride;                                                             \
      src += 255 * TYPE_SHIFT(VTYPE) * srcRepeatStride;                                                             \
    }                                                                                                               \
    builtin(dst, src, val, repeat, dstBlockStride, srcBlockStride, dstRepeatStride, srcRepeatStride, mode);         \
  }

#define DELCARE_UNARYS(builtin, VTYPE)                                                              \
