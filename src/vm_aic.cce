#define _CCE_KERNEL_
#include "isa.h"

#define __aicore__ [aicore]

template <typename T>
__aicore_inline__ void Swap(T &x, T &y) {
  T t = x;
  x = y;
  y = t;
}

__aicore_inline__ uint64_t RoundUp(uint64_t val, uint64_t rnd) { return (val + rnd - 1) / rnd * rnd; }
__aicore_inline__ uint64_t CeilDiv(uint64_t val, uint64_t rnd) { return (val + rnd - 1) / rnd; }

#define __force_inline__ inline __attribute__((always_inline))

constexpr uint32_t L0_PINGPONG_BUFFER_LEN = 16384;
constexpr uint32_t L1_PINGPONG_BUFFER_LEN = 131072;
constexpr uint32_t L0_PINGPONG_BUFFER_SIZE = 32768;   // 64KB / 2
constexpr uint32_t L1_PINGPONG_BUFFER_SIZE = 262144;  // 512KB / 2
constexpr uint64_t BIAS_ADDR = 0;
constexpr int32_t BLOCK_SIZE = 16;

// TODO: only support fp16/bf16 now
template <typename T>
class MatMul {
 public:
  __aicore__ MatMul(__gm__ vCubeOp *__restrict__ op) {
    m_real = op->m_real;
    n_real = op->n_real;
    k_real = op->k_real;
    m_align = op->m_align;
    n_align = op->n_align;
    k_align = op->k_align;
    batch_a0 = op->batch_a0;
    batch_a1 = op->batch_a1;
    batch_b0 = op->batch_b0;
    batch_b1 = op->batch_b1;
    a_size = op->a_size;
    b_size = op->b_size;
    batch_c0 = batch_a0 > batch_b0 ? batch_a0 : batch_b0;
    batch_c1 = batch_a1 > batch_b1 ? batch_a1 : batch_b1;
    m0 = op->m0;
    n0 = op->n0;
    k0 = op->k0;
    flags = op->flags;
    bias_type_size = (flags & V_CUBE_FLAG_BIAS_FP16) ? sizeof(half) : sizeof(float);
    swizzle_dir = op->swizzle >> 16;
    swizzle_cnt = op->swizzle & 0xffff;
    int64_t mn_max = m0 > n0 ? m0 : n0;
    k0_part_len = min((uint64_t)(L0_PINGPONG_BUFFER_LEN / mn_max / 16 * 16), k0);
    m_loop = (m_real + m0 - 1) / m0;
    n_loop = (n_real + n0 - 1) / n0;
    k_loop = (k_real + k0 - 1) / k0;
  }

  __force_inline__ __aicore__ void LoadA(__cbuf__ T *__restrict__ dst,
                                         __gm__ T *__restrict__ src,
                                         int64_t midx,
                                         int64_t kidx,
                                         int64_t m_actual,
                                         int64_t k_actual) {
    // load GM to L1: ND -> zN
    bool transpose_a = flags & V_CUBE_FLAG_TRANS_A;
    uint64_t offset_a = transpose_a ? (kidx * k0 * m_align + midx * m0) : (midx * m0 * k_align + kidx * k0);
    if (m_actual == 1 && !transpose_a) {
      // GEMV mode
      copy_gm_to_cbuf(dst, src + offset_a, 0, 1, RoundUp(k_actual, BLOCK_SIZE) / BLOCK_SIZE, 0, 0, PAD_NONE);
    } else {
      if (transpose_a) {
        copy_gm_to_cbuf_multi_nd2nz_b16(
          dst,
          src + offset_a,
          0,                                                                         // sid
          1,                                                                         // ndNum
          k_actual,                                                                  // nValue
          m_actual,                                                                  // dValue
          0,                                                                         // srcNdMatrixStride, unused if nd_num=1
          m_align,                                                                   // srcDValue
          RoundUp(k_actual, BLOCK_SIZE),                                             // dstNzC0Stride
          1,                                                                         // dstNzNStride
          0                                                                          // dstNzMatrixStride, unused if nd_num=1
        );
      } else {
        copy_gm_to_cbuf_multi_nd2nz_b16(
          dst,
          src + offset_a,
          0,                                                                         // sid
          1,                                                                         // ndNum
          m_actual,                                                                  // nValue
          k_actual,                                                                  // dValue
          0,                                                                         // srcNdMatrixStride, unused if nd_num=1
          k_align,                                                                   // srcDValue
          RoundUp(m_actual, BLOCK_SIZE),                                             // dstNzC0Stride
          1,                                                                         // dstNzNStride
          0                                                                          // dstNzMatrixStride, unused if nd_num=1
        );
      }
    }
  }

  __force_inline__ __aicore__ void LoadB(__cbuf__ T *__restrict__ dst,
                                         __gm__ T *__restrict__ src,
                                         int64_t kidx,
                                         int64_t nidx,
                                         int64_t k_actual,
                                         int64_t n_actual) {
    // load GM to L1: ND -> zN
    if (flags & V_CUBE_FLAG_TRANS_B) {
      copy_gm_to_cbuf_multi_nd2nz_b16(
        dst,
        src + nidx * n0 * k_align + kidx * k0,
        0,                                                                           // sid
        1,                                                                           // ndNum
        n_actual,                                                                    // nValue
        k_actual,                                                                    // dValue
        0,                                                                           // srcNdMatrixStride, unused if nd_num=1
        k_align,                                                                     // srcDValue
        RoundUp(n_actual, BLOCK_SIZE),                                               // dstNzC0Stride
        1,                                                                           // dstNzNStride
        0                                                                            // dstNzMatrixStride, unused if nd_num=1
      );
    } else {
      copy_gm_to_cbuf_multi_nd2nz_b16(
        dst,
        src + kidx * k0 * n_align + nidx * n0,
        0,                                                                           // sid
        1,                                                                           // ndNum
        k_actual,                                                                    // nValue
        n_actual,                                                                    // dValue
        0,                                                                           // srcNdMatrixStride, unused if nd_num=1
        n_align,                                                                     // srcDValue
        RoundUp(k_actual, BLOCK_SIZE),                                               // dstNzC0Stride
        1,                                                                           // dstNzNStride
        0                                                                            // dstNzMatrixStride, unused if nd_num=1
      );
    }
  }

  __force_inline__ __aicore__ void LoadL0A(__ca__ T *__restrict__ dst,
                                           __cbuf__ T *__restrict__ src,
                                           int64_t total_k,
                                           int64_t k_part_idx,
                                           int64_t k_round,
                                           int64_t k0_round,
                                           int64_t m_actual) {
    // load L1 to L0A: zN -> zZ
    int64_t m_round = RoundUp(m_actual, BLOCK_SIZE);
    // GEMV mode
    if ((m_actual == 1 && !(flags & V_CUBE_FLAG_TRANS_A))) {
      load_cbuf_to_ca(
        dst,
        src + k_part_idx * k0_part_len,
        0,
        (k0_round + BLOCK_SIZE * BLOCK_SIZE - 1) / (BLOCK_SIZE * BLOCK_SIZE),
        1,
        0,
        0,
        false,
        inc);
    } else {
      if (flags & V_CUBE_FLAG_TRANS_A) {
        for (size_t i = 0; i < m_round / BLOCK_SIZE; i++) {
          load_cbuf_to_ca(
            dst + i * BLOCK_SIZE * k0_round,
            src + i * k_round * BLOCK_SIZE + k0_part_len * k_part_idx * BLOCK_SIZE,
            0,
            k0_round / BLOCK_SIZE,           // repeat: number of fractal
            1,                               // srcstride: number of fractal
            0,                               // dststride: number of fractal
            0,
            true,                            // transpose
            inc);
        }
      } else {
        for (size_t i = 0; i < m_round / BLOCK_SIZE; i++) {
          load_cbuf_to_ca(
            dst + i * BLOCK_SIZE * k0_round,
            src + m_round * k0_part_len * k_part_idx + i * BLOCK_SIZE * BLOCK_SIZE,
            0,
            k0_round / BLOCK_SIZE,           // repeat: number of fractal
            m_round / BLOCK_SIZE,            // srcstride: number of fractal
            0,                               // dststride: number of fractal
            0,
            false,                           // transpose
            inc);
        }
      }
    }
  }

  __force_inline__ __aicore__ void LoadL0B(__cb__ T *__restrict__ dst,
                                           __cbuf__ T *__restrict__ src,
                                           int64_t total_k,
                                           int64_t k_part_idx,
                                           int64_t k_round,
                                           int64_t k0_round,
                                           int64_t n_actual) {
    // load L1 to L0A: zN -> nZ
    int64_t n_round = RoundUp(n_actual, BLOCK_SIZE);
    if (flags & V_CUBE_FLAG_TRANS_B) {
      load_cbuf_to_cb(
        dst,
        src + k_part_idx * k0_part_len * n_round,
        0,
        k0_round * n_round / BLOCK_SIZE / BLOCK_SIZE, // repeat: number of fractal
        1,                                 // srcStride: number of fractal
        0,                                 // dstStride: number of fractal
        0,
        false,                             // transpose
        inc);
    } else {
      for (size_t i = 0; i < k0_round / BLOCK_SIZE; i++) {
        load_cbuf_to_cb(
          dst + i * BLOCK_SIZE * n_round,
          src + (k0_part_len * k_part_idx + i * BLOCK_SIZE) * BLOCK_SIZE,
          0,
          n_round / BLOCK_SIZE,                 // repeat: number of fractal
          k_round / BLOCK_SIZE,                 // srcStride: number of fractal
          0,                               // dstStride: number of fractal
          0,
          true,                            // transpose
          inc);
      }
    }
  }

  __force_inline__ __aicore__ void MM(__cc__ float *__restrict__ c,
                                       __ca__ T *__restrict__ a,
                                       __cb__ T *__restrict__ b,
                                       bool init_c,
                                       uint8_t unit_flag,
                                       int64_t m_actual,
                                       int64_t n_actual,
                                       int64_t k0_actual) {
    bool special_handle_req = (m_real != 1 && m_actual == 1 && (flags & V_CUBE_FLAG_TRANS_A));
    mad(
      c,
      a,
      b,
      special_handle_req ? 16 : m_actual,     // m
      k0_actual,                              // k
      n_actual,                               // n
      unit_flag,                              // unitFlag
      0,                                      // kDirectionAlign
      0,                                      // cmatrixSource
      init_c                                  // cmatrixInitVal
    );
  }

  __force_inline__ __aicore__ void LoadBias(__cbuf__ void *__restrict__ dst,
                                            __gm__ void *__restrict__ src,
                                            int64_t n_actual) {
    copy_gm_to_cbuf(
      dst,                                // dst
      src,                                // src
      0,                                  // sid
      1,                                  // nBurst
      CeilDiv(n_actual * bias_type_size, 32),  // lenBurst
      0,                                  // srcGap
      0,                                  // dstGap
      PAD_NONE                            // padMode
    );
  }

  __force_inline__ __aicore__ void LoadBt(uint64_t dst, __cbuf__ void *__restrict__ src, int64_t n_actual) {
    copy_cbuf_to_bt(
      dst,                                      // dst
      src,                                      // src
      (flags & V_CUBE_FLAG_BIAS_FP16) ? 1 : 0,  // convControl
      1,                                        // nBurst
      CeilDiv(n_actual * bias_type_size, 64),   // lenBurst
      0,                                        // srcGap
      0                                         // dstGap
    );
  }

  __force_inline__ __aicore__ void MAD(__cc__ float *__restrict__ c, 
                                        __ca__ T *__restrict__ a, 
                                        __cb__ T *__restrict__ b, 
                                        bool init_c, 
                                        uint8_t unit_flag, 
                                        int64_t m_actual, 
                                        int64_t n_actual,
                                        int64_t k0_actual) {
    bool special_handle_req = (m_real != 1 && m_actual == 1 && (flags & V_CUBE_FLAG_TRANS_A));
    mad(
      c,
      a,
      b,
      BIAS_ADDR,
      special_handle_req ? 16 : m_actual,     // m
      k0_actual,                              // k
      n_actual,                               // n
      unit_flag,                              // unitFlag
      0,                                      // kDirectionAlign
      1,                                      // cmatrixSource
      0                                       // cmatrixInitVal
    );
  }

  template <typename S>
  struct QuantPRE {};

  template <>
  struct QuantPRE<half> {
    static constexpr QuantMode_t type = F322F16;
  };

  template <>
  struct QuantPRE<bfloat16_t> {
    static constexpr QuantMode_t type = F322BF16;
  };

  __force_inline__ __aicore__ void StoreC_Fp32(__gm__ float *__restrict__ dst,
                                               __cc__ float *__restrict__ c,
                                               int64_t midx,
                                               int64_t nidx,
                                               uint8_t unit_flag,
                                               int64_t m_actual,
                                               int64_t n_actual) {
    copy_matrix_cc_to_gm(
      dst + midx * m0 * n_real + nidx * n0,        // dst
      c,                                      // src
      0,                                      // sid
      n_actual,                               // NSize
      m_actual,                               // MSize
      n_real,                                 // dstStride_dst_D
      RoundUp(m_actual, BLOCK_SIZE),          // srcStride
      unit_flag,                              // UnitFlagMode
      NoQuant,                                // QuantPRE
      0,                                      // ReLUPRE
      false,                                  // channelSplit
      true                                    // NZ2ND_EN
    );
  }

  __force_inline__ __aicore__ void StoreC(__gm__ T *__restrict__ dst,
                                          __cc__ float *__restrict__ c,
                                          int64_t midx,
                                          int64_t nidx,
                                          uint8_t unit_flag,
                                          int64_t m_actual,
                                          int64_t n_actual) {
    copy_matrix_cc_to_gm(
      dst + midx * m0 * n_real + nidx * n0,        // dst
      c,                                      // src
      0,                                      // sid
      n_actual,                               // NSize
      m_actual,                               // MSize
      n_real,                                 // dstStride_dst_D
      RoundUp(m_actual, BLOCK_SIZE),          // srcStride
      unit_flag,                              // UnitFlagMode
      (QuantMode_t)QuantPRE<T>::type,         // QuantPRE
      0,                                      // ReLUPRE
      false,                                  // channelSplit
      true                                    // NZ2ND_EN
    );
  }

  __force_inline__ __aicore__ void StoreC_PingPong(__gm__ T *__restrict__ dst,
                                          __cc__ float *__restrict__ c,
                                          uint8_t unit_flag,
                                          int64_t m_actual,
                                          int64_t n_actual) {
    int64_t pingpong_offset = pingpong_store ? block_num + block_idx : block_idx;
    pingpong_store ^= 0x1u;
    copy_matrix_cc_to_gm(
      dst + m0 * n0 * pingpong_offset,        // dst
      c,                                      // src
      0,                                      // sid
      n_actual,                               // NSize
      m_actual,                               // MSize
      n0,                               // dstStride_dst_D
      RoundUp(m_actual, BLOCK_SIZE),          // srcStride
      unit_flag,                              // UnitFlagMode
      (QuantMode_t)QuantPRE<T>::type,         // QuantPRE
      0,                                      // ReLUPRE
      false,                                  // channelSplit
      true                                    // NZ2ND_EN
    );
  }

  // Compute global memory offset of matrix A and B based on batch idx of matrix C
  __force_inline__ __aicore__ void ComputeOffset(uint64_t c_idx, uint64_t &offset_a, uint64_t &offset_b) {
    uint64_t c_idx0 = c_idx / batch_c1;
    uint64_t c_idx1 = c_idx - c_idx0 * batch_c1;
    uint64_t a_idx0 = c_idx0 >= batch_a0 ? batch_a0 - 1 : c_idx0;
    uint64_t a_idx1 = c_idx1 >= batch_a1 ? batch_a1 - 1 : c_idx1;
    uint64_t b_idx0 = c_idx0 >= batch_b0 ? batch_b0 - 1 : c_idx0;
    uint64_t b_idx1 = c_idx1 >= batch_b1 ? batch_b1 - 1 : c_idx1;
    uint64_t a_idx = a_idx0 * batch_a1 + a_idx1;
    uint64_t b_idx = b_idx0 * batch_b1 + b_idx1;
    offset_a = a_idx * a_size;
    offset_b = b_idx * b_size;
  }

  uint64_t n_loop, m_loop, k_loop;
  uint64_t k0_part_len;
  uint64_t m_real, n_real, k_real;
  uint64_t m_align, n_align, k_align;
  uint64_t batch_a0, batch_a1, batch_b0, batch_b1, batch_c0, batch_c1;
  uint64_t m0, n0, k0;
  uint64_t swizzle_dir;
  uint64_t swizzle_cnt;
  uint64_t a_size;
  uint64_t b_size;
  uint64_t bias_type_size;
  uint32_t flags;
  uint32_t pingpong_store{0};
};

template <typename M, typename T>
__aicore_inline__ void CutMKN(__gm__ vCubeOp *__restrict__ op, uint64_t tile_end) {
  set_padding((uint64_t)0);
  uint64_t config = 0x1;
  set_nd_para(config);
  M mat(op);
  if (mat.flags & V_CUBE_FLAG_ATOMIC_ADD) {
    set_atomic_add();
    set_atomic_f32();
  } else {
    set_atomic_none();
  }
  __gm__ T *__restrict__ gm_a = reinterpret_cast<__gm__ T*>(op->gm_a) + op->offset_a;
  __gm__ T *__restrict__ gm_b = reinterpret_cast<__gm__ T*>(op->gm_b) + op->offset_b;
  __gm__ T *__restrict__ gm_c = reinterpret_cast<__gm__ T*>(op->gm_c);
  __gm__ uint8_t *__restrict__ gm_bias = reinterpret_cast<__gm__ uint8_t*>(op->gm_bias);
  uint64_t offset_mk = RoundUp(op->m0 * op->k0 * sizeof(T), 256);  // TODO: int8 is 512
  uint64_t offset_nk = RoundUp(op->n0 * op->k0 * sizeof(T), 256);  // TODO: int8 is 512
  __cbuf__ T *__restrict__ l1a = reinterpret_cast<__cbuf__ T*>(0);
  __cbuf__ T *__restrict__ l1b = reinterpret_cast<__cbuf__ T*>(offset_mk);
  __cbuf__ T *__restrict__ n_l1a = reinterpret_cast<__cbuf__ T*>(L1_PINGPONG_BUFFER_SIZE);
  __cbuf__ T *__restrict__ n_l1b = reinterpret_cast<__cbuf__ T*>(L1_PINGPONG_BUFFER_SIZE + offset_mk);
  __cbuf__ void *__restrict__ bias_l1 = reinterpret_cast<__cbuf__ void*>(L1_PINGPONG_BUFFER_SIZE + offset_mk + offset_nk);
  __ca__ T *__restrict__ l0a_base = reinterpret_cast<__ca__ T*>(0);
  __cb__ T *__restrict__ l0b_base = reinterpret_cast<__cb__ T*>(0);
  __ca__ T *__restrict__ l0a_next = reinterpret_cast<__ca__ T*>(L0_PINGPONG_BUFFER_SIZE);
  __cb__ T *__restrict__ l0b_next = reinterpret_cast<__cb__ T*>(L0_PINGPONG_BUFFER_SIZE);
  int64_t pingpong = 1;
  int64_t last_midx = -1;
  int64_t last_nidx = -1;
  //if (op->forward_fusion) { wait_flag_dev(flag_id); }
  set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
  set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID1);
  set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID2);
  set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID3);
  set_flag(PIPE_M, PIPE_MTE1, EVENT_ID0);
  set_flag(PIPE_M, PIPE_MTE1, EVENT_ID1);
  set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID4);

  for (uint64_t tile = block_idx; tile < tile_end; tile += block_num) {
    __cc__ float *__restrict__ l0c = reinterpret_cast<__cc__ float *>((uintptr_t)0);
    uint64_t c_idx = tile / (mat.m_loop * mat.n_loop);
    uint64_t batch_offset = c_idx * mat.m_real * mat.n_real;
    uint64_t offset_a, offset_b;
    mat.ComputeOffset(c_idx, offset_a, offset_b);
    int64_t midx, nidx;
    vCubeOp::TileMap(tile, mat.m_loop, mat.n_loop, mat.swizzle_dir, mat.swizzle_cnt, midx, nidx);
    int64_t m_actual = (midx == (mat.m_loop - 1)) ? (mat.m_real - midx * mat.m0) : mat.m0;
    int64_t n_actual = (nidx == (mat.n_loop - 1)) ? (mat.n_real - nidx * mat.n0) : mat.n0;
    int64_t shuffle_k = block_idx % mat.k_loop;
    int64_t k_actual = (shuffle_k == mat.k_loop - 1) ? (mat.k_real - shuffle_k * mat.k0) : mat.k0;
    if (tile == block_idx) {
      auto event_id = pingpong ? EVENT_ID0 : EVENT_ID1;
      wait_flag(PIPE_MTE1, PIPE_MTE2, event_id);
      mat.LoadA(l1a, gm_a + offset_a, midx, shuffle_k, m_actual, k_actual);
      set_flag(PIPE_MTE2, PIPE_MTE1, event_id);
      wait_flag(PIPE_MTE1, PIPE_MTE2, event_id + 2);
      mat.LoadB(l1b, gm_b + offset_b, shuffle_k, nidx, k_actual, n_actual);
      set_flag(PIPE_MTE2, PIPE_MTE1, event_id + 2);
    }
    if (mat.flags & V_CUBE_FLAG_WITH_BIAS) {
      wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID4);
      if (nidx != last_nidx) {
        mat.LoadBias(bias_l1, gm_bias + mat.bias_type_size * nidx * mat.n0, n_actual);
      }
      set_flag(PIPE_MTE2, PIPE_MTE1, EVENT_ID5);
    }
    for (uint64_t k = 0; k < mat.k_loop; ++k) {
      shuffle_k = (k + block_idx) % mat.k_loop;
      k_actual = (shuffle_k == mat.k_loop - 1) ? (mat.k_real - shuffle_k * mat.k0) : mat.k0;
      uint64_t k_round = RoundUp(k_actual, BLOCK_SIZE);
      uint64_t k_part_loop = (k_actual + mat.k0_part_len - 1) / mat.k0_part_len;
      auto event_id = pingpong ? EVENT_ID0 : EVENT_ID1;
      auto event_id_next = pingpong ? EVENT_ID1 : EVENT_ID0;
      if (k < mat.k_loop - 1) {
        int64_t shuffle_k_next = (block_idx + k + 1) % mat.k_loop;
        int64_t k_actual_next = (shuffle_k_next == mat.k_loop - 1) ? (mat.k_real - shuffle_k_next * mat.k0) : mat.k0;
        wait_flag(PIPE_MTE1, PIPE_MTE2, event_id_next);
        mat.LoadA(n_l1a, gm_a + offset_a, midx, shuffle_k_next, m_actual, k_actual_next);
        set_flag(PIPE_MTE2, PIPE_MTE1, event_id_next);
        wait_flag(PIPE_MTE1, PIPE_MTE2, event_id_next + 2);
        mat.LoadB(n_l1b, gm_b + offset_b, shuffle_k_next, nidx, k_actual_next, n_actual);
        set_flag(PIPE_MTE2, PIPE_MTE1, event_id_next + 2);
      } else if (tile + block_num < tile_end) {
        int64_t c_idx_n = (tile + block_num) / (mat.m_loop * mat.n_loop);
        mat.ComputeOffset(c_idx_n, offset_a, offset_b);
        int64_t n_midx, n_nidx;
        vCubeOp::TileMap(tile + block_num, mat.m_loop, mat.n_loop, mat.swizzle_dir, mat.swizzle_cnt, n_midx, n_nidx);
        int64_t m_actual_next = (n_midx == (mat.m_loop - 1)) ? (mat.m_real - n_midx * mat.m0) : mat.m0;
        int64_t n_actual_next = (n_nidx == (mat.n_loop - 1)) ? (mat.n_real - n_nidx * mat.n0) : mat.n0;
        int64_t shuffle_k_next = block_idx % mat.k_loop;
        int64_t k_actual_next = (shuffle_k_next == mat.k_loop - 1) ? (mat.k_real - shuffle_k_next * mat.k0) : mat.k0;
        bool load_a_flag = false;
        bool load_b_flag = false;
        if (mat.k_loop == 1 && tile >= block_num) {
          int64_t c_idx_n_last = (tile - block_num) / (mat.m_loop * mat.n_loop);
          uint64_t last_offset_a, last_offset_b;
          mat.ComputeOffset(c_idx_n_last, last_offset_a, last_offset_b);
          load_a_flag = (offset_a == last_offset_a && last_midx == n_midx);
          load_b_flag = (offset_b == last_offset_b && last_nidx == n_nidx);
        }
        wait_flag(PIPE_MTE1, PIPE_MTE2, event_id_next);
        if (!load_a_flag) {
          mat.LoadA(n_l1a, gm_a + offset_a, n_midx, shuffle_k_next, m_actual_next, k_actual_next);
        }
        set_flag(PIPE_MTE2, PIPE_MTE1, event_id_next);
        wait_flag(PIPE_MTE1, PIPE_MTE2, event_id_next + 2);
        if (!load_b_flag) {
          mat.LoadB(n_l1b, gm_b + offset_b, shuffle_k_next, n_nidx, k_actual_next, n_actual_next);
        }
        set_flag(PIPE_MTE2, PIPE_MTE1, event_id_next + 2);
      }
      for (int64_t k_part_idx = 0; k_part_idx < k_part_loop; ++k_part_idx) {
        __ca__ T *__restrict__ l0a = (k_part_idx & 1) ? l0a_next : l0a_base;
        __cb__ T *__restrict__ l0b = (k_part_idx & 1) ? l0b_next : l0b_base;
        int64_t k0_round = (k_part_idx == k_part_loop - 1) ? k_round - k_part_idx * mat.k0_part_len : mat.k0_part_len;
        int64_t k0_actual = (k_part_idx == k_part_loop - 1) ? k_actual - k_part_idx * mat.k0_part_len : mat.k0_part_len;
        auto mte1_mad_event_id = (k_part_idx & 1) ? EVENT_ID1 : EVENT_ID0;
        if (k_part_idx == 0) {
          wait_flag(PIPE_MTE2, PIPE_MTE1, event_id);
        }
        wait_flag(PIPE_M, PIPE_MTE1, mte1_mad_event_id);
        mat.LoadL0A(l0a, l1a, k_part_loop, k_part_idx, k_round, k0_round, m_actual);
        if (k_part_idx == k_part_loop - 1) {
          set_flag(PIPE_MTE1, PIPE_MTE2, event_id);
        }
        if (k_part_idx == 0) {
          wait_flag(PIPE_MTE2, PIPE_MTE1, event_id + 2);
        }
        mat.LoadL0B(l0b, l1b, k_part_loop, k_part_idx, k_round, k0_round, n_actual);
        if (k_part_idx == k_part_loop - 1) {
          set_flag(PIPE_MTE1, PIPE_MTE2, event_id + 2);
        }
        set_flag(PIPE_MTE1, PIPE_M, mte1_mad_event_id);
        wait_flag(PIPE_MTE1, PIPE_M, mte1_mad_event_id);
        bool init_c = (k == 0 && k_part_idx == 0);
        uint8_t unit_flag = 0b10;  // do not allow reading from L0C
        if (k == mat.k_loop - 1 && k_part_idx == k_part_loop - 1) {
          unit_flag = 0b11;  // allow reading from L0C
        }
        if ((mat.flags & V_CUBE_FLAG_WITH_BIAS) && init_c) {
          wait_flag(PIPE_MTE2, PIPE_MTE1, EVENT_ID5);
          if (nidx != last_nidx) {
            mat.LoadBt(BIAS_ADDR, bias_l1, n_actual);
          }
          set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID4);  // bias ready, mte2 can begin move A/B or scale
          set_flag(PIPE_MTE1, PIPE_M, EVENT_ID4);     // bias ready, mmad can begin
          wait_flag(PIPE_MTE1, PIPE_M, EVENT_ID4);    // wait move bias fron L1 to BT
          mat.MAD(l0c, l0a, l0b, init_c, unit_flag, m_actual, n_actual, k0_actual);
        } else{
          mat.MM(l0c, l0a, l0b, init_c, unit_flag, m_actual, n_actual, k0_actual);
        }
        pipe_barrier(PIPE_M);
        set_flag(PIPE_M, PIPE_MTE1, mte1_mad_event_id);
      }
      pingpong = pingpong ^ 1ul;
      Swap(l1a, n_l1a);
      Swap(l1b, n_l1b);
    }
    if ((mat.flags & V_CUBE_FLAG_GROUP_SET) && (tile > block_idx + block_num)) {
      wait_flag_dev(1);
    }
    uint8_t unit_flag = 0b11;
    if (mat.flags & V_CUBE_FLAG_PINGPONG_STORE) {
      mat.StoreC_PingPong(gm_c, l0c, unit_flag, m_actual, n_actual);
      if (mat.flags & V_CUBE_FLAG_PEER_STORE) {
        int64_t pingpong_offset = mat.pingpong_store ? block_idx : block_num + block_idx;
        // result of GetCubeOffset()
        uint32_t group_offset = midx * mat.m0 * mat.n_real + nidx * mat.n0;
        set_flag(PIPE_FIX, PIPE_S, EVENT_ID0);
        wait_flag(PIPE_FIX, PIPE_S, EVENT_ID0);
        __gm__ uint64_t *peer_flag_mem =
          (__gm__ uint64_t *)((__gm__ uint8_t *)gm_c + PEERMEM_FLAG_OFFSET + pingpong_offset * CACHE_LINE_SIZE);
        *peer_flag_mem = ((uint64_t)(op->unique_id) << 32) | (group_offset + 1);
        dcci(peer_flag_mem, 0);
      }
    } else if (mat.flags & V_CUBE_FLAG_OUT_FP32) {
      mat.StoreC_Fp32((__gm__ float *__restrict__)gm_c + batch_offset, l0c, midx, nidx, unit_flag, m_actual, n_actual);
    } else {
      mat.StoreC(gm_c + batch_offset, l0c, midx, nidx, unit_flag, m_actual, n_actual);
    }
    if (mat.flags & V_CUBE_FLAG_GROUP_SET) {
      ffts_cross_core_sync(PIPE_FIX, vFftsSyncConfig(2, 0));
    }
    last_midx = midx;
    last_nidx = nidx;
  }
  wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
  wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID1);
  wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID2);
  wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID3);
  wait_flag(PIPE_M, PIPE_MTE1, EVENT_ID0);
  wait_flag(PIPE_M, PIPE_MTE1, EVENT_ID1);
  wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID4);
  if ((mat.flags & V_CUBE_FLAG_GROUP_SET) && block_idx + block_num < tile_end) {
    wait_flag_dev(1);
  }
}

extern "C"  __global__ [aicore] void vmain_mix_aic(uint64_t ffts_addr, uint64_t entry) {
  __gm__ uint64_t * body_addr = (__gm__ uint64_t*)(get_para_base()) + 2;
  if (entry & V_ENTRY_FLAG_EXTERN_CODE) {
    __gm__ uint64_t *ext_addr = reinterpret_cast<__gm__ uint64_t*>(ffts_addr);
    ffts_addr = *ext_addr;
    body_addr = ext_addr + 2;
  }
  if (entry & V_ENTRY_FLAG_MIX) {
    set_ffts_base_addr(ffts_addr);
    __gm__ vCubeOp *__restrict__ op = reinterpret_cast<__gm__ vCubeOp*>(body_addr);
    uint64_t flags = op->flags;
    uint64_t tile_num = entry >> V_ENTRY_TILE_NUM_OFFSET;
    // Clear backsync area
    if (flags & V_CUBE_FLAG_PEER_STORE) {
      __gm__ int32_t *peer_mem =
        (__gm__ int32_t *)((__gm__ uint8_t *)op->gm_c + PEERMEM_ATOMIC_OFFSET + block_idx * CACHE_LINE_SIZE);
      __gm__ int32_t *peer_mem2 = (__gm__ int32_t *)((__gm__ uint8_t *)op->gm_c + PEERMEM_ATOMIC_OFFSET +
                                                     (block_idx + block_num) * CACHE_LINE_SIZE);
      *peer_mem = 0;
      dcci(peer_mem, 0);
      *peer_mem2 = 0;
      dcci(peer_mem2, 0);
      set_flag(PIPE_S, PIPE_FIX, EVENT_ID0);
      wait_flag(PIPE_S, PIPE_FIX, EVENT_ID0);
    }
    if (block_idx < tile_num) {
      switch (op->dtype) {
        case vCubeOp::FP16:
          CutMKN<MatMul<half>, half>(op, tile_num);
          break;
        case vCubeOp::BF16:
          CutMKN<MatMul<bfloat16_t>, bfloat16_t>(op, tile_num);
          break;
        default: break;
      }
    } else {
      if (flags & V_CUBE_FLAG_GROUP_SET) {
        ffts_cross_core_sync(PIPE_FIX, vFftsSyncConfig(2, 0));
      }
    }
  }
  pipe_barrier(PIPE_ALL);
}
