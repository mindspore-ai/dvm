  }

#define DELCARE_UNARY(builtin, VTYPE)                                                                    \
  static inline[aicore] void repeat_##builtin(__ubuf__ VTYPE *dst, __ubuf__ VTYPE *src, uint16_t repeat, \
                                              uint16_t dstBlockStride, uint16_t srcBlockStride,          \
                                              uint16_t dstRepeatStride, uint16_t srcRepeatStride) {      \
