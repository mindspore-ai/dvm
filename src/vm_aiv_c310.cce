#define _CCE_KERNEL_
#include "isa.h"

constexpr uint64_t UB_WORKSPACE_SIZE = 256;
constexpr uint64_t WORKSPACE = 256ul * 1024ul - UB_WORKSPACE_SIZE;

#define VREG_TABLE_BASE 0
#define PC_BASE 32

#define MASK_32 0xfffffffful
#define INVALID_INT  uint64_t(-1)

#define IS_FLOAT(x) (sizeof(*x) == 4)
#define SIMD_WIDTH_SHIFT(x) (IS_FLOAT(x) ? 3 : 4)
#define TYPE_SHIFT(x) (32 / sizeof(x))
#define BlockDataShift(x)  (5 - sizeof(x) / 2)   // 1B - 5, 2B - 4, 4B - 3, 8B - not support
#define BlockNum(x)  (256 / sizeof(x))   
#define MaxRepeat(num, x)  ((num + BlockNum(x) - 1) / BlockNum(x))   
#define ALIGN_UP(x, align)   (((x) + ((align) - 1)) & ~((align) - 1))
// tile format:
//  tile_idx(32) << 32 | tile_count(28) << 4 | skip_stride(1) << 3 | tail_flag(1) << 2 | end_flag(1) << 1 | not_begin_flag(1)
#define V_TILE_N_BEGIN_FLAG_OFFSET  0
#define V_TILE_END_FLAG_OFFSET      1
#define V_TILE_TAIL_FLAG_OFFSET     2
#define V_TILE_SKIP_FLAG_OFFSET     3
#define V_TILE_COUNT_OFFSET         4
#define V_TILE_CUR_IDX_OFFSET       32
#define V_TILE_COUNT_BITS           28

#define TileIdx(tile)         ((tile) >> V_TILE_CUR_IDX_OFFSET)
#define IsLastTile(tile)      (((tile) & 6ul) == 6ul)
#define IsBeginTile(tile)     ((tile & (1ul << V_TILE_N_BEGIN_FLAG_OFFSET)) == 0)
#define IsEndTile(tile)       ((tile) & (1ul << V_TILE_END_FLAG_OFFSET))
#define IsSkipTile(tile)      ((tile) & (1ul << V_TILE_SKIP_FLAG_OFFSET))

struct vRegTable {
  uint32_t blockidx;
  uint32_t blocknum;
  uint64_t reserved[3];
};

__aicore_inline__ void vBlockInit(uint64_t blockidx, uint64_t blocknum) {
  auto reg = (__ubuf__ uint64_t *)get_imm(VREG_TABLE_BASE);
  *reg = blocknum << 32 | blockidx;
}

__aicore_inline__ uint64_t vBlockIdx() {
  return reinterpret_cast<__ubuf__ const vRegTable *>(VREG_TABLE_BASE)->blockidx;
}

__aicore_inline__ uint64_t vBlockNum() {
  return reinterpret_cast<__ubuf__ const vRegTable *>(VREG_TABLE_BASE)->blocknum;
}

__aicore_inline__ uint64_t GetBlock(uint64_t stride, uint64_t type_size) {
  return (stride * type_size + 31) >> 5;
}

template <typename T>
__aicore_inline__ void SetInvalidMask(uint64_t simd_width, uint64_t simd_valid) {
  uint64_t lmask, rmask;
  if (sizeof(T) == 4) {
    uint64_t simd_mask = 0xffffffffffffffffllu >> (64 - simd_width);
    lmask = 0;
    rmask = simd_mask & (0xffffffffffffffffllu << simd_valid);
  } else if (sizeof(T) == 2) {
    if (simd_width > 64) {
      lmask = 0xffffffffffffffffllu >> (128 - simd_width);
      rmask = 0xffffffffffffffffllu;
    } else {
      lmask = 0;
      rmask = 0xffffffffffffffffllu >> (64 - simd_width);
    }
    if (simd_valid > 64) {
      lmask ^= 0xffffffffffffffffllu >> (128 - simd_valid);
      rmask ^= 0xffffffffffffffffllu;
    } else {
      rmask ^= 0xffffffffffffffffllu >> (64 - simd_valid);
    }
  }
  set_vector_mask(lmask, rmask);
}

__aicore_inline__ void SetVectorMask(uint64_t simd_width) {
  if (simd_width > 64) {
    set_vector_mask(0xffffffffffffffffllu >> (128 - simd_width), 0xffffffffffffffffllu);
  } else {
    set_vector_mask(0, 0xffffffffffffffffllu >> (64 - simd_width));
  }
}

#ifdef DEBUG
__aicore_inline__ void OVER_WRITE_CHECK(bcodeptr_t pc, uint64_t head, uint64_t write_end) {
  uint64_t debug_size = *(pc + (((head >> V_M_HEAD_SIZE_OFFSET) & V_M_HEAD_SIZE_MASK) - 1));
  if (write_end > debug_size) {
    trap();
  }
}
#else
#define OVER_WRITE_CHECK(pc, head, write_end)
#endif

template <typename T>
struct TypeGet;

#define DEF_TYPE_GET(stype, vtype) \
  template <>                      \
  struct TypeGet<stype> {          \
    using T = vtype;               \
  };

DEF_TYPE_GET(uint32_t, vector_u32)
DEF_TYPE_GET(int32_t, vector_s32)
DEF_TYPE_GET(uint16_t, vector_u16)
DEF_TYPE_GET(int16_t, vector_s16)
DEF_TYPE_GET(float, vector_f32)
DEF_TYPE_GET(half, vector_f16)
DEF_TYPE_GET(bfloat16_t, vector_bf16)
DEF_TYPE_GET(uint8_t, vector_u8)
DEF_TYPE_GET(int8_t, vector_s8)
DEF_TYPE_GET(bool, vector_s8)

template <typename T>
using RegTensor = typename TypeGet<T>::T;

using MaskReg = vector_bool;

template <size_t N>
struct SizeToUint;

template <>
struct SizeToUint<4> { using type = uint32_t; };

template <>
struct SizeToUint<2> { using type = uint16_t; };

template <typename T>
using UintFor = typename SizeToUint<sizeof(T)>::type;

template <typename T>
__aicore__ inline MaskReg UpdateMask(uint32_t &scalar) {
  MaskReg reg;
  if constexpr (sizeof(T) == 1) {
    reg = plt_b8(scalar, POST_UPDATE);
  } else if constexpr (sizeof(T) == 2) {
    reg = plt_b16(scalar, POST_UPDATE);
  } else if constexpr (sizeof(T) == 4) {
    reg = plt_b32(scalar, POST_UPDATE);
  }
  return reg;
}

template <typename T>
__aicore__ inline MaskReg MoveMask() {
  if constexpr (sizeof(T) == 2) {
    return movp_b16();
  } else if constexpr (sizeof(T) == 4) {
    return movp_b32();
  }
}

template <ROUND T>
constexpr __aicore_inline__ auto RoundValue() {
  return std::integral_constant<ROUND, T>();
}

template <typename T>
constexpr __aicore_inline__ DistVST DistSTValue() {
  if constexpr (sizeof(T) == 1) {
    return DistVST::DIST_NORM_B8;
  } else if constexpr (sizeof(T) == 2) {
    return DistVST::DIST_NORM_B16;
  }
  return DistVST::DIST_NORM_B32;
}

#define DECLARE_BINARY(builtin)                                                                                 \
  template <typename T>                                                                                         \
  __aicore_inline__ void builtin##_count(__ubuf__ T *dst, __ubuf__ T *src0, __ubuf__ T *src1, uint32_t count) { \
    __VEC_SCOPE__ {                                                                                             \
      RegTensor<T> vreg0;                                                                                       \
      RegTensor<T> vreg1;                                                                                       \
      RegTensor<T> vreg2;                                                                                       \
      vector_bool stPreg;                                                                                       \
      uint32_t sregLower = BlockNum(T);                                                                         \
      uint16_t repeat = CeilDiv(count, sregLower);                                                              \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();                           \
      for (uint16_t i = 0; i < repeat; ++i) {                                                                   \
        stPreg = UpdateMask<T>(count);                                                                          \
        vlds(vreg0, src0, i *sregLower, NORM);                                                                  \
        vlds(vreg1, src1, i *sregLower, NORM);                                                                  \
        builtin(vreg2, vreg0, vreg1, stPreg, MODE_ZEROING);                                                     \
        vsts(vreg2, dst, i *sregLower, distValue, stPreg);                                                      \
      }                                                                                                         \
    }                                                                                                           \
  }

#define DECLARE_BINARY_MASK(builtin)                                                                          \
  template <typename T>                                                                                       \
  __aicore_inline__ void builtin##_mask(__ubuf__ T *dst, __ubuf__ T *src0, __ubuf__ T *src1, uint16_t repeat, \
                                        uint32_t dst_offset, uint32_t src0_offset, uint32_t src1_offset) {    \
    __VEC_SCOPE__ {                                                                                           \
      RegTensor<T> vreg0;                                                                                     \
      RegTensor<T> vreg1;                                                                                     \
      RegTensor<T> vreg2;                                                                                     \
      vector_bool stPreg = MoveMask<T>();                                                                     \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();                         \
      for (uint16_t i = 0; i < repeat; ++i) {                                                                 \
        vlds(vreg0, src0, i * src0_offset, NORM);                                                             \
        vlds(vreg1, src1, i * src1_offset, NORM);                                                             \
        builtin(vreg2, vreg0, vreg1, stPreg, MODE_ZEROING);                                                   \
        vsts(vreg2, dst, i * dst_offset, distValue, stPreg);                                                  \
      }                                                                                                       \
    }                                                                                                         \
  }

#define DECLARE_CBINARY_MASK(builtin)                                                                            \
  template <typename T>                                                                                          \
  __aicore_inline__ void builtin##_mask(__ubuf__ T *dst, __ubuf__ T *src0, uint16_t repeat, uint32_t dst_offset, \
                                        uint32_t src0_offset) {                                                  \
    __VEC_SCOPE__ {                                                                                              \
      RegTensor<T> vreg0;                                                                                        \
      RegTensor<T> vreg1;                                                                                        \
      vector_align ureg;                                                                                         \
      vector_bool exPreg = MoveMask<T>();                                                                        \
      for (uint16_t i = 0; i < repeat; ++i) {                                                                    \
        vlds(vreg0, src0, i *src0_offset, NORM);                                                                 \
        builtin(vreg1, vreg0, exPreg, MODE_ZEROING);                                                             \
        vstus(ureg, dst_offset, vreg1, dst, POST_UPDATE);                                                        \
      }                                                                                                          \
      vstas(ureg, dst, 0, POST_UPDATE);                                                                          \
    }                                                                                                            \
  }

#define DECLARE_UNARY(builtin)                                                                \
  template <typename T>                                                                       \
  __aicore_inline__ void builtin##_count(__ubuf__ T *dst, __ubuf__ T *src0, uint32_t count) { \
    __VEC_SCOPE__ {                                                                           \
      RegTensor<T> vreg0;                                                                     \
      RegTensor<T> vreg1;                                                                     \
      vector_bool stPreg;                                                                     \
      uint32_t sregLower = BlockNum(T);                                                       \
      uint16_t repeat = CeilDiv(count, sregLower);                                            \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();         \
      for (uint16_t i = 0; i < repeat; ++i) {                                                 \
        stPreg = UpdateMask<T>(count);                                                        \
        vlds(vreg0, src0, i *sregLower, NORM);                                                \
        builtin(vreg1, vreg0, stPreg, MODE_ZEROING);                                          \
        vsts(vreg1, dst, i *sregLower, distValue, stPreg);                                    \
      }                                                                                       \
    }                                                                                         \
  }

#define DECLARE_BINARYS(builtin)                                                                        \
  template <typename T>                                                                                 \
  __aicore_inline__ void builtin##_count(__ubuf__ T *dst, __ubuf__ T *src0, T scalar, uint32_t count) { \
    __VEC_SCOPE__ {                                                                                     \
      RegTensor<T> vreg0;                                                                               \
      RegTensor<T> vreg1;                                                                               \
      vector_bool stPreg;                                                                               \
      uint32_t sregLower = BlockNum(T);                                                                 \
      uint16_t repeat = CeilDiv(count, sregLower);                                                      \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();                   \
      for (uint16_t i = 0; i < repeat; ++i) {                                                           \
        stPreg = UpdateMask<T>(count);                                                                  \
        vlds(vreg0, src0, i *sregLower, NORM);                                                          \
        builtin(vreg1, vreg0, scalar, stPreg, MODE_ZEROING);                                            \
        vsts(vreg1, dst, i *sregLower, distValue, stPreg);                                              \
      }                                                                                                 \
    }                                                                                                   \
  }

#define DECLARE_BINARYS_EXT(builtin)                                                                    \
  template <typename T, bool IsRhs>                                                                     \
  __aicore_inline__ void builtin##_count(__ubuf__ T *dst, __ubuf__ T *src0, T scalar, uint32_t count) { \
    __VEC_SCOPE__ {                                                                                     \
      RegTensor<T> vreg0;                                                                               \
      RegTensor<T> vreg1;                                                                               \
      RegTensor<T> vscalar;                                                                             \
      vector_bool stPreg;                                                                               \
      uint32_t sregLower = BlockNum(T);                                                                 \
      uint16_t repeat = CeilDiv(count, sregLower);                                                      \
      vbr(vscalar, scalar);                                                                             \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();                   \
      for (uint16_t i = 0; i < repeat; ++i) {                                                           \
        stPreg = UpdateMask<T>(count);                                                                  \
        vlds(vreg0, src0, i * sregLower, NORM);                                                         \
        if constexpr (IsRhs) {                                                                          \
          builtin(vreg1, vreg0, vscalar, stPreg, MODE_ZEROING);                                         \
        } else {                                                                                        \
          builtin(vreg1, vscalar, vreg0, stPreg, MODE_ZEROING);                                         \
        }                                                                                               \
        vsts(vreg1, dst, i * sregLower, distValue, stPreg);                                             \
      }                                                                                                 \
    }                                                                                                   \
  }

