#define _CCE_KERNEL_
#include "isa.h"

const uint64_t UB_WORKSPACE_SIZE = 1024;
#define PC_BASE UB_WORKSPACE_SIZE

#define WORKSPACE (uint64_t)0
#define MASK_32 0xfffffffful

#define IS_FLOAT(x) (sizeof(*x) == 4)
#define SIMD_WIDTH_SHIFT(x) (IS_FLOAT(x) ? 3 : 4)
#define TYPE_SHIFT(x) (32 / sizeof(x))
#define BlockDataShift(x)  (5 - sizeof(x) / 2)   // 1B - 5, 2B - 4, 4B - 3, 8B - not support

// tile : simd_width(8) << 56 | tile_end(20) << 24 | tile_idx(20) << 4 | tail_flag(1) << 2 | end_flag(1) << 1 | not_begin_flag(1)
#define V_TILE_N_BEGIN_FLAG_OFFSET  0
#define V_TILE_END_FLAG_OFFSET      1
#define V_TILE_TAIL_FLAG_OFFSET     2
#define V_TILE_CUR_IDX_OFFSET       4
#define V_TILE_END_IDX_OFFSET       24
#define V_TILE_SIMD_WIDTH_OFFSET    56

#define TileIdx(tile)         vGetBitRange(tile, V_TILE_CUR_IDX_OFFSET, 20)
#define TileEnd(tile)         vGetBitRange(tile, V_TILE_END_IDX_OFFSET, 20)
#define IsLastTile(tile)      (((tile) & 6ul) == 6ul)
#define IsBeginTile(tile)     ((tile & (1ul << V_TILE_N_BEGIN_FLAG_OFFSET)) == 0)
#define IsEndTile(tile)       ((tile) &(1ul << V_TILE_END_FLAG_OFFSET))
#define TileSimdWidth(tile)   (tile >> V_TILE_SIMD_WIDTH_OFFSET)
#define GetRepeatStride(tile, x)  (tile >> (V_TILE_SIMD_WIDTH_OFFSET + BlockDataShift(x)))

__aicore_inline__ uint64_t GetBlock(uint64_t stride, uint64_t type_size) {
  return (stride * type_size + 31) >> 5;
}

__aicore_inline__ void SetVectorMask(uint64_t simd_width) {
  if (simd_width > 64) {
    set_vector_mask(0xffffffffffffffffllu >> (128 - simd_width), 0xffffffffffffffffllu);
  } else {
    set_vector_mask(0, 0xffffffffffffffffllu >> (64 - simd_width));
  }
}

