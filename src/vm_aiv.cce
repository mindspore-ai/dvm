__aicore_inline__ void vSel(__ubuf__ float *dst, __ubuf__ float *src0, __ubuf__ float *src1, uint8_t repeat, uint8_t repeatStride, uint8_t selectMode = 0) {
  vsel(dst, src0, src1, repeat, 1, 1, 1, repeatStride, repeatStride, repeatStride, selectMode);
}

__aicore_inline__ void vSel(__ubuf__ half *dst, __ubuf__ half *src0, __ubuf__ half *src1, uint8_t repeat, uint8_t repeatStride, uint8_t selectMode = 0) {
