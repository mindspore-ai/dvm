#define _CCE_KERNEL_
#include "isa.h"

#define __aicore__ [aicore]

template <typename T>
__aicore_inline__ void Swap(T &x, T &y) {
  T t = x;
  x = y;
  y = t;
}

#define __force_inline__ inline __attribute__((always_inline))

constexpr uint32_t L0_PINGPONG_BUFFER_LEN = 16384;
constexpr uint32_t L1_PINGPONG_BUFFER_LEN = 131072;
constexpr uint32_t L0_PINGPONG_BUFFER_SIZE = 32768;   // 64KB / 2
constexpr uint32_t L1_PINGPONG_BUFFER_SIZE = 262144;  // 512KB / 2
constexpr int32_t BLOCK_SIZE = 16;

// TODO: only support fp16 now
template <typename T>
class MatMul {
 public:
  __aicore__ MatMul(__gm__ vCubeOp *op) {
    m = op->m;
    n = op->n;
    k = op->k;
    m0 = op->m0;
    n0 = op->n0;
    k0 = op->k0;
    trans_a = op->transpose >> 16;
    trans_b = op->transpose & 0xffff;
    int64_t mn_max = m0 > n0 ? m0 : n0;
    k0_part_len = L0_PINGPONG_BUFFER_LEN / mn_max / 16 * 16;
    n0_col = (n + n0 - 1) / n0;
  }

  __force_inline__ __aicore__ void LoadA(__cbuf__ T *dst, __gm__ T *src, int64_t midx, int64_t kidx) {
    // load GM to L1: ND -> zN
    if (trans_a) {
      copy_gm_to_cbuf_multi_nd2nz_b16(
        dst,
        src + kidx * k0 * m + midx * m0,
        0,                                 // sid
        1,                                 // ndNum
        k0,                                // nValue
        m0,                                // dValue
        0,                                 // srcNdMatrixStride, unused if nd_num=1
        m,                                 // srcDValue
        k0,                                // dstNzC0Stride
        1,                                 // dstNzNStride
        0                                  // dstNzMatrixStride, unused if nd_num=1
      );
    } else {
      copy_gm_to_cbuf_multi_nd2nz_b16(
        dst,
        src + midx * m0 * k + kidx * k0,
        0,                                 // sid
        1,                                 // ndNum
        m0,                                // nValue
        k0,                                // dValue
        0,                                 // srcNdMatrixStride, unused if nd_num=1
        k,                                 // srcDValue
        m0,                                // dstNzC0Stride
        1,                                 // dstNzNStride
        0                                  // dstNzMatrixStride, unused if nd_num=1
      );
    }
  }

  __force_inline__ __aicore__ void LoadB(__cbuf__ T *dst, __gm__ T *src, int64_t kidx, int64_t nidx) {
    // load GM to L1: ND -> zN
    if (trans_b) {
      copy_gm_to_cbuf_multi_nd2nz_b16(
        dst,
        src + nidx * n0 * k + kidx * k0,
        0,                                 // sid
        1,                                 // ndNum
        n0,                                // nValue
        k0,                                // dValue
        0,                                 // srcNdMatrixStride, unused if nd_num=1
        n,                                 // srcDValue
        n0,                                // dstNzC0Stride
        1,                                 // dstNzNStride
        0                                  // dstNzMatrixStride, unused if nd_num=1
      );
    } else {
      copy_gm_to_cbuf_multi_nd2nz_b16(
        dst,
        src + kidx * k0 * n + nidx * n0,
        0,                                 // sid
        1,                                 // ndNum
        k0,                                // nValue
        n0,                                // dValue
        0,                                 // srcNdMatrixStride, unused if nd_num=1
        k,                                 // srcDValue
        k0,                                // dstNzC0Stride
        1,                                 // dstNzNStride
        0                                  // dstNzMatrixStride, unused if nd_num=1
      );
    }
  }

  __force_inline__ __aicore__ void LoadL0A(__ca__ T *dst, __cbuf__ T *src, int64_t total_k, int64_t k_part) {
    // load L1 to L0A: zN -> zZ
    if (trans_a) {
      for (size_t i = 0; i < m0 / BLOCK_SIZE; i++) {
        load_cbuf_to_ca(
          dst + i * BLOCK_SIZE * k0 / total_k,
          src + i * k0 * BLOCK_SIZE + k0 / total_k * k_part * BLOCK_SIZE,
          0,
          k0 / total_k / BLOCK_SIZE,       // repeat: number of fractal
          1,                               // srcstride: number of fractal
          0,                               // dststride: number of fractal
          0,
          true,                            // transpose
          inc);
      }
    } else {
      for (size_t i = 0; i < m0 / BLOCK_SIZE; i++) {
        load_cbuf_to_ca(
          dst + i * BLOCK_SIZE * k0 / total_k,
          src + m0 * k0 / total_k * k_part + i * BLOCK_SIZE * BLOCK_SIZE,
          0,
          k0 / total_k / BLOCK_SIZE,       // repeat: number of fractal
          m0 / BLOCK_SIZE,                 // srcstride: number of fractal
          0,                               // dststride: number of fractal
          0,
          false,                           // transpose
          inc);
      }
    }
  }

  __force_inline__ __aicore__ void LoadL0B(__cb__ T *dst, __cbuf__ T *src, int64_t total_k, int64_t k_part) {
    // load L1 to L0A: zN -> nZ
    if (trans_b) {
      load_cbuf_to_cb(
        dst,
        src + k_part * k0 / total_k * n0,
        0,
        k0 * n0 / BLOCK_SIZE / BLOCK_SIZE, // repeat: number of fractal
        1,                                 // srcStride: number of fractal
        0,                                 // dstStride: number of fractal
        0,
        false,                             // transpose
        inc);
    } else {
      for (size_t i = 0; i < k0 / total_k / BLOCK_SIZE; i++) {
        load_cbuf_to_cb(
          dst + i * BLOCK_SIZE * n0,
          src + (k0 / total_k * k_part + i * BLOCK_SIZE) * BLOCK_SIZE,
          0,
          n0 / BLOCK_SIZE,                 // repeat: number of fractal
          k0 / BLOCK_SIZE,                 // srcStride: number of fractal
          0,                               // dstStride: number of fractal
          0,
          true,                            // transpose
          inc);
      }
    }
  }

  __force_inline__ __aicore__ void Mad(__cc__ float *c, __ca__ T *a, __cb__ T *b, bool init_c) {
    mad(
      c,
      a,
      b,
      m0,               // m
      k0_part_len,      // k
      n0,               // n
      0,                // unitFlag
      0,                // kDirectionAlign
      0,                // cmatrixSource
      init_c            // cmatrixInitVal
    );
  }

  __force_inline__ __aicore__ void StoreC(__gm__ T *dst, __cc__ float *c, int64_t midx, int64_t nidx) {
    copy_matrix_cc_to_gm(
      dst + midx * m0 * n + nidx * n0,        // dst
      c,                                      // src
      0,                                      // sid
      n0,                                     // NSize
      m0,                                     // MSize
      n,                                      // dstStride_dst_D
      m0,                                     // srcStride
      0,                                      // UnitFlagMode
      F322F16,                                // QuantPRE
      0,                                      // ReLUPRE
      false,                                  // channelSplit
      true                                    // NZ2ND_EN
    );
  }

  __force_inline__ __aicore__ void TileMap(uint32_t tile, int64_t &midx, int64_t &nidx) {
    // TODO: swizzle
    midx = tile / n0_col;
    nidx = tile % n0_col;
  }
  uint64_t n0_col;
  uint64_t k0_part_len;
  uint64_t m, n, k;
  uint64_t m0, n0, k0;
  bool trans_a;
  bool trans_b;
};

template <typename M, typename T>
__aicore_inline__ void CutMKN(__gm__ vCubeOp *op, uint64_t tile_begin, uint64_t tile_end) {
  set_padding((uint64_t)0);
  set_atomic_none();
  uint64_t config = 0x1;
  set_nd_para(config);
  M mat(op);
  uint64_t batch_offset = 0;
  __gm__ T *gm_a = reinterpret_cast<__gm__ T*>(op->gm_a + batch_offset);
  __gm__ T *gm_b = reinterpret_cast<__gm__ T*>(op->gm_b + batch_offset);
  __gm__ T *gm_c = reinterpret_cast<__gm__ T*>(op->gm_c + batch_offset);
  int64_t offset = (op->m0 * op->k0 * sizeof(T) + 256 - 1) / 256 * 256;  // TODO: int8 is 512
  __cbuf__ T *l1a = reinterpret_cast<__cbuf__ T*>(0);
  __cbuf__ T *l1b = reinterpret_cast<__cbuf__ T*>(offset);
  __cbuf__ T *n_l1a = reinterpret_cast<__cbuf__ T*>(L1_PINGPONG_BUFFER_SIZE);
  __cbuf__ T *n_l1b = n_l1a + offset / sizeof(T);
  __ca__ T *l0a_base = reinterpret_cast<__ca__ T*>(0);
  __cb__ T *l0b_base = reinterpret_cast<__cb__ T*>(0);
  __ca__ T *l0a_next = reinterpret_cast<__ca__ T*>(L0_PINGPONG_BUFFER_SIZE);
  __cb__ T *l0b_next = reinterpret_cast<__cb__ T*>(L0_PINGPONG_BUFFER_SIZE);
  int64_t k_loop = (op->k + op->k0 - 1) / op->k0;
  int64_t k_part_loop = (op->k0 + mat.k0_part_len - 1) / mat.k0_part_len;
  int64_t pingpong = 1;
  //if (op->forward_fusion) { wait_flag_dev(flag_id); }
  set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
  set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID1);
  set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID2);
  set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID3);
  set_flag(PIPE_FIX, PIPE_M, EVENT_ID0);
  for (uint64_t tile = tile_begin; tile <= tile_end; ++tile) {
    __cc__ float *l0c = reinterpret_cast<__cc__ float *>((uintptr_t)0);
    int64_t midx, nidx;
    mat.TileMap(tile, midx, nidx);
    if (tile == tile_begin) {
      auto event_id = pingpong ? EVENT_ID0 : EVENT_ID1;
      wait_flag(PIPE_MTE1, PIPE_MTE2, event_id);
      mat.LoadA(l1a, gm_a, midx, 0);
      set_flag(PIPE_MTE2, PIPE_MTE1, event_id);
      wait_flag(PIPE_MTE1, PIPE_MTE2, event_id + 2);
      mat.LoadB(l1b, gm_b, 0, nidx);
      set_flag(PIPE_MTE2, PIPE_MTE1, event_id + 2);
    }
    for (uint64_t k = 0; k < k_loop; ++k) {
      auto event_id = pingpong ? EVENT_ID0 : EVENT_ID1;
      auto event_id_next = pingpong ? EVENT_ID1 : EVENT_ID0;
      if (k < k_loop - 1) {
        wait_flag(PIPE_MTE1, PIPE_MTE2, event_id_next);
        mat.LoadA(n_l1a, gm_a, midx, k + 1);
        set_flag(PIPE_MTE2, PIPE_MTE1, event_id_next);
        wait_flag(PIPE_MTE1, PIPE_MTE2, event_id_next + 2);
        mat.LoadB(n_l1b, gm_b, k + 1, nidx);
        set_flag(PIPE_MTE2, PIPE_MTE1, event_id_next + 2);
      } else if (tile < tile_end) {
        int64_t n_midx, n_nidx;
        mat.TileMap(tile + 1, n_midx, n_nidx);
        wait_flag(PIPE_MTE1, PIPE_MTE2, event_id_next);
        mat.LoadA(n_l1a, gm_a, n_midx, 0);
        set_flag(PIPE_MTE2, PIPE_MTE1, event_id_next);
        wait_flag(PIPE_MTE1, PIPE_MTE2, event_id_next + 2);
        mat.LoadB(n_l1b, gm_b, 0, n_nidx);
        set_flag(PIPE_MTE2, PIPE_MTE1, event_id_next + 2);
      }
      set_flag(PIPE_M, PIPE_MTE1, EVENT_ID0);
      set_flag(PIPE_M, PIPE_MTE1, EVENT_ID1);
      for (int64_t k_part = 0; k_part < k_part_loop; ++k_part) { // TODO: double buffer
        __ca__ T *l0a = (k_part & 1) ? l0a_next : l0a_base;
        __cb__ T *l0b = (k_part & 1) ? l0b_next : l0b_base;
        auto mte1_mad_event_id = (k_part & 1) ? EVENT_ID1 : EVENT_ID0;
        if (k_part == 0) {
          wait_flag(PIPE_MTE2, PIPE_MTE1, event_id);
        }
        wait_flag(PIPE_M, PIPE_MTE1, mte1_mad_event_id);
        mat.LoadL0A(l0a, l1a, k_part_loop, k_part);
        if (k_part == k_part_loop - 1) {
          set_flag(PIPE_MTE1, PIPE_MTE2, event_id);
        }
        if (k_part == 0) {
          wait_flag(PIPE_MTE2, PIPE_MTE1, event_id + 2);
        }
        mat.LoadL0B(l0b, l1b, k_part_loop, k_part);
        if (k_part == k_part_loop - 1) {
          set_flag(PIPE_MTE1, PIPE_MTE2, event_id + 2);
        }
        set_flag(PIPE_MTE1, PIPE_M, mte1_mad_event_id);
        wait_flag(PIPE_MTE1, PIPE_M, mte1_mad_event_id);
        bool init_c = (k == 0 && k_part == 0);
        if (init_c) {
          wait_flag(PIPE_FIX, PIPE_M, EVENT_ID0);
        }
        mat.Mad(l0c, l0a, l0b, init_c);
        pipe_barrier(PIPE_M);
        set_flag(PIPE_M, PIPE_MTE1, mte1_mad_event_id);
      }
      wait_flag(PIPE_M, PIPE_MTE1, EVENT_ID0);
      wait_flag(PIPE_M, PIPE_MTE1, EVENT_ID1);
      pingpong = (pingpong + 1) & 1ul;
      Swap(l1a, n_l1a);
      Swap(l1b, n_l1b);
    }
    set_flag(PIPE_M, PIPE_FIX, EVENT_ID0);
    wait_flag(PIPE_M, PIPE_FIX, EVENT_ID0);
    mat.StoreC(gm_c, l0c, midx, nidx);
    set_flag(PIPE_FIX, PIPE_M, EVENT_ID0);
    //if (op->post_fusion) { ffts_cross_core_sync(MTE3, inner_group);}
  }
  wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
  wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID1);
  wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID2);
  wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID3);
  wait_flag(PIPE_FIX, PIPE_M, EVENT_ID0);
}

extern "C"  __global__ [aicore] void vmain_mix_aic(uint64_t config) {
  __gm__ uint8_t * base_addr = (__gm__ uint8_t*)(get_para_base());
  uint64_t last_tile = config >> 40;
  uint64_t tile_per_block = (last_tile + block_num) / block_num;
  uint64_t tile_start = tile_per_block * block_idx;
  uint64_t tile_end = tile_start + tile_per_block - 1;
  if (tile_end >= last_tile) {
    tile_end = last_tile;
  }
  if (tile_start >= last_tile) {
    tile_start = tile_end + 1;
  }
  __gm__ vCubeOp *op = reinterpret_cast<__gm__ vCubeOp*>(base_addr + sizeof(uint64_t));
  CutMKN<MatMul<half>, half>(op, tile_start, tile_end);
  pipe_barrier(PIPE_ALL);
}
