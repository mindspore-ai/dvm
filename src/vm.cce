// cross
__aicore_inline__ void vCAdd(__ubuf__ float *dst, __ubuf__ float *src, uint8_t repeat, uint16_t dstRepeatStride, uint16_t srcRepeatStride) {
#ifdef AICORE_ARCH_C220
  vcadd(dst, src, repeat, dstRepeatStride, 1, srcRepeatStride, 0);
#else
  vcadd(dst, src, repeat, dstRepeatStride, 1, srcRepeatStride);
#endif
}

__aicore_inline__ void vCAdd(__ubuf__ half *dst, __ubuf__ half *src, uint8_t repeat, uint16_t dstRepeatStride, uint16_t srcRepeatStride) {
#ifdef AICORE_ARCH_C220
  vcadd(dst, src, repeat, dstRepeatStride, 1, srcRepeatStride, 0);
#else
  vcadd(dst, src, repeat, dstRepeatStride, 1, srcRepeatStride);
#endif
}

__aicore_inline__ void vCMax(__ubuf__ float *dst, __ubuf__ float *src, uint8_t repeat, uint16_t dstRepeatStride, uint16_t srcRepeatStride) {
#ifdef AICORE_ARCH_C220
  vcmax(dst, src, repeat, dstRepeatStride, 1, srcRepeatStride, ONLY_VALUE);
#else
  vcadd(dst, src, repeat, dstRepeatStride, 1, srcRepeatStride);
  vector_dup((__ubuf__ float *)WORKSPACE, (float)1, 1, 1, 1, 0, 0);
  pipe_barrier(PIPE_V);
  vmin(dst, dst, (__ubuf__ float *)WORKSPACE, repeat, 1, 1, 1, srcRepeatStride, srcRepeatStride, 0);
#endif
}

__aicore_inline__ void vCMax(__ubuf__ half *dst, __ubuf__ half *src, uint8_t repeat, uint16_t dstRepeatStride, uint16_t srcRepeatStride) {
#ifdef AICORE_ARCH_C220
  vcmax(dst, src, repeat, dstRepeatStride, 1, srcRepeatStride, ONLY_VALUE);
#else
  vcmax(dst, src, repeat, dstRepeatStride, 1, srcRepeatStride);
#endif
}

