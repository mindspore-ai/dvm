#define DECLARE_CAST(T, U, ...)                                                          \
  template <ROUND R>                                                                     \
  __aicore_inline__ void CastImpl(RegTensor<T> &dst, RegTensor<U> &src, MaskReg &mask) { \
    vcvt(dst, src, mask, __VA_ARGS__);                                                   \
  }

template <ROUND R>
__aicore_inline__ void CastImpl(RegTensor<half> &dst, RegTensor<int32_t> &src, MaskReg &mask) {
  vector_f32 vregTmpF32;
  vcvt(vregTmpF32, src, mask, RoundValue<R>());
  vcvt(dst, vregTmpF32, mask, RoundValue<R>(), RS_ENABLE, PART_EVEN);
}

template <ROUND R>
__aicore_inline__ void CastImpl(RegTensor<float> &dst, RegTensor<float> &src, MaskReg &mask) {
  vtrc(dst, src, RoundValue<R>(), mask);
}

